---

STF_DOCKER_NETWORK: infra

# The connection to MCloud: `./zebrunner.sh join` writes these settings (README.md#node-enrollment), do not change them
# by hand; a new join string of `./zebrunner.sh node-invite` of mcloud replaces them. Keep this file private (mode 600).
# MCLOUD_URL and MCLOUD_TLS_PIN: the API of MCloud and the pin of its TLS key (doctor talks to MCloud with them)
MCLOUD_URL:
MCLOUD_TLS_PIN:
# the token of this host: the grid, the storage and the proof of its devices
MCLOUD_NODE_TOKEN:
# the address of this host the MCloud server connects to (the hub, the screens): the address of the invite
STF_PROVIDER_HOST:
# the public URL of MCloud: the devices upload the screenshots and download the apps there
PUBLIC_IP:
PUBLIC_IP_PORT:
PUBLIC_IP_PROTOCOL:
# the triproxies of STF and mcloud-grid on the address this host reaches MCloud with
STF_PROVIDER_CONNECT_SUB:
STF_PROVIDER_CONNECT_PUSH:
STF_PROVIDER_CONNECT_APP_DEALER:
STF_PROVIDER_CONNECT_DEV_DEALER:
SELENIUM_HUB_HOST:
SELENIUM_HUB_PORT:
# the ZeroMQ security (CURVE): the public key of the server and the key of this host (join makes it when it is empty)
STF_ZMQ_CURVE_SERVER_PUBLIC_KEY:
STF_ZMQ_CURVE_SECRET_KEY:

# [OPTIONAL] The host STF shows to the users in `adb connect <host>:<port>` (the remote debug), STF_PROVIDER_HOST by
# default. For a host in a private network: the public name of MCloud with the adb relay of mcloud (ADB_RELAY=true), it
# forwards the remote debug port (connect_port) of every Android device of this host (README.md#device-hosts-in-a-private-network).
REMOTE_CONNECT_HOST:

# [OBLIGATORY] Set host address of current STF provider server and 2222 port as default. We start socat listener and share usbmuxd into the containers
USBMUXD_SOCKET_ADDRESS: host.docker.internal:2222

# [OPTIONAL] The adb server of the host for the USB Android devices (ZebrunnerAdb launch agent)
ADB_SERVER_SOCKET_ADDRESS: host.docker.internal:5037

# [OPTIONAL] provider/location name for devices. Use short city name like NYC
STF_PROVIDER_NAME: mcloud-macos

# [OPTIONAL] STF integration settings to move devices into Unhealthy state
STF_API_URL:
STF_AUTH_TOKEN:

# [OPTIONAL] S3 compatible storage for video recordings.
S3_BUCKET:
S3_TENANT:
S3_ENDPOINT:
S3_ACCESS_KEY_ID:
S3_SECRET:
S3_REGION:

# For local s3 compatible minio storage recommended settings are:
# S3_BUCKET: zebrunner
# S3_TENANT:
# S3_ENDPOINT: http://minio:9000
# S3_ACCESS_KEY_ID: zebrunner
# S3_SECRET: J33dNyeTDj
# S3_REGION: us-east-1

# Path to prebuild WebDriverAgent.ipa
WDA_FILE:
# Path to the simulator build of WebDriverAgent for the simulators: a .app folder or its .zip, e.g.
# WebDriverAgentRunner-Build-Sim-arm64.zip of https://github.com/appium/WebDriverAgent/releases
WDA_SIMULATOR_FILE:
# Override to use custom WDA bundle id: https://github.com/zebrunner/mcloud-agent#build-webdriveragentipa
WDA_BUNDLEID:

# [OBLIGATORY] Declare valid devices metadata
# - id: device udid: the Identifier of Xcode, Window -> Devices and Simulators (`adb devices` for Android, `xcrun simctl list devices` for an iOS simulator)
#   name: device name as it will be registered in STF (avoid special symbols and spaces!)
#   location: clarified device location for ease of device management (an underscore will be added automatically before the value)
#   appium_port: unique port value for sharing appium services from the container to outside selenium hub
#   adb_port: USB Android: the port of the host forwarded to the device, unique on the host (see connection)
#   connect_port: [optional] Android: the remote debug port of STF (adb connect), the second port of min_port-max_port
#     by default; out of the range it is published too. Unique on the host, and among the hosts for the adb relay of
#     mcloud (README.md#device-hosts-in-a-private-network). Not a port of MCloud on the same machine.
#   min_port and max_port: unique range of 7 ports per device for system STF purposes.
#     The MCloud server reaches them on STF_PROVIDER_HOST (the screens through stf-proxy); adb connect of the remote
#     debug reaches them directly or through the adb relay of mcloud (REMOTE_CONNECT_HOST, ADB_RELAY=true).
#   connection: [optional] how the connector container reaches the device, usb by default. Docker of macOS has no USB:
#     the connectors take the devices from the host, but every device command comes from the containers.
#     usb       - plugged into the Mac: iOS over usbmuxd of the host (the connector installs and starts WebDriverAgent),
#                 Android over the adb server of the host (a launch agent, brew install android-platform-tools):
#                 adb_port is the port of the host forwarded to the device, unique on the host
#     wireless  - over the network: iOS / Apple TV paired with the Mac (usbmuxd of the host knows it), Android over
#                 adb connect to address (the id by default, port 5555 unless given)
#     android-sim - Android: an emulator started outside the farm, address is its adb address: an AVD of the Mac
#                 is host.docker.internal:5555 (5557, ... for the next ones), a container Android or Genymotion of the network
#     ios-sim   - an iOS / tvOS simulator of the Mac, id is its UDID (xcrun simctl list devices): the connector
#                 boots it and starts WebDriverAgent over ssh (Remote Login must be on), wda_port (and mjpeg_port,
#                 wda_port + 1 by default) are its unique ports on the host, wda_file the simulator build of WDA
#                 (a .app folder or its .zip, WDA_SIMULATOR_FILE by default)
#     proxy     - iOS: WebDriverAgent started by another tool and published on address (wda_port, mjpeg_port: 8100, 8101)
#   address, wda_port and mjpeg_port: [optional] see connection
#   wda_file and wda_bundleid: [optional] device specific overrides of WDA_FILE and WDA_BUNDLEID

devices:
  - id: d6afc6b3a65584ca0813eb8957c6479b9b6ebb11
    os: ios
    name: iPhone_8_Plus
    location: location_1
    appium_port: 7431
    adb_port: 7432
    min_port: 7435
    max_port: 7440
