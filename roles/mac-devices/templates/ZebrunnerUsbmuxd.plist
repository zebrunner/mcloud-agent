<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>

    <key>EnvironmentVariables</key>
      <dict>
        <key>PATH</key>
        <string>/bin:/usr/bin:/usr/local/bin:/usr/sbin:/sbin</string>
      </dict>

    <key>Label</key>
      <string>com.zebrunner.usbmuxd</string>

    <!-- usbmuxd of the host for the containers: they reach this port of USBMUXD_SOCKET_ADDRESS through
         host.docker.internal -->
    <key>ProgramArguments</key>
      <array>
        <string>/usr/local/bin/socat</string>
        <string>TCP-LISTEN:{{ USBMUXD_SOCKET_ADDRESS | regex_replace('^.*:', '') }},reuseaddr,fork,bind=127.0.0.1</string>
        <string>UNIX-CONNECT:/var/run/usbmuxd</string>
      </array>

    <key>WorkingDirectory</key>
      <string>{{ agent_dir }}</string>

    <key>UserName</key>
      <string>{{ lookup('env', 'USER') }}</string>

    <key>KeepAlive</key>
      <true/>

    <key>RunAtLoad</key>
      <true/>

    <key>StandardErrorPath</key>
      <string>{{ agent_dir }}/logs/usbmuxd-socat.err.log</string>

    <key>StandardOutPath</key>
      <string>{{ agent_dir }}/logs/usbmuxd-socat.log</string>

  </dict>
</plist>
