#!/bin/bash

# Export docker env variables to avoid issues on macOS
export DOCKER_BUILDKIT=0
export COMPOSE_DOCKER_CLI_BUILD=0
export DOCKER_DEFAULT_PLATFORM=linux/amd64

# Rendered at deploy time: launchd runs this script without the user's env variables
export ZEBRUNNER_MCLOUD_AGENT_DIR="{{ lookup('env', 'ZEBRUNNER_MCLOUD_AGENT_DIR') }}"

source "${ZEBRUNNER_MCLOUD_AGENT_DIR}/patch/utility.sh"

MCLOUD_DEVICES="/usr/local/bin/mcloud-devices.txt"

get_device_fields() {
  local filter="$1"

  local -a fields
  dev_udid=""
  dev_platform_name=""
  dev_device_name=""
  dev_location=""
  dev_appium_port=""
  dev_adb_port=""
  dev_proxy_port=""
  dev_server_proxy_port=""
  dev_stf_min_port=""
  dev_stf_max_port=""
  dev_connection=""
  dev_device_wda_ipa_path=""
  dev_device_wda_bundle_id=""
  dev_address=""
  dev_wda_port=""
  dev_mjpeg_port=""

  local line
  # exact match of udid (field 1) or name (field 3)
  line="$(awk -F"|" -v filter="$filter" 'filter != "" && ($1 == filter || $3 == filter) { print; exit }' "$MCLOUD_DEVICES")"
  if [[ -z "$line" ]]; then
    failed "device not found: ${filter}"
    return 1
  fi

  local IFS='|'
  read -r -a fields <<< "$line"
  unset IFS

  # fields values shifted by -1 as `fields` is zero-indexed array
  dev_udid="${fields[0]}"
  dev_platform_name="${fields[1]}"
  dev_device_name="${fields[2]}"
  dev_location="${fields[3]}"
  dev_appium_port="${fields[4]}"
  dev_adb_port="${fields[5]}"
  dev_proxy_port="${fields[6]}"
  dev_server_proxy_port="${fields[7]}"
  dev_stf_min_port="${fields[8]}"
  dev_stf_max_port="${fields[9]}"

  # Field 11 - 'connection': how the connector container reaches the device. Docker of macOS has no USB, so the
  # connector takes a USB device from the host: usbmuxd (iOS) or the adb server (Android) of the host.
  #   usb       - plugged into the host: iOS over usbmuxd of the host, Android over the adb server of the host
  #   wireless  - over the network: iOS paired with the Mac (usbmuxd of the host), Android over adb connect
  #   redroid   - the Redroid emulator container of the device (Android, the kernel of docker needs binder)
  #   simulator - an iOS / tvOS simulator of the host, the connector runs xcrun simctl of the host over ssh
  #   proxy     - WebDriverAgent published by another tool, the connector relays it (iOS)
  dev_connection="${fields[10]:-usb}"

  # Fields 12 / 13 - 'device_wda_ipa_path' and 'device_wda_bundle_id'.
  # Device specific WebDriverAgent path (the simulator build for a simulator) and bundle ID.
  dev_device_wda_ipa_path="${fields[11]}"
  if [[ "$dev_device_wda_ipa_path" == "/dev/null" || -z "$dev_device_wda_ipa_path" ]]; then
    dev_device_wda_ipa_path="{{ WDA_FILE }}"
    if [[ "$dev_connection" == "simulator" ]]; then
      dev_device_wda_ipa_path="{{ WDA_SIMULATOR_FILE | default('') }}"
    fi
  fi
  : "${dev_device_wda_ipa_path:='/dev/null'}"

  dev_device_wda_bundle_id="${fields[12]}"
  if [[ "$dev_device_wda_bundle_id" == "/dev/null" || -z "$dev_device_wda_bundle_id" ]]; then
    dev_device_wda_bundle_id="{{ WDA_BUNDLEID }}"
  fi
  : "${dev_device_wda_bundle_id:='com.facebook.WebDriverAgentRunner.xctrunner'}"

  # Fields 14 - 16 - 'address', 'wda_port' and 'mjpeg_port'.
  # address: the IP of a wireless Android device (its id by default) or the host of the proxied WebDriverAgent;
  # wda_port and mjpeg_port: the ports of WebDriverAgent on the host for a simulator (unique, a simulator shares the
  # network of the host) or on the address for the proxy
  dev_address="${fields[13]}"
  dev_wda_port="${fields[14]}"
  dev_mjpeg_port="${fields[15]}"

  # Common name prefix for all containers
  dev_container="device-${dev_device_name}-${dev_udid}"
}

create_containers() {
  local ps_out
  ps_out="$(docker ps -a)"
  if grep -q "${dev_container}-stf" <<< "$ps_out" &&
    grep -q "${dev_container}-appium" <<< "$ps_out" &&
    grep -q "${dev_container}-connector" <<< "$ps_out" &&
    grep -q "${dev_container}-uploader" <<< "$ps_out"; then
    warn "Do nothing as containers already exists!"
    return 0
  fi

  if [[ "$dev_connection" == "usb" ]]; then
    local connected_devices
    connected_devices="$(ioreg -p IOUSB -w0 -l 2> /dev/null)"
    if grep -q "${dev_udid//-/}" <<< "$connected_devices"; then
      echo -e "\nDevice with udid: '${dev_udid//-/}' was SUCCESSFULLY detected as connected."
    else
      echo -e "\nDevice with udid: '${dev_udid//-/}' was NOT detected as connected. The containers will not be created."
      return 1
    fi
  else
    echo -e "\nDevice with udid: '${dev_udid}' is connected as '${dev_connection}', skipping USB presence check."
  fi

  echo -e "\n\tCreating '${dev_container}' containers:\n"

  local S3_KEY_PATTERN=""
  local TENANT="{{ S3_TENANT }}"
  local BUCKET="{{ S3_BUCKET }}"
  if [[ -n "$BUCKET" ]]; then
    S3_KEY_PATTERN="s3://${BUCKET}${TENANT:+/${TENANT}}/artifacts/test-sessions"
  fi

  # The connector is the only point of contact with the device: the STF and Appium containers --link to it and take
  # adb (Android), usbmuxd, WebDriverAgent and the shared tunnel (iOS) from it whatever the connection is.
  # NOTE on the expansion form used below: macOS ships bash 3.2, where "${arr[@]}" on an EMPTY array is an
  # unbound-variable error under `set -u`. "${arr[@]+"${arr[@]}"}" is the portable form and preserves element quoting.
  local connector_args=()
  local device_args=()
  local appium_args=()
  local STF_DEVICE_UDID="$dev_udid"

  if [[ "$dev_platform_name" == "android" ]]; then
    case "$dev_connection" in
    usb)
      # the device stays on the adb server of the host, the connector forwards it to its own adb server
      local adb_host="{{ ADB_SERVER_SOCKET_ADDRESS | default('host.docker.internal:5037') }}"
      adb_host="${adb_host%:*}"
      connector_args=(-e ADB_TRANSPORT_SERVER="{{ ADB_SERVER_SOCKET_ADDRESS | default('host.docker.internal:5037') }}"
        -e ADB_TRANSPORT_SERIAL="$dev_udid" -e ADB_TRANSPORT_PORT="$dev_adb_port")
      STF_DEVICE_UDID="${adb_host}:${dev_adb_port}"
      ;;
    wireless)
      local address="${dev_address:-$dev_udid}"
      [[ "$address" == *:* ]] || address="${address}:5555"
      connector_args=(-e ANDROID_DEVICE="$address")
      STF_DEVICE_UDID="$address"
      ;;
    redroid)
      # /proc/filesystems of a container is the one of the kernel: binderfs is there once binder is available
      if ! docker run --rm --entrypoint grep "{{ ANDROID_CONNECTOR_IMAGE }}:{{ ANDROID_CONNECTOR_VERSION }}" -qw binder /proc/filesystems; then
        failed "\nThe kernel of docker has no binder for Redroid (Docker Desktop): use a Linux VM with binder_linux (Colima, Lima) or a Linux host."
        return 1
      fi
      connector_args=(-e ANDROID_DEVICE="${dev_container}-redroid:5555")
      STF_DEVICE_UDID="${dev_container}-redroid:5555"
      grep -q "${dev_container}-redroid" <<< "$ps_out" || {
        echo -n "${dev_container}-redroid:    "
        docker run -d --name "${dev_container}-redroid" \
          --log-driver=local \
          --log-opt max-size=256m \
          --log-opt max-file=2 \
          --net="$net" \
          --privileged \
          --restart "on-failure:{{ RESTARTS_LIMIT }}" \
          -v "${dev_container}-redroid":/data \
          "{{ REDROID_IMAGE }}:{{ REDROID_VERSION }}" \
          androidboot.use_memfd=1 || failed "Error. Not created"
      }
      ;;
    *)
      failed "\nUnsupported connection of an Android device: ${dev_connection}. The containers will not be created."
      return 1
      ;;
    esac

    grep -q "${dev_container}-connector" <<< "$ps_out" || {
      echo -n "${dev_container}-connector:  "
      docker run -itd --name "${dev_container}-connector" \
        --log-driver=local \
        --log-opt max-size=256m \
        --log-opt max-file=2 \
        --net="$net" \
        --restart "on-failure:{{ RESTARTS_LIMIT }}" \
        -v mcloud-key-volume:/root/.android \
        -v "${dev_container}":/tmp/log \
        -e PLATFORM_NAME="$dev_platform_name" \
        -e DEVICE_UDID="$STF_DEVICE_UDID" \
        "${connector_args[@]+"${connector_args[@]}"}" \
        "{{ ANDROID_CONNECTOR_IMAGE }}:{{ ANDROID_CONNECTOR_VERSION }}" || failed "Error. Not created"
    }

    grep -q "${dev_container}-stf" <<< "$ps_out" || {
      echo -n "${dev_container}-stf:        "
      docker run -d --name "${dev_container}-stf" \
        --log-driver=local \
        --log-opt max-size=256m \
        --log-opt max-file=2 \
        --net="$net" \
        --link "${dev_container}-connector":connector \
        -e STF_PROVIDER_ADB_HOST=connector \
        -e STF_PROVIDER_ADB_PORT=5037 \
        --health-start-period 60s \
        --restart "on-failure:{{ RESTARTS_LIMIT }}" \
        -e PLATFORM_NAME="$dev_platform_name" \
        -e STF_PROVIDER_DEVICE_NAME="$dev_device_name" \
        -e DEVICE_UDID="$STF_DEVICE_UDID" \
        -e STF_PROVIDER_HOST="{{ STF_PROVIDER_HOST }}" \
        -e STF_PROVIDER_NAME="{{ STF_PROVIDER_NAME }}${dev_location:+_$dev_location}" \
        -e STF_PROVIDER_MIN_PORT="$dev_stf_min_port" \
        -e STF_PROVIDER_MAX_PORT="$dev_stf_max_port" \
        -p "${dev_stf_min_port}-${dev_stf_max_port}":"${dev_stf_min_port}-${dev_stf_max_port}" \
        -e STF_PROVIDER_PUBLIC_IP="{{ PUBLIC_IP }}" \
        -e PUBLIC_IP_PORT="{{ PUBLIC_IP_PORT }}" \
        -e PUBLIC_IP_PROTOCOL="{{ PUBLIC_IP_PROTOCOL }}" \
        -e STF_PROVIDER_CONNECT_SUB="{{ STF_PROVIDER_CONNECT_SUB }}" \
        -e STF_PROVIDER_CONNECT_PUSH="{{ STF_PROVIDER_CONNECT_PUSH }}" \
        -e RETHINKDB_PORT_28015_TCP="{{ STF_RETHINKDB }}" \
        -e STF_STORAGE_TOKEN="{{ STF_STORAGE_TOKEN }}" \
        "{{ DEVICE_IMAGE }}:{{ DEVICE_VERSION }}" || failed "Error. Not created"
    }

    grep -q "${dev_container}-appium" <<< "$ps_out" || {
      echo -n "${dev_container}-appium:     "
      docker run -itd --name "${dev_container}-appium" \
        -m 1g \
        --log-driver=local \
        --log-opt max-size=256m \
        --log-opt max-file=2 \
        --net="$net" \
        --restart "on-failure:{{ RESTARTS_LIMIT }}" \
        --link "${dev_container}-stf":device \
        --link "${dev_container}-connector":connector \
        -v appium-storage-volume:/opt/appium-storage \
        -v "${dev_container}":/tmp/log \
        -e TASK_LOG=/tmp/log/appium.log \
        -e PLATFORM_NAME="$dev_platform_name" \
        -e RETAIN_TASK=true \
        -e CONNECT_TO_GRID=true \
        -e RECORD_ARTIFACTS=true \
        -e CUSTOM_NODE_CONFIG=true \
        -e STF_PROVIDER_HOST="{{ STF_PROVIDER_HOST }}" \
        -e APPIUM_APP_SIZE_DISABLE="{{ APPIUM_APP_SIZE_DISABLE | string | lower }}" \
        -e APPIUM_APP_FETCH_RETRIES="{{ APPIUM_APP_FETCH_RETRIES }}" \
        -e APPIUM_MAX_LOCK_FILE_LIFETIME="{{ APPIUM_MAX_LOCK_FILE_LIFETIME }}" \
        -e APPIUM_APP_WAITING_TIMEOUT="{{ APPIUM_APP_WAITING_TIMEOUT }}" \
        -e SELENIUM_HOST="{{ SELENIUM_HUB_HOST }}" \
        -e SELENIUM_PORT="{{ SELENIUM_HUB_PORT }}" \
        -e DEFAULT_CAPABILITIES=true \
        -e DEVICE_NAME="$dev_device_name" \
        -e DEVICE_UDID="$STF_DEVICE_UDID" \
        -e ADB_PORT="$dev_adb_port" \
        -e PROXY_PORT="$dev_proxy_port" \
        -e SERVER_PROXY_PORT="$dev_server_proxy_port" \
        -e APPIUM_PORT="$dev_appium_port" \
        -p "$dev_appium_port":"$dev_appium_port" \
        -e RELAXED_SECURITY="{{ APPIUM_RELAXED_SECURITY | string | lower }}" \
        -e ADB_SERVER_SOCKET=tcp:connector:5037 \
        -e REMOTE_ADB_HOST=connector \
        -e STF_API_URL="{{ STF_API_URL }}" \
        -e STF_AUTH_TOKEN="{{ STF_AUTH_TOKEN }}" \
        "{{ APPIUM_IMAGE }}:{{ APPIUM_VERSION }}" || failed "Error. Not created"
    }

  elif [[ "$dev_platform_name" == "ios" ]]; then

    echo "WDA *.ipa file path: ${dev_device_wda_ipa_path}"
    echo -e "WDA bundle ID: ${dev_device_wda_bundle_id}\n"

    # WIRELESS=true: the device has no usbmuxd (a simulator or a proxied WebDriverAgent), the connector relays WDA
    local wireless="false"
    local wda_file_path="/tmp/zebrunner/WebDriverAgent.ipa"
    case "$dev_connection" in
    usb | wireless)
      # usbmuxd of the host knows the USB devices and the network ones paired with the Mac; the connector installs
      # and starts WebDriverAgent over it
      connector_args=(-e USBMUXD_SOCKET_ADDRESS="{{ USBMUXD_SOCKET_ADDRESS }}" -e DEVICE_CONNECTION="$dev_connection")
      ;;
    proxy)
      if [[ -z "$dev_address" ]]; then
        echo "ERROR! device ${dev_container} has connection proxy but no address (wda_host) of its WebDriverAgent"
        return 1
      fi
      connector_args=(-e DEVICE_CONNECTION=proxy -e DEVICE_ADDRESS="$dev_address"
        -e DEVICE_WDA_PORT="${dev_wda_port:-8100}" -e DEVICE_MJPEG_PORT="${dev_mjpeg_port:-8101}")
      wireless="true"
      ;;
    simulator)
      if [[ -z "$dev_wda_port" ]]; then
        echo "ERROR! simulator ${dev_container} needs wda_port: the unique port of its WebDriverAgent on the host"
        return 1
      fi
      # the simulator build of WDA: a .app folder or its .zip, mounted with its own name
      wda_file_path="/tmp/zebrunner/$(basename "$dev_device_wda_ipa_path")"
      local ssh_key="${ZEBRUNNER_MCLOUD_AGENT_DIR}/ssh/id_ed25519"
      connector_args=(-e DEVICE_CONNECTION=simulator -e HOST_SSH_USER="{{ lookup('env', 'USER') }}"
        -e DEVICE_WDA_PORT="$dev_wda_port" -e DEVICE_MJPEG_PORT="${dev_mjpeg_port:-$((dev_wda_port + 1))}"
        -v "${ssh_key}:/opt/zebrunner/ssh/id_ed25519:ro")
      # xcrun of the host for XCUITest, over ssh through the connector
      appium_args=(-e DEVICE_CONNECTION=simulator -e HOST_SSH_USER="{{ lookup('env', 'USER') }}"
        -v "${ssh_key}:/opt/zebrunner/ssh/id_ed25519:ro")
      wireless="true"
      ;;
    *)
      failed "\nUnsupported connection of an iOS device: ${dev_connection}. The containers will not be created."
      return 1
      ;;
    esac
    device_args=(-e WDA_HOST=connector -e WDA_PORT=8100 -e WIRELESS="$wireless")

    grep -q "${dev_container}-connector" <<< "$ps_out" || {
      echo -n "${dev_container}-connector:  "
      docker run -itd --name "${dev_container}-connector" \
        --log-driver=local \
        --log-opt max-size=256m \
        --log-opt max-file=2 \
        --net="$net" \
        --restart "on-failure:{{ RESTARTS_LIMIT }}" \
        -e HOST_OS=DARWIN \
        -e WDA_BUNDLEID="$dev_device_wda_bundle_id" \
        -e WDA_FILE="$wda_file_path" \
        -v devimages_cache:/opt/zebrunner/devimages \
        -v "${dev_device_wda_ipa_path}":"$wda_file_path" \
        -v "${dev_container}-lockdown":/var/lib/lockdown \
        -v "${dev_container}":/tmp/log \
        -e DEVICE_UDID="$dev_udid" \
        "${connector_args[@]+"${connector_args[@]}"}" \
        "{{ IOS_CONNECTOR_IMAGE }}:{{ IOS_CONNECTOR_VERSION }}" || failed "Error. Not created"
    }

    # Linking with appium required to share usbmuxd via socat
    grep -q "${dev_container}-stf" <<< "$ps_out" || {
      echo -n "${dev_container}-stf:            "
      docker run -d --name "${dev_container}-stf" \
        --log-driver=local \
        --log-opt max-size=256m \
        --log-opt max-file=2 \
        --net="$net" \
        --restart "on-failure:{{ RESTARTS_LIMIT }}" \
        --link "${dev_container}-connector:connector" \
        "${device_args[@]}" \
        -e GO_IOS_AGENT_HOST=connector \
        -e WDA_WAIT_TIMEOUT=60 \
        -e PLATFORM_NAME="$dev_platform_name" \
        -e STF_PROVIDER_DEVICE_NAME="$dev_device_name" \
        -e DEVICE_UDID="$dev_udid" \
        -e STF_PROVIDER_HOST="{{ STF_PROVIDER_HOST }}" \
        -e STF_PROVIDER_NAME="{{ STF_PROVIDER_NAME }}${dev_location:+_$dev_location}" \
        -e STF_PROVIDER_MIN_PORT="$dev_stf_min_port" \
        -e STF_PROVIDER_MAX_PORT="$dev_stf_max_port" \
        -p "$dev_stf_min_port"-"$dev_stf_max_port":"$dev_stf_min_port"-"$dev_stf_max_port" \
        -e STF_PROVIDER_PUBLIC_IP="{{ PUBLIC_IP }}" \
        -e PUBLIC_IP_PORT="{{ PUBLIC_IP_PORT }}" \
        -e PUBLIC_IP_PROTOCOL="{{ PUBLIC_IP_PROTOCOL }}" \
        -e STF_PROVIDER_CONNECT_SUB="{{ STF_PROVIDER_CONNECT_SUB }}" \
        -e STF_PROVIDER_CONNECT_PUSH="{{ STF_PROVIDER_CONNECT_PUSH }}" \
        -e STF_PROVIDER_CONNECT_APP_DEALER="{{ STF_PROVIDER_CONNECT_APP_DEALER }}" \
        -e STF_PROVIDER_CONNECT_DEV_DEALER="{{ STF_PROVIDER_CONNECT_DEV_DEALER }}" \
        -e RETHINKDB_PORT_28015_TCP="{{ STF_RETHINKDB }}" \
        -e STF_STORAGE_TOKEN="{{ STF_STORAGE_TOKEN }}" \
        "{{ DEVICE_IMAGE }}:{{ DEVICE_VERSION }}" || failed "Error. Not created"
    }

    # candidates for removal: ADB_PORT, STF_PROVIDER_MAX_PORT
    grep -q "${dev_container}-appium" <<< "$ps_out" || {
      echo -n "${dev_container}-appium:     "
      docker run -itd --name "${dev_container}-appium" \
        -m 1g \
        --log-driver=local \
        --log-opt max-size=256m \
        --log-opt max-file=2 \
        --net="$net" \
        --restart "on-failure:{{ RESTARTS_LIMIT }}" \
        --link "${dev_container}-stf":device \
        --link "${dev_container}-connector:connector" \
        "${device_args[@]}" \
        "${appium_args[@]+"${appium_args[@]}"}" \
        -v appium-storage-volume:/opt/appium-storage \
        -v "${dev_container}":/tmp/log \
        -e TASK_LOG=/tmp/log/appium.log \
        -e APPIUM_CLI="--session-override" \
        -e PLATFORM_NAME="$dev_platform_name" \
        -e RETAIN_TASK=true \
        -e CONNECT_TO_GRID=true \
        -e RECORD_ARTIFACTS=true \
        -e CUSTOM_NODE_CONFIG=true \
        -e STF_PROVIDER_HOST="{{ STF_PROVIDER_HOST }}" \
        -e APPIUM_APP_SIZE_DISABLE="{{ APPIUM_APP_SIZE_DISABLE | string | lower }}" \
        -e APPIUM_APP_FETCH_RETRIES="{{ APPIUM_APP_FETCH_RETRIES }}" \
        -e APPIUM_MAX_LOCK_FILE_LIFETIME="{{ APPIUM_MAX_LOCK_FILE_LIFETIME }}" \
        -e APPIUM_APP_WAITING_TIMEOUT="{{ APPIUM_APP_WAITING_TIMEOUT }}" \
        -e SELENIUM_HOST="{{ SELENIUM_HUB_HOST }}" \
        -e SELENIUM_PORT="{{ SELENIUM_HUB_PORT }}" \
        -e DEFAULT_CAPABILITIES=true \
        -e DEVICE_NAME="$dev_device_name" \
        -e DEVICE_UDID="$dev_udid" \
        -e ADB_PORT="$dev_adb_port" \
        -e PROXY_PORT="$dev_proxy_port" \
        -e SERVER_PROXY_PORT="$dev_server_proxy_port" \
        -e APPIUM_PORT="$dev_appium_port" \
        -p "$dev_appium_port":"$dev_appium_port" \
        -e RELAXED_SECURITY="{{ APPIUM_RELAXED_SECURITY | string | lower }}" \
        "{{ APPIUM_IMAGE }}:{{ APPIUM_VERSION }}" || failed "Error. Not created"
    }

  else
    echo "ERROR! Unsupported platform: ${dev_platform_name}"
    return 1
  fi

  grep -q "${dev_container}-uploader" <<< "$ps_out" || {
    echo -n "${dev_container}-uploader:   "
    docker run -d --name "${dev_container}-uploader" \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart "on-failure:{{ RESTARTS_LIMIT }}" \
      -v "${dev_container}":/tmp/log \
      -e ENDPOINT_URL="{{ S3_ENDPOINT }}" \
      -e S3_KEY_PATTERN="$S3_KEY_PATTERN" \
      -e AWS_ACCESS_KEY_ID="{{ S3_ACCESS_KEY_ID }}" \
      -e AWS_SECRET_ACCESS_KEY="{{ S3_SECRET }}" \
      -e AWS_DEFAULT_REGION="{{ S3_REGION }}" \
      "{{ UPLOADER_IMAGE }}:{{ UPLOADER_VERSION }}" || failed "Error. Not created"
  }
}

start() {
  local net="{{ STF_DOCKER_NETWORK }}"
  echo -e "\nInspecting network ${net}:"
  if docker network inspect "$net" > /dev/null 2>&1; then
    echo "Network '${net}' already exists"
  else
    echo "Network '${net}' does not exist. Creating..."
    docker network create "$net"
  fi

  local filter_device="$1"
  if [[ -n "$filter_device" && "$filter_device" != "ios" && "$filter_device" != "android" ]]; then
    get_device_fields "$filter_device" || return 1
    create_containers && start_containers
    echo -e "\n-----------------------------------------------------------------"
  else
    while read -r line; do
      get_device_fields "${line%%|*}" || continue
      [[ -z "$filter_device" || "$dev_platform_name" == "$filter_device" ]] || continue
      create_containers && start_containers
      echo -e "\n-----------------------------------------------------------------"
    done < "$MCLOUD_DEVICES"

    # do listener load only after creating last container otherwise listener starts in parallel
    # the listener handles iOS devices only, the android filter must not affect it
    [[ "$filter_device" == "android" ]] || launchctl load "${HOME}/Library/LaunchAgents/ZebrunnerDevicesListener.plist" > /dev/null 2>&1
  fi
}

start_containers() {
  echo -e "\n\tStarting '${dev_container}' containers:\n"
  [[ "$dev_connection" != "redroid" ]] || docker start "${dev_container}-redroid"
  docker start "${dev_container}-connector"
  docker start "${dev_container}-stf"
  docker start "${dev_container}-appium"
  docker start "${dev_container}-uploader"
}

stop() {
  local filter_device="$1"

  if [[ -n "$filter_device" && "$filter_device" != "ios" && "$filter_device" != "android" ]]; then
    get_device_fields "$filter_device" || return 1
    stop_containers
    echo -e "\n-----------------------------------------------------------------"
  else
    # the listener handles iOS devices only, the android filter must not affect it
    [[ "$filter_device" == "android" ]] || launchctl unload "${HOME}/Library/LaunchAgents/ZebrunnerDevicesListener.plist" > /dev/null 2>&1

    while read -r line; do
      get_device_fields "${line%%|*}" || continue
      [[ -z "$filter_device" || "$dev_platform_name" == "$filter_device" ]] || continue
      stop_containers
      echo -e "\n-----------------------------------------------------------------"
    done < "$MCLOUD_DEVICES"
  fi
}

stop_containers() {
  echo -e "\n\tStopping '${dev_container}' containers:\n"
  docker stop "${dev_container}-connector"
  docker stop "${dev_container}-appium"
  docker stop "${dev_container}-stf"
  docker stop "${dev_container}-uploader"
  [[ "$dev_connection" != "redroid" ]] || docker stop "${dev_container}-redroid"
}

down() {
  local filter_device="$1"

  if [[ -n "$filter_device" && "$filter_device" != "ios" && "$filter_device" != "android" ]]; then
    get_device_fields "$filter_device" || return 1
    remove_containers
    echo -e "\n-----------------------------------------------------------------"
  else
    # the listener handles iOS devices only, the android filter must not affect it
    [[ "$filter_device" == "android" ]] || launchctl unload "${HOME}/Library/LaunchAgents/ZebrunnerDevicesListener.plist" > /dev/null 2>&1

    while read -r line; do
      get_device_fields "${line%%|*}" || continue
      [[ -z "$filter_device" || "$dev_platform_name" == "$filter_device" ]] || continue
      remove_containers
      echo -e "\n-----------------------------------------------------------------"
    done < "$MCLOUD_DEVICES"
  fi
}

remove_containers() {
  echo -e "\n\tRemoving '${dev_container}' containers:\n"
  echo -n "Connector:  "
  docker rm -f "${dev_container}-connector" || failed "container not found"

  echo -n "Appium:     "
  docker rm -f "${dev_container}-appium" || failed "container not found"

  echo -n "STF:        "
  docker rm -f "${dev_container}-stf" || failed "container not found"

  echo -n "Uploader:   "
  docker rm -f "${dev_container}-uploader" || failed "container not found"

  if [[ "$dev_connection" == "redroid" ]]; then
    # the data volume of the emulator is kept: its apps and settings survive the recreation
    echo -n "Redroid:    "
    docker rm -f "${dev_container}-redroid" || failed "container not found"
  fi

  echo -ne "--\nVolume:     "
  docker volume rm "$dev_container" || failed "volume not found"
}

detect_uptime() {
  local started_at
  started_at="$(docker inspect --format='{{ '{{' }}.State.StartedAt{{ '}}' }}' "$1" | cut -d '.' -f 1)"
  local finished_at
  finished_at="$(docker inspect --format='{{ '{{' }}.State.FinishedAt{{ '}}' }}' "$1" | cut -d '.' -f 1)"

  local started_at_epoch
  started_at_epoch="$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$started_at" "+%s")"
  local finished_at_epoch
  if [[ "$finished_at" == "0001-01-01T00:00:00Z" ]]; then
    finished_at_epoch=0
  else
    finished_at_epoch="$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$finished_at" "+%s")"
  fi

  local uptime="UNKNOWN"
  if [[ "$started_at_epoch" -ge "$finished_at_epoch" ]]; then
    local current_time="UNKNOWN"
    current_time="$(TZ=UTC date "+%s")"
    local elapsed=$((current_time - started_at_epoch))
    uptime="$(printf "%02d:%02d:%02d" $((elapsed / 3600 % 24)) $((elapsed / 60 % 60)) $((elapsed % 60)))"
    # date based formatting wrapped around after 24 hours
    if ((elapsed >= 86400)); then
      uptime="$((elapsed / 86400))d ${uptime}"
    fi
  fi
  echo "$uptime"
}

detect_state() {
  local device_state="UNKNOWN"
  device_state="$(docker inspect --format='{{ '{{' }}.State.Health.Status{{ '}}' }}' "$1" 2> /dev/null)"
  echo "${device_state:-UNKNOWN}"
}

detect_status() {
  local device_status="UNKNOWN"
  device_status="$(docker inspect --format='{{ '{{' }}.State.Status{{ '}}' }}' "$1" 2> /dev/null)"
  echo "${device_status:-UNKNOWN}"
}

detect_restarts() {
  local device_restarts="UNKNOWN"
  device_restarts="$(docker inspect --format='{{ '{{' }}.RestartCount{{ '}}' }}' "$1" 2> /dev/null)"
  echo "${device_restarts:-UNKNOWN}"
}

verify_containers() {
  local ps_out
  ps_out="$(docker ps -a)"

  echo -e "\n\tVerify ${dev_container} containers:\n"

  if [[ "$dev_connection" == "usb" ]] && ! ioreg -p IOUSB -w0 -l | grep -q "${dev_udid//-/}"; then
    failed "\n--- DISCONNECTED ---\n"
  else
    local stf_state="UNKNOWN"
    local stf_status="UNKNOWN"
    local stf_uptime="UNKNOWN"
    local stf_restarts="UNKNOWN"

    if grep -q "${dev_container}-stf" <<< "$ps_out"; then
      stf_state="$(detect_state "${dev_container}-stf")"
      stf_status="$(detect_status "${dev_container}-stf")"
      stf_uptime="$(detect_uptime "${dev_container}-stf")"
      stf_restarts="$(detect_restarts "${dev_container}-stf")"
    fi

    local appium_state="UNKNOWN"
    local appium_status="UNKNOWN"
    local appium_uptime="UNKNOWN"
    local appium_restarts="UNKNOWN"
    if grep -q "${dev_container}-appium" <<< "$ps_out"; then
      appium_state="$(detect_state "${dev_container}-appium")"
      appium_status="$(detect_status "${dev_container}-appium")"
      appium_uptime="$(detect_uptime "${dev_container}-appium")"
      appium_restarts="$(detect_restarts "${dev_container}-appium")"
    fi

    local connector_state="UNKNOWN"
    local connector_status="UNKNOWN"
    local connector_uptime="UNKNOWN"
    local connector_restarts="UNKNOWN"
    if grep -q "${dev_container}-connector" <<< "$ps_out"; then
      connector_state="$(detect_state "${dev_container}-connector")"
      connector_status="$(detect_status "${dev_container}-connector")"
      connector_uptime="$(detect_uptime "${dev_container}-connector")"
      connector_restarts="$(detect_restarts "${dev_container}-connector")"
    fi

    local uploader_state="UNKNOWN"
    local uploader_status="UNKNOWN"
    local uploader_uptime="UNKNOWN"
    local uploader_restarts="UNKNOWN"
    if grep -q "${dev_container}-uploader" <<< "$ps_out"; then
      uploader_state="$(detect_state "${dev_container}-uploader")"
      uploader_status="$(detect_status "${dev_container}-uploader")"
      uploader_uptime="$(detect_uptime "${dev_container}-uploader")"
      uploader_restarts="$(detect_restarts "${dev_container}-uploader")"
    fi

    echo -e ",| Container,| State,| Status,| Uptime,| Restarts,|
,| ---------,| ---------,| ---------,| ---------,| ---------,|
,| Connector,| ${connector_state},| ${connector_status},| ${connector_uptime},| ${connector_restarts},|
,| Appium,| ${appium_state},| ${appium_status},| ${appium_uptime},| ${appium_restarts},|
,| STF,| ${stf_state},| ${stf_status},| ${stf_uptime},| ${stf_restarts},|
,| Uploader,| ${uploader_state},| ${uploader_status},| ${uploader_uptime},| ${uploader_restarts},|" | column -t -s ','

  fi
  echo -e "==============================================================\n"
}

status() {
  local filter_device="$1"

  if [[ -n "$filter_device" && "$filter_device" != "ios" && "$filter_device" != "android" ]]; then
    get_device_fields "$filter_device" || return 1
    verify_containers
  else
    while read -r line; do
      get_device_fields "${line%%|*}" || continue
      [[ -z "$filter_device" || "$dev_platform_name" == "$filter_device" ]] || continue
      verify_containers
    done < "$MCLOUD_DEVICES"
  fi
}

echo_help() {
  echo "
      Usage: zebrunner-farm [option]
      Arguments:
          status [device]      Status of MCloud Agent and each whitelisted device
          start [device]       Start devices containers
          stop [device]        Stop and keep devices containers
          restart [device]     Restart devices containers
          down [device]        Stop and remove devices containers
          ansible ['devices']  Run ansible-playbook script with custom or predefined args
          version              Show version of MCloud Agent components
      Device: udid or name of a whitelisted device, or ios/android for all devices of the platform.
      All whitelisted devices are used if the device is omitted."
  echo_telegram
  exit 0
}

main() {
  case "$1" in
  status)
    status "$2"
    ;;
  start)
    start "$2"
    ;;
  stop)
    stop "$2"
    ;;
  restart)
    down "$2"
    start "$2"
    ;;
  down)
    down "$2"
    ;;
  ansible)
    "${ZEBRUNNER_MCLOUD_AGENT_DIR}"/zebrunner.sh ansible "${@:2}"
    ;;
  version)
    "${ZEBRUNNER_MCLOUD_AGENT_DIR}"/zebrunner.sh version
    ;;
  *)
    echo_help
    ;;
  esac
}

main "$@"
