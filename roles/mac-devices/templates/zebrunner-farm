#!/bin/bash

# Export docker env variables to avoid issues on macOS
export DOCKER_BUILDKIT=0
export COMPOSE_DOCKER_CLI_BUILD=0
export DOCKER_DEFAULT_PLATFORM=linux/amd64

# Load utility functions
source "${ZEBRUNNER_MCLOUD_AGENT_DIR}/patch/utility.sh"

MCLOUD_DEVICES="/usr/local/bin/mcloud-devices.txt"

function on_usb_update() {
  read -r
  while true; do
    #The new line content is in the variable "$REPLY"
    echo "REPLY: ${REPLY}"

    # message on device connect
    # {"MessageType":"Attached","DeviceID":27,"Properties":{"ConnectionSpeed":480000000,"ConnectionType":"USB","DeviceID":27,"LocationID":336592896,"ProductID":4776,"SerialNumber":"b09fa26acc4c3f777e9b8b49e3348b7243f862b5"}}

    # message on device disconnect
    # {"MessageType":"Detached","DeviceID":27,"Properties":{"ConnectionSpeed":0,"ConnectionType":"","DeviceID":0,"LocationID":0,"ProductID":0,"SerialNumber":""}}

    # parse MessageType
    action="$(echo "$REPLY" | jq -r ".MessageType")"

    if [[ "$action" == "Attached" ]]; then
      echo "REPLY: ${REPLY}"
      # parse udid and start services
      udid="$(echo "$REPLY" | jq -r ".Properties.SerialNumber")"
      echo "udid: ${udid}"

      local device_name
      device_name="$(grep "$udid" "$MCLOUD_DEVICES" | cut -d '|' -f 3)"
      local device_name_underscored
      device_name_underscored="${device_name// /_}"
      echo "device_name_underscored: ${device_name_underscored}"
      if [ -z "$device_name_underscored" ]; then
        echo "${udid} device is not whitelisted in main.yml!"
        break
      fi

      verify_containers "$device_name_underscored" "$udid" && {
        echo "do nothing as state is valid (healthy or starting) for ${device_name_underscored} (${udid})"
        return 0
      }

      echo "zebrunner-farm restart ${udid}..."
      zebrunner-farm restart "$udid"
    fi

    read -r
  done
}

function listen() {
  # do analysis of ios listen output and organize automatic start/stop for connected/disconnected device
  ios listen | on_usb_update
}

function create_containers() {
  local device_name="$1"
  local udid="$2"
  local device_name_underscored="$3"
  local container="device-${device_name_underscored}-${udid}"

  local clean_udid
  clean_udid="${udid//-/}"
  local connected_devices
  connected_devices="$(ioreg -p IOUSB -w0 -l 2> /dev/null)"
  local wireless
  wireless="$(grep "$udid" "$MCLOUD_DEVICES" | cut -d '|' -f 11)"

  if [ "$wireless" == "true" ]; then
    echo -e "\nDevice with udid: '${clean_udid}' is wireless, skipping USB presence check."
  else
    connected_devices="$(ioreg -p IOUSB -w0 -l 2> /dev/null)"
    if echo "$connected_devices" | grep -q "$clean_udid"; then
      echo -e "\nDevice with udid: '${clean_udid}' was SUCCESSFULLY detected as connected."
    else
      echo -e "\nDevice with udid: '${clean_udid}' was NOT detected as connected. The containers will not be created."
      return 1
    fi
  fi

  local current_device
  current_device="$(grep "$udid" "$MCLOUD_DEVICES")" || {
    failed "UDID ${udid} not found in ${MCLOUD_DEVICES}" >&2
    return 1
  }

  local ps_out
  ps_out="$(docker ps -a)"
  if grep -v appium <<< "$ps_out" | grep -q "$container" && \
   grep appium      <<< "$ps_out" | grep -q "$container" && \
   grep connector   <<< "$ps_out" | grep -q "$container" && \
   grep uploader    <<< "$ps_out" | grep -q "$container"; then
     warn "Do nothing as containers already exists!"
     return 0
  fi

  local IFS='|'
  local -a fields
  read -r -a fields <<< "$current_device"
  unset IFS

  # We have 0 indexed array and that's why indexes of fields shifted by -1
  local platform_name="${fields[1]}"
  local location="${fields[3]}"
  local appium_port="${fields[4]}"
  local device_adb_port="${fields[5]}"
  local proxy_port="${fields[6]}"
  local server_proxy_port="${fields[7]}"
  local stf_min_port="${fields[8]}"
  local stf_max_port="${fields[9]}"

  # Field 11 - 'wireless'.
  # Marks a device with NO usb path, reached over a network tunnel maintained
  # outside this script (for example an Apple TV 4K, which has no diagnostic port at
  # all, reached over Apple's RemoteXPC tunnel). The field has existed in
  # mcloud-devices.txt since it was introduced but was never read; 'false' keeps
  # every existing row behaving exactly as before.
  local wireless="${fields[10]}"

  # Fields 14 / 15 - 'wda_host' and 'wda_port'.
  # Where WebDriverAgent is reachable for a WIRELESS device. The tunnel owner on the
  # host publishes WDA on a routable TCP endpoint and these point at it. For a usb
  # device both stay empty: the connector container owns WDA and is reached over a
  # docker --link instead.
  local wda_host="${fields[13]}"
  local wda_port="${fields[14]}"

  local net={{ STF_DOCKER_NETWORK }}

  docker network inspect "$net" > /dev/null 2>&1 || docker network create "$net"

  echo -e "\n\tCreating '${udid}' containers:\n"

  local S3_KEY_PATTERN=""
  local TENANT={{ S3_TENANT }}
  local BUCKET={{ S3_BUCKET }}
  if [ -n "$BUCKET" ]; then
    S3_KEY_PATTERN="s3://${BUCKET}${TENANT:+/${TENANT}}/artifacts/test-sessions"
  fi

  if [ "$platform_name" == "ios" ]; then

    local wda_ipa_path={{ WDA_FILE }}
    local device_wda_ipa_path
    device_wda_ipa_path="$(grep "$udid" "$MCLOUD_DEVICES" | cut -d '|' -f 12)"
    if [ -n "$device_wda_ipa_path" ] && [ ! "$device_wda_ipa_path" == "/dev/null" ]; then
      wda_ipa_path="$device_wda_ipa_path"
    fi
    if [ -z "$wda_ipa_path" ]; then
      # unable to use empty value for docker volume share!
      wda_ipa_path="/dev/null"
    fi
    echo "wda_ipa_path: ${wda_ipa_path}"

    local wda_bundle_id={{ WDA_BUNDLEID }}
    local device_wda_bundle_id
    device_wda_bundle_id="$(grep "$udid" "$MCLOUD_DEVICES" | cut -d '|' -f 13)"
    if [ -n "$device_wda_bundle_id" ]; then
      wda_bundle_id="$device_wda_bundle_id"
    fi
    if [ -z "$wda_bundle_id" ]; then
      # provide default value if empty
      wda_bundle_id="com.facebook.WebDriverAgentRunner.xctrunner"
    fi
    echo -e "wda_bundle_id: ${wda_bundle_id}\n"

    # How the device and appium containers reach WebDriverAgent is the only thing
    # that differs for a wireless device:
    #
    #   usb      - the connector container owns WDA. Containers --link to it and
    #              address it as host 'connector' (the historical behaviour).
    #   wireless - WDA is published by the tunnel owner on the host. There is no
    #              connector container to link, so WDA_HOST/WDA_PORT address it
    #              directly. WIRELESS=true additionally tells the device and appium
    #              containers to skip their usbmuxd clients, which cannot work here.
    #
    # No change is needed in the appium image: it already builds
    # 'appium:webDriverAgentUrl' as "http://${WDA_HOST}:${WDA_PORT}" (see
    # zbr-default-caps-gen.sh), so pointing those two variables elsewhere is enough.
    #
    # NOTE on the expansion form used below: macOS ships bash 3.2, where
    # "${arr[@]}" on an EMPTY array is an unbound-variable error under `set -u`.
    # "${arr[@]+"${arr[@]}"}" is the portable form and preserves element quoting.
    local wda_link_args=()
    local wda_env_args=(-e WDA_HOST=connector -e WDA_PORT=8100)
    if [ "$wireless" == "true" ]; then
      if [ -z "$wda_host" ]; then
        echo "ERROR! device ${udid} has wireless=true but no wda_host in field 14 of mcloud-devices.txt"
        echo "       A wireless device cannot be reached without a published WebDriverAgent endpoint."
        return 1
      fi
      if [ -z "$wda_port" ]; then
        wda_port=8100
      fi
      echo "wireless device: WDA at ${wda_host}:${wda_port} (no connector container)"
      wda_env_args=(-e WDA_HOST="$wda_host" -e WDA_PORT="$wda_port" -e WIRELESS=true)
    else
      wda_link_args=(--link "device-${device_name_underscored}-${udid}-connector:connector")
    fi

    # The connector exists purely to share usbmuxd into the other containers. A
    # wireless device has no usbmuxd path, so it is skipped entirely rather than
    # started and left failing.
    if [ "$wireless" != "true" ]; then
      echo -n "device-${device_name_underscored}-${udid}-connector:  "
      docker run -itd --name "device-${device_name_underscored}-${udid}-connector" \
        --log-driver=local \
        --log-opt max-size=256m \
        --log-opt max-file=2 \
        --net="$net" \
        --restart on-failure:{{ RESTARTS_LIMIT }} \
        "$DEVICE_ARG" \
        -e USBMUXD_SOCKET_ADDRESS={{ USBMUXD_SOCKET_ADDRESS }} \
        -e HOST_OS=DARWIN \
        -e DEVICE_BUS="$usb_bus" \
        -e WDA_BUNDLEID="$wda_bundle_id" \
        -e WDA_FILE=/tmp/zebrunner/WebDriverAgent.ipa \
        -v devimages_cache:/opt/zebrunner/devimages \
        -v "$wda_ipa_path":/tmp/zebrunner/WebDriverAgent.ipa \
        -v "device-${device_name_underscored}-${udid}-lockdown":/var/lib/lockdown \
        -v "device-${device_name_underscored}-${udid}":/tmp/log \
        -e DEVICE_UDID="$udid" \
        {{ IOS_CONNECTOR_IMAGE }}:{{ IOS_CONNECTOR_VERSION }} || echo 'already created'
    fi

    # Linking with appium required to share usbmuxd via socat
    echo -n "device-${device_name_underscored}-${udid}:            "
    docker run -d --name "device-${device_name_underscored}-${udid}" \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      "${wda_link_args[@]+"${wda_link_args[@]}"}" \
      "${wda_env_args[@]+"${wda_env_args[@]}"}" \
      -e WDA_WAIT_TIMEOUT=60 \
      -e PLATFORM_NAME="$platform_name" \
      -e STF_PROVIDER_DEVICE_NAME="$device_name" \
      -e DEVICE_UDID="$udid" \
      -e STF_PROVIDER_HOST={{ STF_PROVIDER_HOST }} \
      -e STF_PROVIDER_NAME="{{ STF_PROVIDER_NAME }}${location:+_$location}" \
      -e STF_PROVIDER_MIN_PORT="$stf_min_port" \
      -e STF_PROVIDER_MAX_PORT="$stf_max_port" \
      -p "$stf_min_port"-"$stf_max_port":"$stf_min_port"-"$stf_max_port" \
      -e STF_PROVIDER_PUBLIC_IP={{ PUBLIC_IP }} \
      -e PUBLIC_IP_PORT={{ PUBLIC_IP_PORT }} \
      -e PUBLIC_IP_PROTOCOL={{ PUBLIC_IP_PROTOCOL }} \
      -e STF_PROVIDER_CONNECT_SUB={{ STF_PROVIDER_CONNECT_SUB }} \
      -e STF_PROVIDER_CONNECT_PUSH={{ STF_PROVIDER_CONNECT_PUSH }} \
      -e STF_PROVIDER_CONNECT_APP_DEALER={{ STF_PROVIDER_CONNECT_APP_DEALER }} \
      -e STF_PROVIDER_CONNECT_DEV_DEALER={{ STF_PROVIDER_CONNECT_DEV_DEALER }} \
      -e RETHINKDB_PORT_28015_TCP={{ STF_RETHINKDB }} \
      -e STF_STORAGE_TOKEN={{ STF_STORAGE_TOKEN }} \
      {{ DEVICE_IMAGE }}:{{DEVICE_VERSION }} || echo 'already created'

    # candidates for removal: ADB_PORT, STF_PROVIDER_MAX_PORT
    echo -n "device-${device_name_underscored}-${udid}-appium:     "
    docker run -itd --name "device-${device_name_underscored}-${udid}-appium" \
      -m 1g \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      "$DEVICE_ARG" \
      --link "device-${device_name_underscored}-${udid}":device \
      "${wda_link_args[@]+"${wda_link_args[@]}"}" \
      "${wda_env_args[@]+"${wda_env_args[@]}"}" \
      -v appium-storage-volume:/opt/appium-storage \
      -v "device-${device_name_underscored}-${udid}":/tmp/log \
      -e TASK_LOG=/tmp/log/appium.log \
      -e APPIUM_CLI="--session-override" \
      -e PLATFORM_NAME="$platform_name" \
      -e RETAIN_TASK=true \
      -e CONNECT_TO_GRID=true \
      -e RECORD_ARTIFACTS=true \
      -e CUSTOM_NODE_CONFIG=true \
      -e STF_PROVIDER_HOST={{ STF_PROVIDER_HOST }} \
      -e APPIUM_APP_SIZE_DISABLE={{ APPIUM_APP_SIZE_DISABLE }} \
      -e APPIUM_APP_FETCH_RETRIES={{ APPIUM_APP_FETCH_RETRIES }} \
      -e APPIUM_MAX_LOCK_FILE_LIFETIME={{ APPIUM_MAX_LOCK_FILE_LIFETIME }} \
      -e APPIUM_APP_WAITING_TIMEOUT={{ APPIUM_APP_WAITING_TIMEOUT }} \
      -e SELENIUM_HOST={{ SELENIUM_HUB_HOST }} \
      -e SELENIUM_PORT={{ SELENIUM_HUB_PORT }} \
      -e DEFAULT_CAPABILITIES=true \
      -e DEVICE_NAME="$device_name" \
      -e DEVICE_UDID="$udid" \
      -e ADB_PORT="$device_adb_port" \
      -e PROXY_PORT="$proxy_port" \
      -e SERVER_PROXY_PORT="$server_proxy_port" \
      -e APPIUM_PORT="$appium_port" \
      -p "$appium_port":"$appium_port" \
      -e RELAXED_SECURITY=true \
      {{ APPIUM_IMAGE }}:{{ APPIUM_VERSION }} || echo 'already created'

    echo -n "device-${device_name_underscored}-${udid}-uploader:   "
    docker run -d --name "device-${device_name_underscored}-${udid}-uploader" \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      -v "device-${device_name_underscored}-${udid}":/tmp/log \
      -e ENDPOINT_URL={{ S3_ENDPOINT }} \
      -e S3_KEY_PATTERN="$S3_KEY_PATTERN" \
      -e AWS_ACCESS_KEY_ID={{ S3_ACCESS_KEY_ID }} \
      -e AWS_SECRET_ACCESS_KEY={{ S3_SECRET }} \
      -e AWS_DEFAULT_REGION={{ S3_REGION }} \
      {{ UPLOADER_IMAGE }}:{{ UPLOADER_VERSION }} || echo 'already created'

  else
    echo "ERROR! Unsupported platform: ${platform_name}"
    return 1
  fi
}

function stop() {
  local filter_device="$1"

  # if "$filter_device" is empty do stop for all connected devices otherwise stop only filtered
  if [ -n "$filter_device" ] && [ "$filter_device" != "ios" ] && [ "$filter_device" != "android" ]; then
    echo "stopping containers for ${filter_device}..."
    local device_name
    device_name="$(grep "$filter_device" "$MCLOUD_DEVICES" | cut -d '|' -f 3)"
    local device_name_underscored
    device_name_underscored="${device_name// /_}"
    local udid
    udid="$(grep "$filter_device" "$MCLOUD_DEVICES" | cut -d '|' -f 1)"

    if [ -z "$device_name" ] || [ -z "$udid" ]; then
      echo_warning "Unable to find device by \"${filter_device}\"!"
      return 0
    fi

    stop_containers "$device_name_underscored" "$udid"
  else
    launchctl unload "${HOME}/Library/LaunchAgents/ZebrunnerDevicesListener.plist" > /dev/null 2>&1

    # as no device filter provided continue with stopping all device containers
    while read -r line; do
      local device_name
      device_name="$(grep "$filter_device" <<< "$line" | cut -d '|' -f 3)"
      local device_name_underscored
      device_name_underscored="${device_name// /_}"
      local udid
      udid="$(grep "$filter_device" <<< "$line" | cut -d '|' -f 1)"
      stop_containers "$device_name_underscored" "$udid"
    done < "$MCLOUD_DEVICES"
  fi
}

function stop_containers() {
  echo -e "\n\tStop ${udid} containers:"
  local device_name="$1"
  local udid="$2"
  local container="device-${device_name}-${udid}"
  echo "${container} stopping..."
  # connector should be stopped first to disconnect in STF asap
  docker stop "${container}-connector"
  docker stop "${container}-appium"
  docker stop "${container}"
  docker stop "${container}-uploader"
}

function down() {
  local filter_device="$1"

  # if "$filter_device" is empty do rm for all connected devices otherwise rm only filtered
  if [ -n "$filter_device" ] && [ "$filter_device" != "ios" ] && [ "$filter_device" != "android" ]; then
    local device_name
    device_name="$(grep "$filter_device" "$MCLOUD_DEVICES" | cut -d '|' -f 3)"
    local device_name_underscored
    device_name_underscored="${device_name// /_}"
    local udid
    udid="$(grep "$filter_device" "$MCLOUD_DEVICES" | cut -d '|' -f 1)"

    if [ -z "$device_name" ] || [ -z "$udid" ]; then
      echo_warning "Unable to find device by \"${filter_device}\"!"
      return 0
    fi

    remove_containers "$device_name_underscored" "$udid"
  else
    launchctl unload "${HOME}/Library/LaunchAgents/ZebrunnerDevicesListener.plist" > /dev/null 2>&1

    while read -r line; do
      local device_name
      device_name="$(grep "$filter_device" <<< "$line" | cut -d '|' -f 3)"
      local device_name_underscored
      device_name_underscored="${device_name// /_}"
      local udid
      udid="$(grep "$filter_device" <<< "$line" | cut -d '|' -f 1)"
      remove_containers "$device_name_underscored" "$udid"
    done < "$MCLOUD_DEVICES"
  fi
}

function remove_containers() {
  local device_name="$1"
  local udid="$2"
  local container="device-${device_name}-${udid}"
  local ps_out
  ps_out="$(docker ps -a)"

  echo -e "\n\tRemoving '${udid}' data:\n"
  echo -n "Connector:  "
  if grep connector <<< "$ps_out" | grep -q "$container"; then
    docker rm -f "${container}-connector"
  else
    failed "container not found"
  fi

  echo -n "Appium:     "
  if grep appium <<< "$ps_out" | grep -q "$container"; then
    docker rm -f "${container}-appium"
  else
    failed "container not found"
  fi

  echo -n "STF:        "
  if grep -v appium <<< "$ps_out" | grep -q "$container"; then
    docker rm -f "${container}"
  else
    failed "container not found"
  fi

  echo -n "Uploader:   "
  if grep uploader <<< "$ps_out" | grep -q "$container"; then
    docker rm -f "${container}-uploader"
  else
    failed "container not found"
  fi

  echo -ne "--\nVolume:     "
  if docker volume ls | grep -q "$container"; then
    docker volume rm "$container"
  else
    echo "volume not found"
  fi

  echo -e "\n-----------------------------------------------------------------"
}

function detect_uptime() {
  local started_at
  started_at="$(docker inspect --format='{{ '{{' }}.State.StartedAt{{ '}}' }}' "$1" | cut -d '.' -f 1)"
  local finished_at
  finished_at="$(docker inspect --format='{{ '{{' }}.State.FinishedAt{{ '}}' }}' "$1" | cut -d '.' -f 1)"

  local started_at_epoch
  started_at_epoch="$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$started_at" "+%s")"
  local finished_at_epoch
  if [ "$finished_at" = "0001-01-01T00:00:00Z" ]; then
    finished_at_epoch=0
  else
    finished_at_epoch="$(TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "$finished_at" "+%s")"
  fi

  local uptime="UNKNOWN"
  if [ "$started_at_epoch" -gt "$finished_at_epoch" ]; then
    local current_time="UNKNOWN"
    current_time="$(TZ=UTC date "+%s")"
    uptime="$(TZ=UTC date -r "$((current_time - started_at_epoch))" "+%H:%M:%S")"
  fi
  echo "$uptime"
}

function detect_state() {
  local state="UNKNOWN"
  state="$(docker inspect --format='{{ '{{' }}.State.Health.Status{{ '}}' }}' "$1" 2> /dev/null)"
  echo "$state"
}

function detect_status() {
  local status="UNKNOWN"
  status="$(docker inspect --format='{{ '{{' }}.State.Status{{ '}}' }}' "$1" 2> /dev/null)"
  echo "$status"
}

function detect_restarts() {
  local restarts="UNKNOWN"
  restarts="$(docker inspect --format='{{ '{{' }}.RestartCount{{ '}}' }}' "$1" 2> /dev/null)"
  echo "$restarts"
}

function verify_containers() {
  local device_name="$1"
  local udid="$2"
  clean_udid="${udid//-/}"
  local container="device-${device_name}-${udid}"

  local ps_out
  ps_out="$(docker ps -a)"

  echo -e "\n\tVerify ${udid} containers:"

  if ! ioreg -p IOUSB -w0 -l | grep -q "$clean_udid"; then
    echo -e "${container}\n\nDISCONNECTED\n"
  else
    echo -e "${container}\n"

    local stf_state="UNKNOWN"
    local stf_status="UNKNOWN"
    local stf_uptime="UNKNOWN"
    local stf_restarts="UNKNOWN"

    if grep -v appium <<< "$ps_out" | grep -v uploader | grep -q "$container"; then
      stf_state="$(detect_state "$container")"
      stf_status="$(detect_status "$container")"
      stf_uptime="$(detect_uptime "$container")"
      stf_restarts="$(detect_restarts "$container")"
    fi

    local appium_state="UNKNOWN"
    local appium_status="UNKNOWN"
    local appium_uptime="UNKNOWN"
    local appium_restarts="UNKNOWN"
    if grep appium <<< "$ps_out" | grep -q "$container"; then
      appium_state="$(detect_state "${container}-appium")"
      appium_status="$(detect_status "${container}-appium")"
      appium_uptime="$(detect_uptime "${container}-appium")"
      appium_restarts="$(detect_restarts "${container}-appium")"
    fi

    local connector_state="UNKNOWN"
    local connector_status="UNKNOWN"
    local connector_uptime="UNKNOWN"
    local connector_restarts="UNKNOWN"
    if grep connector <<< "$ps_out" | grep -q "$container"; then
      connector_state="$(detect_state "${container}-connector")"
      connector_status="$(detect_status "${container}-connector")"
      connector_uptime="$(detect_uptime "${container}-connector")"
      connector_restarts="$(detect_restarts "${container}-connector")"
    fi

    local uploader_state="UNKNOWN"
    local uploader_status="UNKNOWN"
    local uploader_uptime="UNKNOWN"
    local uploader_restarts="UNKNOWN"
    if grep uploader <<< "$ps_out" | grep -q "$container"; then
      uploader_state="$(detect_state "${container}-uploader")"
      uploader_status="$(detect_status "${container}-uploader")"
      uploader_uptime="$(detect_uptime "${container}-uploader")"
      uploader_restarts="$(detect_restarts "${container}-uploader")"
    fi

    echo -e ",| Container,| State,| Status,| Uptime,| Restarts,|
,| ---------,| ---------,| ---------,| ---------,| ---------,|
,| Connector,| ${connector_state},| ${connector_status},| ${connector_uptime},| ${connector_restarts},|
,| Appium,| ${appium_state},| ${appium_status},| ${appium_uptime},| ${appium_restarts},|
,| STF,| ${stf_state},| ${stf_status},| ${stf_uptime},| ${stf_restarts},|
,| Uploader,| ${uploader_state},| ${uploader_status},| ${uploader_uptime},| ${uploader_restarts},|" | column -t -s ','

  fi
  echo -e "==============================================================\n"

  if [[ "$stf_state" != "\"healthy\"" ]] && [[ "$stf_state" != "\"starting\"" ]]; then
    return 1
  fi

  if [[ "$appium_state" != "\"healthy\"" ]] && [[ "$appium_state" != "\"starting\"" ]]; then
    return 1
  fi

  if [[ "$connector_state" != "\"healthy\"" ]] && [[ "$connector_state" != "\"starting\"" ]]; then
    return 1
  fi

  if [[ "$uploader_state" != "\"healthy\"" ]] && [[ "$uploader_state" != "\"starting\"" ]]; then
    return 1
  fi

  return 0
}

function start() {
  local filter_device="$1"

  # if "$filter_device" is empty do start for all connected devices otherwise start only filtered
  if [ -n "$filter_device" ] && [ "$filter_device" != "ios" ] && [ "$filter_device" != "android" ]; then
    local device_name
    device_name="$(grep "$filter_device" "$MCLOUD_DEVICES" | cut -d '|' -f 3)"
    local device_name_underscored
    device_name_underscored="${device_name// /_}"
    local udid
    udid="$(grep "$filter_device" "$MCLOUD_DEVICES" | cut -d '|' -f 1)"

    if [ -z "$device_name" ] || [ -z "$udid" ]; then
      echo_warning "Unable to find device by \"${filter_device}\"!"
      return 0
    fi

    create_containers "$device_name" "$udid" "$device_name_underscored" && \
      start_containers "$device_name" "$udid" "$device_name_underscored"
    echo -e "\n-----------------------------------------------------------------"
  else
    while read -r line; do
      local device_name
      device_name="$(grep "$filter_device" <<< "$line" | cut -d '|' -f 3)"
      local device_name_underscored
      device_name_underscored="${device_name// /_}"
      local udid
      udid="$(grep "$filter_device" <<< "$line" | cut -d '|' -f 1)"
      create_containers "$device_name" "$udid" "$device_name_underscored" && \
      start_containers "$device_name" "$udid" "$device_name_underscored"
      echo -e "\n-----------------------------------------------------------------"
    done < "$MCLOUD_DEVICES"

    # do listener load only after creating last container otherwise listener starts in parallel
    launchctl load "${HOME}/Library/LaunchAgents/ZebrunnerDevicesListener.plist" > /dev/null 2>&1
  fi
}

function start_containers() {
  local device_name="$1"
  local udid="$2"
  local device_name_underscored="$3"
  local container="device-${device_name_underscored}-${udid}"

  echo -e "\n\tStarting '${udid}' containers:\n"
  docker start "${container}-connector"
  docker start "${container}"
  docker start "${container}-appium"
  docker start "${container}-uploader"
}

function status() {
  local filter_device="$1"

  if [ -n "$filter_device" ] && [ "$filter_device" != "ios" ] && [ "$filter_device" != "android" ]; then
    local device_name
    device_name="$(grep "$filter_device" "$MCLOUD_DEVICES" | cut -d '|' -f 3)"
    local device_name_underscored
    device_name_underscored="${device_name// /_}"
    local udid
    udid="$(grep "$filter_device" "$MCLOUD_DEVICES" | cut -d '|' -f 1)"

    verify_containers "$device_name_underscored" "$udid"
  else
    while read -r line; do
      local device_name
      device_name="$(grep "$filter_device" <<< "$line" | cut -d '|' -f 3)"
      local device_name_underscored
      device_name_underscored="${device_name// /_}"
      local udid
      udid="$(grep "$filter_device" <<< "$line" | cut -d '|' -f 1)"
      if [ -z "$udid" ]; then
        continue
      fi
      verify_containers "$device_name_underscored" "$udid"
    done < "$MCLOUD_DEVICES"
  fi

}

function echo_help() {
  echo "
      Usage: zebrunner-farm [option]
      Arguments:
          status               Status of MCloud Agent and each whitelisted device
          start [udid]         Start devices containers or exact device by udid
          stop [udid]          Stop and keep devices containers or exact device by udid
          restart [udid]       Restart all devices containers or exact device by udid
          down [udid]          Stop and remove devices containers
          ansible ['devices']  Run ansible-playbook script with custom or predefined args
          version              Show version of MCloud Agent components"
  echo_telegram
  exit 0
}

case "$1" in
status)
  status "$2"
  ;;
start)
  start "$2"
  ;;
stop)
  stop "$2"
  ;;
restart)
  down "$2"
  start "$2"
  ;;
down)
  down "$2"
  ;;
ansible)
  "$ZEBRUNNER_MCLOUD_AGENT_DIR"/zebrunner.sh ansible "${@:2}"
  ;;
version)
  "$ZEBRUNNER_MCLOUD_AGENT_DIR"/zebrunner.sh version
  ;;
listen)
  listen
  ;;
*)
  echo_help
  ;;
esac
