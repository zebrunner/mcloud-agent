    -e DEVICE_UDID="$STF_DEVICE_UDID" \
    -e DEVICE_LOCATION="$dev_location" \
    -e ADB_PORT="$appium_adb_port" \
    -e APPIUM_PORT="$dev_appium_port" \
    -p "$dev_appium_port":"$dev_appium_port" \
    -e RELAXED_SECURITY="${APPIUM_RELAXED_SECURITY}" \
    -e STF_API_URL="${STF_API_URL}" \
    -e STF_AUTH_TOKEN \
    "${appium_tail_args[@]+"${appium_tail_args[@]}"}" \
    "${APPIUM_IMAGE}:${APPIUM_VERSION}" || return 1

  [[ "$record_artifacts" == "true" ]] || return 0
  # the secrets in the environment of docker, as of STF
  AWS_ACCESS_KEY_ID="$S3_ACCESS_KEY_ID" AWS_SECRET_ACCESS_KEY="$S3_SECRET" ensure_container uploader -d \
    --log-driver=local \
    --log-opt max-size=256m \
    --log-opt max-file=2 \
    --net="$STF_DOCKER_NETWORK" \
