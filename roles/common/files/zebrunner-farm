#!/bin/bash
# zebrunner-farm: the containers of the devices of a Linux or macOS host (README.md#devices-management). The same
# script on both OS, deployed by ./zebrunner.sh ansible; udev (Linux) and launchd (macOS) run it without the env
# variables of the user, so its settings come from the env file the deploy renders from config/settings.yml.

ZEBRUNNER_FARM_ENV="${ZEBRUNNER_FARM_ENV:-/usr/local/etc/zebrunner-farm.env}"
if [[ ! -r "$ZEBRUNNER_FARM_ENV" ]]; then
  echo "zebrunner-farm: the settings ${ZEBRUNNER_FARM_ENV} are not readable: deploy them with ./zebrunner.sh ansible" >&2
  exit 1
fi
# FARM_OS (linux or macos), ZEBRUNNER_MCLOUD_AGENT_DIR, MCLOUD_DEVICES and the settings of the containers
# shellcheck source=/dev/null
source "$ZEBRUNNER_FARM_ENV"
# `zebrunner-farm ansible` and `version` run zebrunner.sh of the agent, which needs it
export ZEBRUNNER_MCLOUD_AGENT_DIR

source "${ZEBRUNNER_MCLOUD_AGENT_DIR}/patch/utility.sh"

if [[ "$FARM_OS" == "macos" ]]; then
  # Export docker env variables to avoid issues on macOS
  export DOCKER_BUILDKIT=0
  export COMPOSE_DOCKER_CLI_BUILD=0
  # the images run on the platform of the Mac (arm64 on Apple Silicon: the STF provider of an iOS simulator hangs
  # under emulation, the other ones are slower), but appium: its image is linux/amd64 only
  unset DOCKER_DEFAULT_PLATFORM
fi

# with_device_lock <device> <command...>: the commands of one device run one at a time: the jobs of udev
# (mcloud-device-restart@, mcloud-device-down@) and the manual calls do not change its containers together; a group of
# devices (no device given), macOS (no udev) and a host without flock run without it
with_device_lock() {
  local device="$1"
  shift
  if [[ -z "$device" || "$device" == "ios" || "$device" == "android" || "$FARM_OS" == "macos" ]] ||
    ! command -v flock > /dev/null 2>&1; then
    "$@"
    return
  fi
  # the device by its id: udev names it by the id, a user may name it by its name
  local id="$device"
  if get_device_fields "$device" > /dev/null 2>&1; then
    id="$dev_udid"
  fi
  local lock="${MCLOUD_LOCK_DIR:-/run/lock}/mcloud-device-${id//[^A-Za-z0-9._-]/_}.lock"
  # the file is shared by root (udev) and the users of docker
  [[ -e "$lock" ]] || (umask 000 && : >> "$lock") 2> /dev/null
  if [[ ! -r "$lock" ]]; then
    "$@"
    return
  fi
  (
    if ! flock -w "${MCLOUD_LOCK_TIMEOUT:-1800}" 9; then
      failed "another zebrunner-farm keeps the device ${device} for too long"
      exit 1
    fi
    "$@"
  ) 9< "$lock"
}

# device_line <udid or name>: the line of the device of mcloud-devices.txt (README.md#devices-management): one device per
# line, its fields key=value separated by '|' in any order, the comments start with '#'
device_line() {
  awk -F '|' -v filter="$1" 'filter != "" && !/^#/ {
      for (i = 1; i <= NF; i++) if ($i == "id=" filter || $i == "name=" filter) { print; exit }
    }' "$MCLOUD_DEVICES"
}

# get_device_fields <udid or name>: the dev_ variables of the device; an empty field is the value by default
get_device_fields() {
  local filter="$1"

  local -a fields
  dev_udid=""
  dev_platform_name=""
  dev_device_name=""
  dev_location=""
  dev_appium_port=""
  dev_adb_port=""
  dev_stf_min_port=""
  dev_stf_max_port=""
  dev_connection=""
  dev_device_wda_ipa_path=""
  dev_device_wda_bundle_id=""
  dev_address=""
  dev_wda_port=""
  dev_mjpeg_port=""
  dev_connect_port=""
  dev_remote_port=""

  local line
  # exact match of the udid (id) or the name
  line="$(device_line "$filter")"
  if [[ -z "$line" ]]; then
    failed "device not found: ${filter}"
    return 1
  fi

  local IFS='|'
  read -r -a fields <<< "$line"
  unset IFS
  local field
  local value
  for field in "${fields[@]}"; do
    value="${field#*=}"
    case "${field%%=*}" in
    id) dev_udid="$value" ;;
    os) dev_platform_name="$value" ;;
    name) dev_device_name="$value" ;;
    location) dev_location="$value" ;;
    appium_port) dev_appium_port="$value" ;;
    adb_port) dev_adb_port="$value" ;;
    min_port) dev_stf_min_port="$value" ;;
    max_port) dev_stf_max_port="$value" ;;
    connection) dev_connection="$value" ;;
    wda_file) dev_device_wda_ipa_path="$value" ;;
    wda_bundleid) dev_device_wda_bundle_id="$value" ;;
    address) dev_address="$value" ;;
    wda_port) dev_wda_port="$value" ;;
    mjpeg_port) dev_mjpeg_port="$value" ;;
    connect_port) dev_connect_port="$value" ;;
    esac
  done

  # 'connection': how the connector container reaches the device. Docker of macOS has no USB, so there the
  # connector takes a USB device from the host: usbmuxd (iOS) or the adb server (Android) of the host.
  #   usb         - plugged into the host: Linux: passed into the connector, udev starts and removes its containers;
  #                 macOS: iOS over usbmuxd of the host, Android over the adb server of the host
  #   wireless    - over the network: Android over adb connect; iOS: netmuxd of the connector (Linux), usbmuxd of the
  #                 host for a device paired with the Mac (macOS)
  #   android-sim - an Android emulator started outside the farm (AVD, Genymotion, a container Android; an AVD of the
  #                 Mac is host.docker.internal:5555), adb connect to its address
  #   ios-sim     - an iOS / tvOS simulator of a macOS host, the connector runs xcrun simctl of the host over ssh
  #   proxy       - WebDriverAgent published by another tool, the connector relays it (iOS)
  # The non-usb devices have no udev rules, `zebrunner-farm start` creates their containers.
  dev_connection="${dev_connection:-usb}"

  # 'wda_file' and 'wda_bundleid': device specific WebDriverAgent path (the simulator build for a simulator) and bundle
  # ID, WDA_FILE (WDA_SIMULATOR_FILE) and WDA_BUNDLEID of the settings by default
  if [[ "$dev_device_wda_ipa_path" == "/dev/null" || -z "$dev_device_wda_ipa_path" ]]; then
    dev_device_wda_ipa_path="${WDA_FILE}"
    if [[ "$dev_connection" == "ios-sim" ]]; then
      dev_device_wda_ipa_path="${WDA_SIMULATOR_FILE}"
    fi
  fi
  : "${dev_device_wda_ipa_path:=/dev/null}"

  if [[ "$dev_device_wda_bundle_id" == "/dev/null" || -z "$dev_device_wda_bundle_id" ]]; then
    dev_device_wda_bundle_id="${WDA_BUNDLEID}"
  fi
  : "${dev_device_wda_bundle_id:=com.facebook.WebDriverAgentRunner.xctrunner}"

  # 'address', 'wda_port' and 'mjpeg_port':
  # address: the adb address of a wireless Android device or of an emulator (the id by default), the IP of a wireless
  # iOS device (Linux) or the host of the proxied WebDriverAgent;
  # wda_port and mjpeg_port: the ports of WebDriverAgent on the host for a simulator (unique, a simulator shares the
  # network of the host) or on the address for the proxy

  # 'connect_port': the remote debug port of STF (adb connect) of an Android device, the second port of min_port-max_port
  # (STF_PROVIDER_CONNECT_PORT is not set) by default; dev_remote_port is the port of either case
  dev_remote_port="${dev_connect_port:-$((dev_stf_min_port + 1))}"

  # Common name prefix for all containers
  dev_container="device-${dev_device_name}-${dev_udid}"
}

# usb_present: 0 when the USB device of get_device_fields is plugged into the host: the symlink of udev (Linux), ioreg
# (macOS)
usb_present() {
  if [[ "$FARM_OS" == "macos" ]]; then
    ioreg -p IOUSB -w0 -l | grep -q "${dev_udid//-/}"
  else
    [[ -L "/dev/${dev_container}" ]]
  fi
}

# usb_connected: 0 when the USB device of get_device_fields is plugged into the host: lsusb (Linux), ioreg (macOS)
usb_connected() {
  local tool="lsusb"
  local connected_devices
  if [[ "$FARM_OS" == "macos" ]]; then
    tool="ioreg"
    connected_devices="$(ioreg -p IOUSB -w0 -l 2> /dev/null)"
  else
    connected_devices="$(lsusb -v 2> /dev/null)"
  fi
  if grep -q "${dev_udid//-/}" <<< "$connected_devices"; then
    echo "  connected over USB"
    return 0
  fi
  failed "  NOT connected over USB (${tool}): the containers are not created."
  return 1
}

# create_containers: the containers of the device of get_device_fields running, one line per container. The connector
# is the only point of contact with the device: the STF and Appium containers --link to it and take adb (Android),
# usbmuxd, WebDriverAgent and the shared tunnel (iOS) from it whatever the connection is. The arguments of one OS are
# in arrays expanded as "${arr[@]+"${arr[@]}"}": macOS ships bash 3.2, where "${arr[@]}" of an EMPTY array is an
# unbound-variable error under `set -u`; the portable form preserves the quoting of the elements.
create_containers() {
  read_container_states

  local macos=""
  [[ "$FARM_OS" == "macos" ]] && macos="true"

  # Linux: the USB device is passed into the connector by the symlink of udev
  local usb_bus=""
  local device_args=()
  if [[ -z "$macos" ]]; then
    usb_bus="$(readlink -f "/dev/${dev_container}")"
    device_args=(--device="/dev/${dev_container}:${usb_bus}")
    [[ "$dev_connection" == "usb" ]] || device_args=()
  fi
  if [[ "$dev_connection" == "usb" ]]; then
    usb_connected || return 1
  fi

  local S3_KEY_PATTERN=""
  local TENANT="${S3_TENANT}"
  local BUCKET="${S3_BUCKET}"
  if [[ -n "$BUCKET" ]]; then
    S3_KEY_PATTERN="s3://${BUCKET}${TENANT:+/${TENANT}}/artifacts/test-sessions"
  fi

  # the fixed remote debug port of an Android device, published when it is out of min_port-max_port
  local connect_args=()
  if [[ -n "$dev_connect_port" ]]; then
    connect_args=(-e STF_PROVIDER_CONNECT_PORT="$dev_connect_port")
    if ((dev_connect_port < dev_stf_min_port || dev_connect_port > dev_stf_max_port)); then
      connect_args+=(-p "${dev_connect_port}:${dev_connect_port}")
    fi
  fi

  # macOS: the image of appium is linux/amd64 only
  local platform_args=()
  [[ -n "$macos" ]] && platform_args=(--platform linux/amd64)
  local STF_DEVICE_UDID="$dev_udid"
  local connector_args=()
  # the arguments of the platform of the STF and appium containers, in their places of the shared calls below
  local stf_head_args=()
  local stf_dealer_args=()
  local appium_head_args=()
  local appium_cli_args=()
  local appium_platform_args=()
  local appium_tail_args=()
  local appium_adb_port=""

  if [[ "$dev_platform_name" == "android" ]]; then
    # Linux: the USB device (DEVICE_BUS) or the adb address (ANDROID_DEVICE) of the connector, and of appium for the
    # remote adb connect on its startup; macOS: the adb server of the host or the adb address (connector_args)
    local bus_args=()
    local android_args=()
    local address="${dev_address:-$dev_udid}"
    # the adb address of the device or of the emulator (the id by default), with the 5555 port unless it has a port
    [[ "$address" == *:* ]] || address="${address}:5555"
    if [[ -n "$macos" ]]; then
      case "$dev_connection" in
      usb)
        # the device stays on the adb server of the host, the connector forwards it to its own adb server
        local adb_server="${ADB_SERVER_SOCKET_ADDRESS:-host.docker.internal:5037}"
        connector_args=(-e ADB_TRANSPORT_SERVER="$adb_server" -e ADB_TRANSPORT_SERIAL="$dev_udid" -e ADB_TRANSPORT_PORT="$dev_adb_port")
        STF_DEVICE_UDID="${adb_server%:*}:${dev_adb_port}"
        ;;
      wireless | android-sim)
        connector_args=(-e ANDROID_DEVICE="$address")
        STF_DEVICE_UDID="$address"
        ;;
      *)
        failed "  Unsupported connection of an Android device: ${dev_connection}. The containers will not be created."
        return 1
        ;;
      esac
    else
      local android_device=""
      if [[ "$dev_connection" =~ ^(wireless|android-sim)$ ]]; then
        android_device="$address"
        # the port is appended to be able to rename device in STF
        STF_DEVICE_UDID="$address"
      fi
      bus_args=("${device_args[@]+"${device_args[@]}"}" -e DEVICE_BUS="$usb_bus")
      android_args=(-e ANDROID_DEVICE="$android_device")
    fi

    ensure_container connector -itd \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$STF_DOCKER_NETWORK" \
      --restart "on-failure:${RESTARTS_LIMIT}" \
      "${bus_args[@]+"${bus_args[@]}"}" \
      -v mcloud-key-volume:/root/.android \
      -v "${dev_container}":/tmp/log \
      -e PLATFORM_NAME="$dev_platform_name" \
      "${android_args[@]+"${android_args[@]}"}" \
      -e DEVICE_UDID="$STF_DEVICE_UDID" \
      "${connector_args[@]+"${connector_args[@]}"}" \
      "${ANDROID_CONNECTOR_IMAGE}:${ANDROID_CONNECTOR_VERSION}" || return 1

    stf_head_args=(--link "${dev_container}-connector":connector -e STF_PROVIDER_ADB_HOST=connector -e STF_PROVIDER_ADB_PORT=5037
      --health-start-period 60s --restart "on-failure:${RESTARTS_LIMIT}")
    appium_head_args=(--link "${dev_container}-stf":device --link "${dev_container}-connector":connector)
    appium_platform_args=(-e DEVICE_CONNECTION="$dev_connection" "${android_args[@]+"${android_args[@]}"}")
    appium_adb_port="$dev_remote_port"
    # the adb server of the connector, the STF API to move the device to Unhealthy
    appium_tail_args=(-e ADB_SERVER_SOCKET=tcp:connector:5037 -e REMOTE_ADB_HOST=connector -e STF_API_URL="${STF_API_URL}"
      -e STF_AUTH_TOKEN="${STF_AUTH_TOKEN}")

  elif [[ "$dev_platform_name" == "ios" ]]; then

    echo "  WDA: ${dev_device_wda_ipa_path} (${dev_device_wda_bundle_id})"

    # WIRELESS=true: the device has no usbmuxd (a simulator or a proxied WebDriverAgent), the connector relays WDA
    local wireless="false"
    local wda_file_path="/tmp/zebrunner/WebDriverAgent.ipa"
    local host_os="LINUX"
    # the arguments of the OS: of the connector before HOST_OS (host_args) and after it (os_args), of STF and appium
    # for WebDriverAgent of the connector (wda_args), of appium only (appium_args)
    local host_args=()
    local os_args=()
    local wda_args=()
    local appium_args=()
    if [[ -n "$macos" ]]; then
      host_os="DARWIN"
      case "$dev_connection" in
      usb | wireless)
        # usbmuxd of the host knows the USB devices and the network ones paired with the Mac; the connector installs
        # and starts WebDriverAgent over it
        connector_args=(-e USBMUXD_SOCKET_ADDRESS="${USBMUXD_SOCKET_ADDRESS}" -e DEVICE_CONNECTION="$dev_connection")
        ;;
      proxy)
        if [[ -z "$dev_address" ]]; then
          failed "  The proxy device needs the address of its WebDriverAgent. The containers will not be created."
          return 1
        fi
        connector_args=(-e DEVICE_CONNECTION=proxy -e DEVICE_ADDRESS="$dev_address"
          -e DEVICE_WDA_PORT="${dev_wda_port:-8100}" -e DEVICE_MJPEG_PORT="${dev_mjpeg_port:-8101}")
        wireless="true"
        ;;
      ios-sim)
        if [[ -z "$dev_wda_port" ]]; then
          failed "  The simulator needs wda_port: the unique port of its WebDriverAgent on the host. The containers will not be created."
          return 1
        fi
        # the simulator build of WDA: a .app folder or its .zip, mounted with its own name
        wda_file_path="/tmp/zebrunner/$(basename "$dev_device_wda_ipa_path")"
        local ssh_key="${ZEBRUNNER_MCLOUD_AGENT_DIR}/ssh/id_ed25519"
        connector_args=(-e DEVICE_CONNECTION=ios-sim -e HOST_SSH_USER="${HOST_SSH_USER}"
          -e DEVICE_WDA_PORT="$dev_wda_port" -e DEVICE_MJPEG_PORT="${dev_mjpeg_port:-$((dev_wda_port + 1))}"
          -v "${ssh_key}:/opt/zebrunner/ssh/id_ed25519:ro")
        # xcrun of the host for XCUITest, over ssh through the connector
        appium_args=(-e DEVICE_CONNECTION=ios-sim -e HOST_SSH_USER="${HOST_SSH_USER}"
          -v "${ssh_key}:/opt/zebrunner/ssh/id_ed25519:ro")
        wireless="true"
        ;;
      *)
        failed "  Unsupported connection of an iOS device: ${dev_connection}. The containers will not be created."
        return 1
        ;;
      esac
      wda_args=(-e WDA_HOST=connector -e WDA_PORT=8100 -e WIRELESS="$wireless")
    else
      if [[ "$dev_connection" == "android-sim" ]]; then
        failed "  The android-sim connection is for Android devices only. The containers will not be created."
        return 1
      fi
      if [[ "$dev_connection" == "ios-sim" ]]; then
        failed "  The iOS simulators run on a macOS host only. The containers will not be created."
        return 1
      fi
      if [[ "$dev_connection" =~ ^(wireless|proxy)$ && -z "$dev_address" ]]; then
        failed "  The ${dev_connection} iOS device needs its address in mcloud-devices.txt. The containers will not be created."
        return 1
      fi
      # the other containers take usbmuxd, WebDriverAgent and the shared tunnel from the connector
      # (GO_IOS_AGENT_HOST); a proxied WebDriverAgent has no usbmuxd (WIRELESS=true)
      [[ "$dev_connection" == "proxy" ]] && wireless="true"
      host_args=(--sysctl net.ipv6.conf.all.disable_ipv6=0)
      os_args=("${device_args[@]+"${device_args[@]}"}" --cap-add=NET_ADMIN --device=/dev/net/tun)
      connector_args=(-e DEVICE_CONNECTION="$dev_connection" -e DEVICE_ADDRESS="$dev_address")
      [[ -n "$dev_wda_port" ]] && connector_args+=(-e DEVICE_WDA_PORT="$dev_wda_port")
      [[ -n "$dev_mjpeg_port" ]] && connector_args+=(-e DEVICE_MJPEG_PORT="$dev_mjpeg_port")
      connector_args+=(-e DEVICE_BUS="$usb_bus")
      wda_args=(-e WDA_HOST=connector -e WIRELESS="$wireless")
    fi

    # Linux: the connection before WDA_BUNDLEID, macOS: after DEVICE_UDID
    local linux_connector_args=()
    local macos_connector_args=()
    if [[ -n "$macos" ]]; then
      macos_connector_args=("${connector_args[@]+"${connector_args[@]}"}")
    else
      linux_connector_args=("${connector_args[@]+"${connector_args[@]}"}")
    fi

    ensure_container connector -itd \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$STF_DOCKER_NETWORK" \
      "${host_args[@]+"${host_args[@]}"}" \
      --restart "on-failure:${RESTARTS_LIMIT}" \
      "${os_args[@]+"${os_args[@]}"}" \
      -e HOST_OS="$host_os" \
      "${linux_connector_args[@]+"${linux_connector_args[@]}"}" \
      -e WDA_BUNDLEID="$dev_device_wda_bundle_id" \
      -e WDA_FILE="$wda_file_path" \
      -v devimages_cache:/opt/zebrunner/devimages \
      -v "${dev_device_wda_ipa_path}":"$wda_file_path" \
      -v "${dev_container}-lockdown":/var/lib/lockdown \
      -v "${dev_container}":/tmp/log \
      -e DEVICE_UDID="$dev_udid" \
      "${macos_connector_args[@]+"${macos_connector_args[@]}"}" \
      "${IOS_CONNECTOR_IMAGE}:${IOS_CONNECTOR_VERSION}" || return 1

    # the GO_IOS_AGENT_HOST of the connector: Linux after WDA_HOST, macOS after WIRELESS
    local stf_wda_args=()
    if [[ -n "$macos" ]]; then
      stf_wda_args=("${wda_args[@]}" -e GO_IOS_AGENT_HOST=connector)
    else
      stf_wda_args=(-e WDA_HOST=connector -e GO_IOS_AGENT_HOST=connector -e WIRELESS="$wireless")
    fi

    # Linking with appium required to share usbmuxd via socat
    stf_head_args=(--restart "on-failure:${RESTARTS_LIMIT}" --link "${dev_container}-connector":connector "${stf_wda_args[@]}"
      -e WDA_WAIT_TIMEOUT=60)
    stf_dealer_args=(-e STF_PROVIDER_CONNECT_APP_DEALER="${STF_PROVIDER_CONNECT_APP_DEALER}"
      -e STF_PROVIDER_CONNECT_DEV_DEALER="${STF_PROVIDER_CONNECT_DEV_DEALER}")
    appium_head_args=("${device_args[@]+"${device_args[@]}"}" --link "${dev_container}-stf":device
      --link "${dev_container}-connector":connector "${wda_args[@]}" "${appium_args[@]+"${appium_args[@]}"}")
    appium_cli_args=(-e APPIUM_CLI="--session-override")
    # candidates for removal: ADB_PORT, STF_PROVIDER_MAX_PORT
    appium_adb_port="${dev_adb_port:-5037}"

  else
    failed "  Unsupported platform: ${dev_platform_name}"
    return 1
  fi

  ensure_container stf -d \
    --log-driver=local \
    --log-opt max-size=256m \
    --log-opt max-file=2 \
    --net="$STF_DOCKER_NETWORK" \
    "${stf_head_args[@]}" \
    -e PLATFORM_NAME="$dev_platform_name" \
    -e STF_PROVIDER_DEVICE_NAME="$dev_device_name" \
    -e DEVICE_UDID="$STF_DEVICE_UDID" \
    -e STF_PROVIDER_HOST="${STF_PROVIDER_HOST}" \
    -e REMOTE_CONNECT_HOST="${REMOTE_CONNECT_HOST}" \
    -e STF_PROVIDER_NAME="${STF_PROVIDER_NAME}${dev_location:+_$dev_location}" \
    -e STF_PROVIDER_MIN_PORT="$dev_stf_min_port" \
    -e STF_PROVIDER_MAX_PORT="$dev_stf_max_port" \
    "${connect_args[@]+"${connect_args[@]}"}" \
    -p "${dev_stf_min_port}-${dev_stf_max_port}":"${dev_stf_min_port}-${dev_stf_max_port}" \
    -e STF_PROVIDER_PUBLIC_IP="${PUBLIC_IP}" \
    -e PUBLIC_IP_PORT="${PUBLIC_IP_PORT}" \
    -e PUBLIC_IP_PROTOCOL="${PUBLIC_IP_PROTOCOL}" \
    -e STF_PROVIDER_CONNECT_SUB="${STF_PROVIDER_CONNECT_SUB}" \
    -e STF_PROVIDER_CONNECT_PUSH="${STF_PROVIDER_CONNECT_PUSH}" \
    "${stf_dealer_args[@]+"${stf_dealer_args[@]}"}" \
    -e STF_NODE_TOKEN="${MCLOUD_NODE_TOKEN}" \
    -e STF_ZMQ_CURVE_SERVER_PUBLIC_KEY="${STF_ZMQ_CURVE_SERVER_PUBLIC_KEY}" \
    -e STF_ZMQ_CURVE_SECRET_KEY="${STF_ZMQ_CURVE_SECRET_KEY}" \
    "${DEVICE_IMAGE}:${DEVICE_VERSION}" || return 1

  # APPIUM_RELAXED_SECURITY: the insecure features of Appium for every session, README.md#appium-security
  ensure_container appium -itd \
    "${platform_args[@]+"${platform_args[@]}"}" \
    -m 1g \
    --log-driver=local \
    --log-opt max-size=256m \
    --log-opt max-file=2 \
    --net="$STF_DOCKER_NETWORK" \
    --restart "on-failure:${RESTARTS_LIMIT}" \
    "${appium_head_args[@]}" \
    -v appium-storage-volume:/opt/appium-storage \
    -v "${dev_container}":/tmp/log \
    -e TASK_LOG=/tmp/log/appium.log \
    "${appium_cli_args[@]+"${appium_cli_args[@]}"}" \
    -e PLATFORM_NAME="$dev_platform_name" \
    "${appium_platform_args[@]+"${appium_platform_args[@]}"}" \
    -e RETAIN_TASK=true \
    -e CONNECT_TO_GRID=true \
    -e RECORD_ARTIFACTS=true \
    -e CUSTOM_NODE_CONFIG=true \
    -e STF_PROVIDER_HOST="${STF_PROVIDER_HOST}" \
    -e APPIUM_APP_SIZE_DISABLE="${APPIUM_APP_SIZE_DISABLE}" \
    -e APPIUM_APP_FETCH_RETRIES="${APPIUM_APP_FETCH_RETRIES}" \
    -e APPIUM_MAX_LOCK_FILE_LIFETIME="${APPIUM_MAX_LOCK_FILE_LIFETIME}" \
    -e APPIUM_APP_WAITING_TIMEOUT="${APPIUM_APP_WAITING_TIMEOUT}" \
    -e SELENIUM_HOST="${SELENIUM_HUB_HOST}" \
    -e SELENIUM_PORT="${SELENIUM_HUB_PORT}" \
    -e NODE_REGISTRATION_TOKEN="${MCLOUD_NODE_TOKEN}" \
    -e DEFAULT_CAPABILITIES=true \
    -e DEVICE_NAME="$dev_device_name" \
    -e DEVICE_UDID="$STF_DEVICE_UDID" \
    -e ADB_PORT="$appium_adb_port" \
    -e APPIUM_PORT="$dev_appium_port" \
    -p "$dev_appium_port":"$dev_appium_port" \
    -e RELAXED_SECURITY="${APPIUM_RELAXED_SECURITY}" \
    "${appium_tail_args[@]+"${appium_tail_args[@]}"}" \
    "${APPIUM_IMAGE}:${APPIUM_VERSION}" || return 1

  ensure_container uploader -d \
    --log-driver=local \
    --log-opt max-size=256m \
    --log-opt max-file=2 \
    --net="$STF_DOCKER_NETWORK" \
    --restart "on-failure:${RESTARTS_LIMIT}" \
    -v "${dev_container}":/tmp/log \
    -e ENDPOINT_URL="${S3_ENDPOINT}" \
    -e S3_KEY_PATTERN="$S3_KEY_PATTERN" \
    -e AWS_ACCESS_KEY_ID="${S3_ACCESS_KEY_ID}" \
    -e AWS_SECRET_ACCESS_KEY="${S3_SECRET}" \
    -e AWS_DEFAULT_REGION="${S3_REGION}" \
    "${UPLOADER_IMAGE}:${UPLOADER_VERSION}" || return 1
}

#### Containers

# the states of the containers of the host (`<name> <state>` lines), read before the containers of a device change
CONTAINER_STATES=""

# read_container_states: CONTAINER_STATES of `docker ps -a`
read_container_states() {
  CONTAINER_STATES="$(docker ps -a --format '{{.Names}} {{.State}}' 2> /dev/null)"
}

# container_state <name>: the state of the container (running, exited, ...), exists when docker gives none, nothing
# when there is no such container
container_state() {
  awk -v name="$1" '$1 == name { print ($2 == "" ? "exists" : $2); exit }' <<< "$CONTAINER_STATES"
}

# ensure_container <name suffix> <-d|-itd> <docker run arguments...>: the container of the device running: kept when it
# runs, started when it exists, created otherwise; one line of what was done, fails when the container does not run
ensure_container() {
  local role="$1"
  local mode="$2"
  shift 2
  local name="${dev_container}-${role}"
  local output
  printf '  %-10s ' "$role"
  case "$(container_state "$name")" in
  running)
    echo "running"
    ;;
  "")
    if output="$(docker run "$mode" --name "$name" "$@" 2>&1)"; then
      succeed "created $(tail -n 1 <<< "$output" | cut -c 1-12)"
    else
      failed "NOT created: $(tail -n 1 <<< "$output")"
      return 1
    fi
    ;;
  *)
    if output="$(docker start "$name" 2>&1)"; then
      succeed "started"
    else
      failed "NOT started: $(tail -n 1 <<< "$output")"
      return 1
    fi
    ;;
  esac
}

# stop_containers: the containers of the device stopped and kept, one line per container
stop_containers() {
  local role
  local output
  for role in connector appium stf uploader; do
    printf '  %-10s ' "$role"
    if output="$(docker stop "${dev_container}-${role}" 2>&1)"; then
      echo "stopped"
    elif grep -qi "no such container" <<< "$output"; then
      echo "no container"
    else
      failed "$(tail -n 1 <<< "$output")"
    fi
  done
}

# remove_containers: the containers of the device and the volume of its logs removed, one line per container
remove_containers() {
  local role
  local output
  for role in connector appium stf uploader; do
    printf '  %-10s ' "$role"
    # `docker rm -f` of no container succeeds without output (an error of the older docker versions)
    if output="$(docker rm -f "${dev_container}-${role}" 2>&1)" && [[ -n "$output" ]]; then
      echo "removed"
    elif [[ -z "$output" ]] || grep -qi "no such container" <<< "$output"; then
      echo "no container"
    else
      failed "$(tail -n 1 <<< "$output")"
    fi
  done
  printf '  %-10s ' "logs"
  if output="$(docker volume rm "$dev_container" 2>&1)"; then
    echo "volume removed"
  elif grep -qi "no such volume" <<< "$output"; then
    echo "no volume"
  else
    failed "$(tail -n 1 <<< "$output")"
  fi
}

# ensure_network: the docker network of the containers, created when it is missing
ensure_network() {
  if ! docker network inspect "$STF_DOCKER_NETWORK" > /dev/null 2>&1; then
    echo "Creating the docker network '${STF_DOCKER_NETWORK}'"
    docker network create "$STF_DOCKER_NETWORK" > /dev/null
  fi
}

#### Device selection

# The devices of a command: the SELECTORS of its arguments (all the devices without them) but the EXCLUDES of -x; QUIET
# (-q) skips the question. SELECTED are their udids in the order of mcloud-devices.txt. RESTART_STRATEGY of restart:
# batch removes the containers of all the devices, then creates them; rolling removes and creates them device by device.
SELECTORS=()
EXCLUDES=()
QUIET=""
SELECTED=()
RESTART_STRATEGY="batch"

# count <values...>: the number of the values; the length expansion of bash cannot be used, a template comment starts
# with its characters
count() {
  echo "$#"
}

# add_selectors <selectors|excludes> <list>: the selectors of a list separated by commas or spaces
add_selectors() {
  local -a items
  local item
  IFS=', ' read -r -a items <<< "$2"
  for item in "${items[@]}"; do
    [[ -n "$item" ]] || continue
    if [[ "$1" == "excludes" ]]; then
      EXCLUDES+=("$item")
    else
      SELECTORS+=("$item")
    fi
  done
}

# parse_selection <arguments...>: SELECTORS, EXCLUDES and QUIET of the arguments of a command
parse_selection() {
  SELECTORS=()
  EXCLUDES=()
  QUIET=""
  OUTPUT_JSON=""
  RESTART_STRATEGY="batch"
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -q | --quiet | -y | --yes)
      QUIET="true"
      ;;
    --batch | --rolling)
      RESTART_STRATEGY="${1#--}"
      ;;
    --json)
      OUTPUT_JSON="true"
      ;;
    --strategy | --strategy=*)
      if [[ "$1" == "--strategy" ]]; then
        RESTART_STRATEGY="$2"
        shift
      else
        RESTART_STRATEGY="${1#--strategy=}"
      fi
      if [[ "$RESTART_STRATEGY" != "batch" && "$RESTART_STRATEGY" != "rolling" ]]; then
        failed "--strategy is batch or rolling"
        return 1
      fi
      ;;
    -x | -e | --exclude)
      if [[ -z "$2" ]]; then
        failed "$1 needs the devices to skip"
        return 1
      fi
      add_selectors excludes "$2"
      shift
      ;;
    -x=* | -e=* | --exclude=*)
      add_selectors excludes "${1#*=}"
      ;;
    -*)
      failed "unknown option: $1"
      return 1
      ;;
    *)
      add_selectors selectors "$1"
      ;;
    esac
    shift
  done
}

# is_exact <selector>: 0 for the udid or the name of a device, 1 for a group or a pattern
is_exact() {
  case "$1" in
  ios | android | usb | wireless | android-sim | ios-sim | proxy | *[*?]*) return 1 ;;
  esac
  return 0
}

# device_matches <selector>: 0 when the device of get_device_fields is the selector: its udid or name, its platform
# (ios, android), its connection (usb, wireless, android-sim, ios-sim, proxy) or a pattern (* and ?) of its udid, name
# or location
device_matches() {
  case "$1" in
  ios | android)
    [[ "$dev_platform_name" == "$1" ]]
    ;;
  usb | wireless | android-sim | ios-sim | proxy)
    [[ "$dev_connection" == "$1" ]]
    ;;
  *[*?]*)
    # the selector is a pattern
    # shellcheck disable=SC2053
    [[ "$dev_udid" == $1 || "$dev_device_name" == $1 || "$dev_location" == $1 ]]
    ;;
  *)
    [[ "$dev_udid" == "$1" || "$dev_device_name" == "$1" ]]
    ;;
  esac
}

# in_selection: 0 when the device of get_device_fields is one of SELECTORS (any device without them) and none of
# EXCLUDES
in_selection() {
  local selector
  local included="true"
  if [[ "$(count "${SELECTORS[@]}")" -gt 0 ]]; then
    included=""
    for selector in "${SELECTORS[@]}"; do
      if device_matches "$selector"; then
        included="true"
        break
      fi
    done
  fi
  [[ -n "$included" ]] || return 1
  for selector in "${EXCLUDES[@]}"; do
    if device_matches "$selector"; then
      return 1
    fi
  done
  return 0
}

# single_device: the udid or the name of the arguments when they select one device exactly, nothing otherwise
single_device() {
  if [[ "$(count "${SELECTORS[@]}")" -eq 1 && "$(count "${EXCLUDES[@]}")" -eq 0 ]] && is_exact "${SELECTORS[0]}"; then
    echo "${SELECTORS[0]}"
  fi
}

# select_devices: SELECTED of SELECTORS and EXCLUDES; an udid or a name of no device fails, so does an empty selection
select_devices() {
  local selector
  local line
  SELECTED=()
  for selector in "${SELECTORS[@]}" "${EXCLUDES[@]}"; do
    if is_exact "$selector"; then
      get_device_fields "$selector" || return 1
    fi
  done
  while IFS= read -r line; do
    [[ "|${line}|" =~ \|id=([^|]*)\| ]] || continue
    get_device_fields "${BASH_REMATCH[1]}" > /dev/null || continue
    if in_selection; then
      SELECTED+=("$dev_udid")
    fi
  done < "$MCLOUD_DEVICES"
  if [[ "$(count "${SELECTED[@]}")" -eq 0 ]]; then
    warn "No device matches: ${SELECTORS[*]:-all devices}${EXCLUDES[*]:+ without ${EXCLUDES[*]}}"
    return 1
  fi
}

# refine_selection <keep|drop> <list>: SELECTED with only the devices of the list or without them; the list has the
# numbers of print_selection and the selectors, separated by commas or spaces
refine_selection() {
  local mode="$1"
  local -a items
  local -a kept=()
  local item
  local udid
  local hit
  local number=0
  [[ -n "${2//[ ,]/}" ]] || return 0
  IFS=', ' read -r -a items <<< "$2"
  for udid in "${SELECTED[@]}"; do
    number=$((number + 1))
    get_device_fields "$udid" > /dev/null || continue
    hit=""
    for item in "${items[@]}"; do
      if [[ -n "$item" ]] && { [[ "$item" == "$number" ]] || device_matches "$item"; }; then
        hit="true"
        break
      fi
    done
    if [[ "$mode" == "keep" && -n "$hit" ]] || [[ "$mode" == "drop" && -z "$hit" ]]; then
      kept+=("$udid")
    fi
  done
  SELECTED=("${kept[@]}")
}

# containers_summary: the state of the containers of the device of get_device_fields in CONTAINER_STATES
containers_summary() {
  awk -v prefix="${dev_container}-" '
    index($1, prefix) == 1 && substr($1, length(prefix) + 1) ~ /^(connector|stf|appium|uploader)$/ {
      total++
      if ($2 == "running") running++
    }
    END {
      if (!total) print "none"
      else if (running == total) print "running"
      else if (!running) print "stopped"
      else print running " of " total " running"
    }' <<< "$CONTAINER_STATES"
}

# print_selection: the numbered list of SELECTED with the state of their containers
print_selection() {
  local udid
  local number=0
  read_container_states
  {
    echo "No|Name|UDID|Platform|Connection|Location|Containers"
    for udid in "${SELECTED[@]}"; do
      number=$((number + 1))
      get_device_fields "$udid" > /dev/null || continue
      echo "${number}|${dev_device_name}|${dev_udid}|${dev_platform_name}|${dev_connection}|${dev_location:--}|$(containers_summary)"
    done
  } | column -t -s '|' | sed 's/^/  /'
}

# confirm_selection <command>: shows SELECTED to a person at the terminal, who runs the command for them, filters or
# excludes devices first, or cancels; no question with QUIET, for a single device named exactly or without a terminal
# (udev, launchd, scripts; MCLOUD_FARM_INTERACTIVE=true asks anyway)
confirm_selection() {
  local command="$1"
  local answer
  local value
  if [[ -n "$QUIET" || -n "$(single_device)" ]] || [[ ! -t 0 && "$MCLOUD_FARM_INTERACTIVE" != "true" ]]; then
    return 0
  fi
  local switch=""
  while true; do
    echo -e "\nThe devices to ${command} ($(count "${SELECTED[@]}")):"
    print_selection
    echo ""
    if [[ "$command" == "restart" ]]; then
      echo "Strategy: $(strategy_description)"
      switch=", [s]trategy"
    fi
    read -r -p "Run '${command}' for them? [Y]es, [n]o, [f]ilter the list, e[x]clude devices${switch}: " answer || return 1
    case "$answer" in
    [sS])
      if [[ "$RESTART_STRATEGY" == "batch" ]]; then
        RESTART_STRATEGY="rolling"
      else
        RESTART_STRATEGY="batch"
      fi
      ;;
    "" | [yY] | [yY][eE][sS])
      return 0
      ;;
    [nN] | [nN][oO])
      return 1
      ;;
    [fF] | [fF]" "*)
      value="${answer#?}"
      [[ -n "${value// /}" ]] || read -r -p "Keep the devices (numbers, udids, names, patterns, groups): " value
      refine_selection keep "$value"
      ;;
    [xX] | [xX]" "*)
      value="${answer#?}"
      [[ -n "${value// /}" ]] || read -r -p "Exclude the devices (numbers, udids, names, patterns, groups): " value
      refine_selection drop "$value"
      ;;
    *)
      echo "Answer y (run), n (cancel), f (keep only some devices) or x (exclude devices)."
      ;;
    esac
    if [[ "$(count "${SELECTED[@]}")" -eq 0 ]]; then
      warn "No device is left."
      return 1
    fi
  done
}

# strategy_description: RESTART_STRATEGY for a person
strategy_description() {
  if [[ "$RESTART_STRATEGY" == "rolling" ]]; then
    echo "rolling - device by device: its containers are removed and created again at once"
  else
    echo "batch - the containers of all the devices are removed, then all of them are created"
  fi
}

# restart_selected: restart of SELECTED by RESTART_STRATEGY
restart_selected() {
  if [[ "$RESTART_STRATEGY" == "rolling" || "$(count "${SELECTED[@]}")" -eq 1 ]]; then
    run_selected restart
    return
  fi
  echo -e "\nRemoving the containers of $(count "${SELECTED[@]}") devices (batch restart)"
  run_selected down
  echo -e "\nCreating the containers of $(count "${SELECTED[@]}") devices again"
  run_selected start
}

# run_selected <command>: the command (start, stop, restart, down, status) for every device of SELECTED
run_selected() {
  local command="$1"
  local udid
  for udid in "${SELECTED[@]}"; do
    get_device_fields "$udid" || continue
    echo -e "\n==> ${dev_device_name} (${dev_udid}, ${dev_platform_name}, ${dev_connection})"
    "${command}_device"
  done
}

stop_device() {
  stop_containers
}

down_device() {
  remove_containers
}

restart_device() {
  remove_containers
  start_device
}

status_device() {
  verify_containers
}

# start_device: the containers of the device of get_device_fields created and running; on Linux the USB devices that
# are not plugged in (no symlink of udev) are skipped unless the device is named exactly
start_device() {
  if [[ "$FARM_OS" != "macos" && -z "$(single_device)" && "$dev_connection" == "usb" && ! -L "/dev/${dev_container}" ]]; then
    echo "  not plugged in: skipped, udev starts it when it is connected"
    return 0
  fi
  create_containers
}

# listener_applies: 0 when the command is for the iOS devices of macOS as a group (all the devices or ios): the
# devices listener handles the USB iOS devices, stop and down unload it, start loads it
listener_applies() {
  [[ "$FARM_OS" == "macos" ]] || return 1
  local selector
  [[ "$(count "${SELECTORS[@]}")" -eq 0 ]] && return 0
  for selector in "${SELECTORS[@]}"; do
    [[ "$selector" == "ios" ]] && return 0
  done
  return 1
}

# epoch <docker time>: the seconds of a time of docker inspect (UTC), 0 for the zero time of a container never finished
epoch() {
  if [[ "$FARM_OS" != "macos" ]]; then
    date -d "$1" "+%s"
  elif [[ "$1" == 0001-01-01T00:00:00* ]]; then
    echo 0
  else
    TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "${1%%.*}" "+%s"
  fi
}

# json_string <value>: the value as a JSON string
json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\t'/\\t}"
  value="${value//$'\n'/\\n}"
  printf '"%s"' "$value"
}

# container_json <container>: the state of the container as a JSON object: {"exists": false} without it
container_json() {
  local info
  if ! info="$(docker inspect --format '{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}|{{.State.StartedAt}}|{{.RestartCount}}' "$1" 2> /dev/null)" ||
    [[ -z "$info" ]]; then
    printf '{"exists": false}'
    return 0
  fi
  local status health started restarts
  IFS='|' read -r status health started restarts <<< "$info"
  local uptime="null"
  local started_epoch
  if [[ "$status" == "running" ]]; then
    started_epoch="$(epoch "$started" 2> /dev/null)"
    [[ "$started_epoch" =~ ^[0-9]+$ ]] && uptime="$(($(date "+%s") - started_epoch))"
  fi
  [[ "$restarts" =~ ^[0-9]+$ ]] || restarts="null"
  if [[ -n "$health" ]]; then
    health="$(json_string "$health")"
  else
    health="null"
  fi
  printf '{"exists": true, "status": %s, "health": %s, "started_at": %s, "uptime_seconds": %s, "restarts": %s}' \
    "$(json_string "$status")" "$health" "$(json_string "$started")" "$uptime" "$restarts"
}

# status_json: the devices of SELECTED and their containers as a JSON array, one device per line (README.md#devices-management)
status_json() {
  local udid
  local separator=""
  local plugged_in
  echo "["
  for udid in "${SELECTED[@]}"; do
    get_device_fields "$udid" > /dev/null 2>&1 || continue
    plugged_in="null"
    if [[ "$dev_connection" == "usb" ]]; then
      plugged_in="false"
      usb_present > /dev/null 2>&1 && plugged_in="true"
    fi
    printf '%s{"id": %s, "name": %s, "os": %s, "connection": %s, "location": %s, "plugged_in": %s, "containers": {' \
      "$separator" "$(json_string "$dev_udid")" "$(json_string "$dev_device_name")" "$(json_string "$dev_platform_name")" \
      "$(json_string "$dev_connection")" "$(json_string "$dev_location")" "$plugged_in"
    printf '"connector": %s, "stf": %s, "appium": %s, "uploader": %s}}' "$(container_json "${dev_container}-connector")" \
      "$(container_json "${dev_container}-stf")" "$(container_json "${dev_container}-appium")" \
      "$(container_json "${dev_container}-uploader")"
    separator=$',\n'
  done
  printf '\n]\n'
}

detect_uptime() {
  local started_at
  started_at="$(docker inspect --format='{{.State.StartedAt}}' "$1")"
  local finished_at
  finished_at="$(docker inspect --format='{{.State.FinishedAt}}' "$1")"

  local started_at_epoch
  started_at_epoch="$(epoch "$started_at")"
  local finished_at_epoch
  finished_at_epoch="$(epoch "$finished_at")"

  local uptime="UNKNOWN"
  if [[ "$started_at_epoch" -ge "$finished_at_epoch" ]]; then
    local current_time="UNKNOWN"
    current_time="$(date "+%s")"
    local elapsed=$((current_time - started_at_epoch))
    uptime="$(printf "%02d:%02d:%02d" $((elapsed / 3600 % 24)) $((elapsed / 60 % 60)) $((elapsed % 60)))"
    # date based formatting wrapped around after 24 hours
    if ((elapsed >= 86400)); then
      uptime="$((elapsed / 86400))d ${uptime}"
    fi
  fi
  echo "$uptime"
}

detect_state() {
  local device_state="UNKNOWN"
  device_state="$(docker inspect --format='{{.State.Health.Status}}' "$1" 2> /dev/null)"
  echo "${device_state:-UNKNOWN}"
}

detect_status() {
  local device_status="UNKNOWN"
  device_status="$(docker inspect --format='{{.State.Status}}' "$1" 2> /dev/null)"
  echo "${device_status:-UNKNOWN}"
}

detect_restarts() {
  local device_restarts="UNKNOWN"
  device_restarts="$(docker inspect --format='{{.RestartCount}}' "$1" 2> /dev/null)"
  echo "${device_restarts:-UNKNOWN}"
}

verify_containers() {
  local ps_out
  ps_out="$(docker ps -a)"

  if [[ "$dev_connection" == "usb" ]] && ! usb_present; then
    failed "\n--- DISCONNECTED ---\n"
  else
    local stf_state="UNKNOWN"
    local stf_status="UNKNOWN"
    local stf_uptime="UNKNOWN"
    local stf_restarts="UNKNOWN"

    if grep -q "${dev_container}-stf" <<< "$ps_out"; then
      stf_state="$(detect_state "${dev_container}-stf")"
      stf_status="$(detect_status "${dev_container}-stf")"
      stf_uptime="$(detect_uptime "${dev_container}-stf")"
      stf_restarts="$(detect_restarts "${dev_container}-stf")"
    fi

    local appium_state="UNKNOWN"
    local appium_status="UNKNOWN"
    local appium_uptime="UNKNOWN"
    local appium_restarts="UNKNOWN"
    if grep -q "${dev_container}-appium" <<< "$ps_out"; then
      appium_state="$(detect_state "${dev_container}-appium")"
      appium_status="$(detect_status "${dev_container}-appium")"
      appium_uptime="$(detect_uptime "${dev_container}-appium")"
      appium_restarts="$(detect_restarts "${dev_container}-appium")"
    fi

    local connector_state="UNKNOWN"
    local connector_status="UNKNOWN"
    local connector_uptime="UNKNOWN"
    local connector_restarts="UNKNOWN"
    if grep -q "${dev_container}-connector" <<< "$ps_out"; then
      connector_state="$(detect_state "${dev_container}-connector")"
      connector_status="$(detect_status "${dev_container}-connector")"
      connector_uptime="$(detect_uptime "${dev_container}-connector")"
      connector_restarts="$(detect_restarts "${dev_container}-connector")"
    fi

    local uploader_state="UNKNOWN"
    local uploader_status="UNKNOWN"
    local uploader_uptime="UNKNOWN"
    local uploader_restarts="UNKNOWN"
    if grep -q "${dev_container}-uploader" <<< "$ps_out"; then
      uploader_state="$(detect_state "${dev_container}-uploader")"
      uploader_status="$(detect_status "${dev_container}-uploader")"
      uploader_uptime="$(detect_uptime "${dev_container}-uploader")"
      uploader_restarts="$(detect_restarts "${dev_container}-uploader")"
    fi

    echo -e ",| Container,| State,| Status,| Uptime,| Restarts,|
,| ---------,| ---------,| ---------,| ---------,| ---------,|
,| Connector,| ${connector_state},| ${connector_status},| ${connector_uptime},| ${connector_restarts},|
,| Appium,| ${appium_state},| ${appium_status},| ${appium_uptime},| ${appium_restarts},|
,| STF,| ${stf_state},| ${stf_status},| ${stf_uptime},| ${stf_restarts},|
,| Uploader,| ${uploader_state},| ${uploader_status},| ${uploader_uptime},| ${uploader_restarts},|" | column -t -s ','

  fi
}

echo_help() {
  echo "
      Usage: zebrunner-farm <command> [devices...] [-x|--exclude <devices>]... [-q|--quiet] [--batch|--rolling] [--json]
      Commands:
          status [devices]     The containers of the devices; --json: as a JSON array for the monitoring
          start [devices]      Create (or start) and run the containers of the devices
          stop [devices]       Stop and keep the containers of the devices
          restart [devices]    Remove and create again the containers of the devices: --batch (default) removes
                               the containers of all of them, then creates them; --rolling device by device
          down [devices]       Stop and remove the containers of the devices
          ansible ['devices']  Run ansible-playbook script with custom or predefined args
          version              Show version of MCloud Agent components
      Devices: udid or name of a whitelisted device, a group: ios, android, usb, wireless, android-sim, ios-sim,
      proxy, or a pattern of the udids, names and locations in quotes ('Samsung_*'); several ones separated by spaces
      or commas. All whitelisted devices are used if the devices are omitted.
          -x, -e, --exclude <devices>  Skip these devices, may be repeated (also -x=<devices>)
          -q, --quiet              No list of the devices and no question
      In a terminal start, stop, restart and down of a group of devices show the devices first and ask to run the
      command, to cancel, to filter the list (f) or to exclude devices (x) by their numbers, udids, names, groups or
      patterns."
  echo_telegram
  exit 0
}

# check_devices_list: mcloud-devices.txt of an earlier version (positional fields) needs the deploy of this version
check_devices_list() {
  if grep -v '^#' "$MCLOUD_DEVICES" 2> /dev/null | grep -q . && ! grep -Eq '(^|[|])id=' "$MCLOUD_DEVICES"; then
    failed "The devices list ${MCLOUD_DEVICES} is of an earlier version: deploy it with ./zebrunner.sh ansible"
    return 1
  fi
}

# farm_command <command> <arguments...>: the command for the devices of the arguments
farm_command() {
  local command="$1"
  shift
  # status --json: the JSON only on stdout, the messages on stderr
  local messages=1
  [[ " $* " == *" --json "* ]] && messages=2
  {
    check_devices_list || return 1
    parse_selection "$@" || return 1
    if [[ -n "$OUTPUT_JSON" && "$command" != "status" ]]; then
      failed "--json is an option of status only"
      return 1
    fi
    select_devices || return 1
  } >&"$messages"
  if [[ "$command" == "status" ]]; then
    if [[ -n "$OUTPUT_JSON" ]]; then
      status_json
    else
      run_selected status
    fi
    return
  fi
  if ! confirm_selection "$command"; then
    echo "Cancelled."
    return 0
  fi
  with_device_lock "$(single_device)" run_command "$command"
}

# run_command <command>: the command for SELECTED, the docker network first for the new containers
run_command() {
  if [[ "$1" != "start" ]] && listener_applies; then
    launchctl unload "${HOME}/Library/LaunchAgents/ZebrunnerDevicesListener.plist" > /dev/null 2>&1
  fi
  if [[ "$1" == "start" || "$1" == "restart" ]]; then
    ensure_network
  fi
  if [[ "$1" == "restart" ]]; then
    restart_selected
  else
    run_selected "$1"
  fi
  # the listener is loaded after the last container, otherwise it starts the devices in parallel
  if [[ "$1" == "start" || "$1" == "restart" ]] && listener_applies; then
    launchctl load "${HOME}/Library/LaunchAgents/ZebrunnerDevicesListener.plist" > /dev/null 2>&1
  fi
}

main() {
  case "$1" in
  status | start | stop | restart | down)
    farm_command "$@"
    ;;
  ansible)
    "${ZEBRUNNER_MCLOUD_AGENT_DIR}"/zebrunner.sh ansible "${@:2}"
    ;;
  version)
    "${ZEBRUNNER_MCLOUD_AGENT_DIR}"/zebrunner.sh version
    ;;
  *)
    echo_help
    ;;
  esac
}

main "$@"
