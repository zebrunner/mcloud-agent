    "${UPLOADER_IMAGE}:${UPLOADER_VERSION}" || return 1
}

#### Output

# The output of the commands (CONVENTIONS.md#terminal-output): a title per device, a line per container with the action
# first and the full name of the container. Without a terminal (udev, systemd, launchd, scripts: their logs) the text
# is plain (`   ok   created  device-...`), a message is one line whatever its length, nothing is asked and nothing
# spins.

# the status of a device of start (and of the start of restart) that is skipped: a USB device that is not plugged in
SKIPPED=3
# true when a container of the device failed (container_line): the stop and the removal of the others go on
DEVICE_FAILED=""

# farm_status <ok|info|warn|fail> <message> [<fix>]: ui_status; wrapped to the width at a terminal only, a log keeps a
# message on one line for grep
farm_status() {
  if [[ "$UI_TTY" -eq 1 ]]; then
    ui_status "$@"
    return
  fi
  # the width of ui_status of this call
  # shellcheck disable=SC2034
  local UI_WIDTH=1000
  ui_status "$@"
}

# container_line <ok|info|warn|fail> <action> <name> [<detail>] [<fix>]: the line of a container (or of the volume of
# the logs): the action aligned and the full name (docker logs <name>); the detail (e.g. the short id) muted when it
# fits, the error of docker after the name of a failure, which marks the device as failed (DEVICE_FAILED)
container_line() {
  local kind="$1"
  local name="$3"
  local detail="${4:-}"
  local text
  text="$(ui_pad "$2" 7) ${name}"
  if [[ "$kind" == "fail" ]]; then
    DEVICE_FAILED="true"
    [[ -z "$detail" ]] || text+=": ${detail}"
  elif [[ -n "$detail" ]]; then
    if [[ "$UI_TTY" -ne 1 || $((${#text} + 2 + ${#detail} + ${#UI_MUTED} + ${#UI_RESET})) -le $((UI_WIDTH - 6)) ]]; then
      text+="  ${UI_MUTED}${detail}${UI_RESET}"
    fi
  fi
  farm_status "$kind" "$text" "${5:-}"
}

# the output of the last docker_spin: stdout and stderr of its command
SPIN_OUTPUT=""

# docker_spin <message> <command...>: the command with its output in SPIN_OUTPUT, its status; at a terminal (not with
# --quiet) a spinner and the message meanwhile, the line is cleared after it. The command runs in the background with
# the environment of the caller: the secrets of ensure_container are in it, not in its arguments
docker_spin() {
  local message="$1"
  shift
  local file
  if [[ "$UI_TTY" -ne 1 || -n "$QUIET" || ! -t 1 ]] || ! file="$(mktemp 2> /dev/null)"; then
    SPIN_OUTPUT="$("$@" 2>&1)"
    return
  fi
  local frames
  local i=0
  local pid
  local status
  read -r -a frames <<< "$UI_SPINNER"
  message="${message:0:$((UI_WIDTH - 2))}"
  "$@" > "$file" 2>&1 &
  pid=$!
  # Ctrl-C: the line and the file of the output are cleaned, docker finishes the change
  # shellcheck disable=SC2064
  trap "printf '\r\033[K'; rm -f '${file}'; exit 130" INT TERM
  while kill -0 "$pid" 2> /dev/null; do
    printf '\r\033[K   %s%s%s %s' "$UI_ACCENT" "${frames[$((i % ${#frames[@]}))]}" "$UI_RESET" "$message"
    i=$((i + 1))
    sleep 0.1
  done
  wait "$pid"
  status=$?
  trap - INT TERM
  printf '\r\033[K'
  SPIN_OUTPUT="$(cat "$file")"
  rm -f "$file"
  return "$status"
}

# device_header [<counter>]: the title of the device of get_device_fields: a pointer, its name as it is (the selector of
# the commands), its platform, connection and udid muted, a thin line and the counter (e.g. 2/5) at the right
device_header() {
  local counter="${1:-}"
  local facts="${dev_platform_name} ${UI_SEP} ${dev_connection} ${UI_SEP} ${dev_udid}"
  local line=$((UI_WIDTH - 5 - ${#dev_device_name} - ${#facts}))
  if [[ -n "$counter" ]]; then
    line=$((line - 1 - ${#counter}))
  fi
  [[ "$line" -ge 3 ]] || line=3
  # an empty line before it, one only after a section
  [[ "$UI_BLANK" -eq 1 ]] || printf '\n'
  printf '  %s%s%s %s%s%s  %s%s%s %s%s%s' "$UI_ACCENT" "$UI_POINTER" "$UI_RESET" "$UI_BOLD" "$dev_device_name" \
    "$UI_RESET" "$UI_MUTED" "$facts" "$UI_RESET" "$UI_DARK" "$(ui_repeat "$UI_THIN" "$line")" "$UI_RESET"
  if [[ -n "$counter" ]]; then
    printf ' %s%s%s' "$UI_MUTED" "$counter" "$UI_RESET"
  fi
  printf '\n'
  UI_BLANK=0
}

# farm_text <text>: a paragraph of a help without the empty line after it
farm_text() {
  ui_hang "  " 2 "$1" "$UI_WIDTH"
}

# farm_muted <text>: ui_muted of the text wrapped to the width at a terminal, on one line in a log
farm_muted() {
  local line
  local width="$UI_WIDTH"
  [[ "$UI_TTY" -eq 1 ]] || width=1000
  while IFS= read -r line; do
    ui_muted "$line"
  done <<< "$(ui_wrap "$1" "$width")"
}

# device_fact <key> <value>: a fact of the device under its title, the key muted
device_fact() {
  local width=$((UI_WIDTH - 11))
  [[ "$UI_TTY" -eq 1 ]] || width=1000
  ui_hang "    ${UI_MUTED}$(ui_pad "$1" 9)${UI_RESET}" 13 "$2" "$width"
}

# human_duration <seconds>: the duration in its two largest units: 40s, 5m 3s, 4h 12m, 2d 4h
human_duration() {
  local seconds="$1"
  if [[ "$seconds" -lt 60 ]]; then
    echo "${seconds}s"
  elif [[ "$seconds" -lt 3600 ]]; then
    echo "$((seconds / 60))m $((seconds % 60))s"
  elif [[ "$seconds" -lt 86400 ]]; then
    echo "$((seconds / 3600))h $((seconds % 3600 / 60))m"
  else
    echo "$((seconds / 86400))d $((seconds % 86400 / 3600))h"
  fi
}

#### Containers

# the states of the containers of the host (`<name> <state>` lines), read before the containers of a device change
CONTAINER_STATES=""
# --dry-run: the states are read once, the containers it would remove are taken out of them
CONTAINER_STATES_READ=""

# read_container_states: CONTAINER_STATES of `docker ps -a`
read_container_states() {
  if [[ -n "${DRY_RUN:-}" && -n "$CONTAINER_STATES_READ" ]]; then
    return 0
  fi
  CONTAINER_STATES="$(docker ps -a --format '{{.Names}} {{.State}}' 2> /dev/null)"
  CONTAINER_STATES_READ="true"
}

# container_state <name>: the state of the container (running, exited, ...), exists when docker gives none, nothing
# when there is no such container
container_state() {
  awk -v name="$1" '$1 == name { print ($2 == "" ? "exists" : $2); exit }' <<< "$CONTAINER_STATES"
}

# ensure_container <name suffix> <-d|-itd> <docker run arguments...>: the container of the device running: kept when it
# runs, started when it exists, created otherwise; one line of what was done (--dry-run: what it would do), fails when
# the container does not run. The secrets are the assignments before its call (`NAME=value ensure_container ... -e
# NAME`), never the arguments
ensure_container() {
  local role="$1"
  local mode="$2"
  shift 2
  local name="${dev_container}-${role}"
  case "$(container_state "$name")" in
  running)
    container_line info running "$name"
    ;;
  "")
    if [[ -n "$DRY_RUN" ]]; then
      container_line info "would create" "$name"
    elif docker_spin "creating  ${name}" docker run "$mode" --name "$name" "$@"; then
      container_line ok created "$name" "$(tail -n 1 <<< "$SPIN_OUTPUT" | cut -c 1-12)"
    else
      container_line fail "NOT created" "$name" "$(tail -n 1 <<< "$SPIN_OUTPUT")" \
        "the cause above, then: zebrunner-farm restart ${dev_device_name}"
      return 1
    fi
    ;;
  *)
    if [[ -n "$DRY_RUN" ]]; then
      container_line info "would start" "$name"
    elif docker_spin "starting  ${name}" docker start "$name"; then
      container_line ok started "$name"
    else
      container_line fail "NOT started" "$name" "$(tail -n 1 <<< "$SPIN_OUTPUT")" \
        "docker logs --tail 50 ${name}, then: zebrunner-farm restart ${dev_device_name}"
      return 1
    fi
    ;;
  esac
}

# the roles of the containers of a device in the order of their creation
ROLES=(connector stf appium uploader)

# the containers of a device in the order of their stop: appium shares the recordings of the active sessions, the
# uploader uploads them, then STF and the connector the others take the device from
STOP_ORDER=(appium uploader stf connector)

# stop_timeout <role>: the seconds docker stop waits for the container before it kills it: appium stops ffmpeg of a
# recording within 30 s, the uploader waits for the uploads up to its FINISH_TIMEOUT (120 s), STF disconnects the device
stop_timeout() {
  case "$1" in
  appium) echo 40 ;;
  uploader) echo 130 ;;
  stf) echo 30 ;;
  *) echo 10 ;;
  esac
}

# stop_containers: the containers of the device stopped and kept, one line per container (--dry-run: what it would do);
# a failed one is reported (DEVICE_FAILED) and the others are stopped anyway
stop_containers() {
  local role
  local name
  [[ -z "$DRY_RUN" ]] || read_container_states
  for role in "${STOP_ORDER[@]}"; do
    name="${dev_container}-${role}"
    if [[ -n "$DRY_RUN" ]]; then
      case "$(container_state "$name")" in
      "") container_line info "no container" "$name" ;;
      running) container_line info "would stop" "$name" ;;
      *) container_line info stopped "$name" ;;
      esac
    elif docker_spin "stopping  ${name}" docker stop -t "$(stop_timeout "$role")" "$name"; then
      container_line ok stopped "$name"
    elif grep -qi "no such container" <<< "$SPIN_OUTPUT"; then
      container_line info "no container" "$name"
    else
      container_line fail "NOT stopped" "$name" "$(tail -n 1 <<< "$SPIN_OUTPUT")" \
        "zebrunner-farm stop ${dev_device_name}"
    fi
  done
  return 0
}

# stop_and_remove <role>: the container of the role of the device stopped as by stop_containers (the stop of no
# container fails, rm reports it), then removed; the output of `docker rm -f`
stop_and_remove() {
  local name="${dev_container}-$1"
  docker stop -t "$(stop_timeout "$1")" "$name" > /dev/null 2>&1
  docker rm -f "$name"
}

# remove_containers: the containers of the device stopped as by stop_containers and removed, then the volume of its
# logs (the uploader has finished with it), one line per container (--dry-run: what it would do); a failed one is
# reported (DEVICE_FAILED) and the others are removed anyway
remove_containers() {
  local role
  local name
  if [[ -n "$DRY_RUN" ]]; then
    read_container_states
    for role in "${STOP_ORDER[@]}"; do
      name="${dev_container}-${role}"
      if [[ -n "$(container_state "$name")" ]]; then
        container_line info "would remove" "$name"
      else
        container_line info "no container" "$name"
      fi
    done
    if docker volume inspect "$dev_container" > /dev/null 2>&1; then
      container_line info "would remove" "$dev_container" "volume of the logs"
    else
      container_line info "no volume" "$dev_container"
    fi
    # the start of restart creates them
    CONTAINER_STATES="$(awk -v prefix="${dev_container}-" 'index($1, prefix) != 1' <<< "$CONTAINER_STATES")"
    return 0
  fi
  for role in "${STOP_ORDER[@]}"; do
    name="${dev_container}-${role}"
    # `docker rm -f` of no container succeeds without output (an error of the older docker versions)
    if docker_spin "removing  ${name}" stop_and_remove "$role" && [[ -n "$SPIN_OUTPUT" ]]; then
      container_line ok removed "$name"
    elif [[ -z "$SPIN_OUTPUT" ]] || grep -qi "no such container" <<< "$SPIN_OUTPUT"; then
      container_line info "no container" "$name"
    else
      container_line fail "NOT removed" "$name" "$(tail -n 1 <<< "$SPIN_OUTPUT")" "docker rm -f ${name}"
    fi
  done
  if docker_spin "removing  ${dev_container}" docker volume rm "$dev_container"; then
    container_line ok removed "$dev_container" "volume of the logs"
  elif grep -qi "no such volume" <<< "$SPIN_OUTPUT"; then
    container_line info "no volume" "$dev_container"
  else
    container_line fail "NOT removed" "$dev_container" "$(tail -n 1 <<< "$SPIN_OUTPUT")" \
      "docker volume rm ${dev_container}"
  fi
  return 0
}

# ensure_network: the docker network of the containers, created when it is missing
ensure_network() {
  if docker network inspect "$STF_DOCKER_NETWORK" > /dev/null 2>&1; then
    return 0
  fi
  if [[ -n "$DRY_RUN" ]]; then
    farm_status info "would create the docker network ${STF_DOCKER_NETWORK}"
  elif docker network create "$STF_DOCKER_NETWORK" > /dev/null; then
    farm_status ok "created the docker network ${STF_DOCKER_NETWORK}"
  else
    farm_status warn "the docker network ${STF_DOCKER_NETWORK} is not created: the containers need it"
  fi
}

#### Device selection

# The devices of a command: the SELECTORS of its arguments (all the devices without them) but the EXCLUDES of -x; QUIET
# (-q) skips the question. SELECTED are their udids in the order of mcloud-devices.txt. RESTART_STRATEGY of restart:
# batch removes the containers of all the devices, then creates them; rolling removes and creates them device by device.
# FARM_COMMAND is the command of zebrunner-farm (empty for ./zebrunner.sh mdm): its options DRY_RUN (--dry-run),
# VERBOSE (-v), WATCH (--watch, the seconds) and PICK (--pick: a person picks the devices with fzf first). REFINED: a
# person narrowed SELECTED at the question (f, x, p) or with --pick: not the group of the selectors any more.
SELECTORS=()
EXCLUDES=()
QUIET=""
SELECTED=()
RESTART_STRATEGY="batch"
FARM_COMMAND=""
DRY_RUN=""
VERBOSE=""
WATCH=""
PICK=""
REFINED=""

# the groups of the devices: the platforms and the connections
GROUPS_LIST=(ios android usb wireless android-sim ios-sim proxy)

# count <values...>: the number of the values; the length expansion of bash cannot be used, a template comment starts
# with its characters
count() {
  echo "$#"
}

# add_selectors <selectors|excludes> <list>: the selectors of a list separated by commas or spaces
add_selectors() {
  local -a items
  local item
  IFS=', ' read -r -a items <<< "$2"
  for item in "${items[@]}"; do
    [[ -n "$item" ]] || continue
    if [[ "$1" == "excludes" ]]; then
      EXCLUDES+=("$item")
    else
      SELECTORS+=("$item")
    fi
  done
}

# farm_option <option>: 0 when the option of zebrunner-farm is one of FARM_COMMAND; otherwise it is reported as an
# unknown option (./zebrunner.sh mdm has none of them) or as an option of other commands
farm_option() {
  local commands
  case "$1" in
  --dry-run) commands="start stop restart down" ;;
  --watch | -v | --verbose) commands="status" ;;
  --pick) commands="status start stop restart down" ;;
  esac
  if [[ -z "$FARM_COMMAND" ]]; then
    farm_status fail "unknown option: $1"
    return 1
  fi
  if [[ " ${commands} " != *" ${FARM_COMMAND} "* ]]; then
    farm_status fail "$1 is an option of ${commands// /, } only"
    return 1
  fi
}

# parse_selection <arguments...>: SELECTORS, EXCLUDES, QUIET and the options of the arguments of a command
parse_selection() {
  SELECTORS=()
  EXCLUDES=()
  QUIET=""
  OUTPUT_JSON=""
  RESTART_STRATEGY="batch"
  DRY_RUN=""
  VERBOSE=""
  WATCH=""
  PICK=""
  REFINED=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --pick)
      farm_option "$1" || return 1
      PICK="true"
      ;;
    -q | --quiet | -y | --yes)
      QUIET="true"
      ;;
    --batch | --rolling)
      RESTART_STRATEGY="${1#--}"
      ;;
    --json)
      OUTPUT_JSON="true"
      ;;
    --dry-run)
      farm_option "$1" || return 1
      DRY_RUN="true"
      ;;
    -v | --verbose)
      farm_option "$1" || return 1
      VERBOSE="true"
      ;;
    --watch | --watch=*)
      farm_option "${1%%=*}" || return 1
      WATCH=5
      if [[ "$1" == --watch=* ]]; then
        WATCH="${1#--watch=}"
      elif [[ "${2:-}" =~ ^[0-9]+$ ]]; then
        WATCH="$2"
        shift
      fi
      if [[ ! "$WATCH" =~ ^[0-9]+$ || "$WATCH" -lt 1 ]]; then
        farm_status fail "--watch takes the seconds between the updates (5 by default)"
        return 1
      fi
      ;;
    --strategy | --strategy=*)
      if [[ "$1" == "--strategy" ]]; then
        RESTART_STRATEGY="$2"
        shift
      else
        RESTART_STRATEGY="${1#--strategy=}"
      fi
      if [[ "$RESTART_STRATEGY" != "batch" && "$RESTART_STRATEGY" != "rolling" ]]; then
        farm_status fail "--strategy is batch or rolling"
        return 1
      fi
      ;;
    -x | -e | --exclude)
      if [[ -z "$2" ]]; then
        farm_status fail "$1 needs the devices to skip"
        return 1
      fi
      add_selectors excludes "$2"
      shift
      ;;
    -x=* | -e=* | --exclude=*)
      add_selectors excludes "${1#*=}"
      ;;
    -*)
      farm_status fail "unknown option: $1"
      return 1
      ;;
    *)
      add_selectors selectors "$1"
      ;;
    esac
    shift
  done
}

# is_exact <selector>: 0 for the udid or the name of a device, 1 for a group or a pattern
is_exact() {
  case "$1" in
  ios | android | usb | wireless | android-sim | ios-sim | proxy | *[*?]*) return 1 ;;
  esac
  return 0
}

# device_matches <selector>: 0 when the device of get_device_fields is the selector: its udid or name, its platform
# (ios, android), its connection (usb, wireless, android-sim, ios-sim, proxy) or a pattern (* and ?) of its udid, name
# or location
device_matches() {
  case "$1" in
  ios | android)
    [[ "$dev_platform_name" == "$1" ]]
    ;;
  usb | wireless | android-sim | ios-sim | proxy)
    [[ "$dev_connection" == "$1" ]]
    ;;
  *[*?]*)
    # the selector is a pattern
    # shellcheck disable=SC2053
    [[ "$dev_udid" == $1 || "$dev_device_name" == $1 || "$dev_location" == $1 ]]
    ;;
  *)
    [[ "$dev_udid" == "$1" || "$dev_device_name" == "$1" ]]
    ;;
  esac
}

# in_selection: 0 when the device of get_device_fields is one of SELECTORS (any device without them) and none of
# EXCLUDES
in_selection() {
  local selector
  local included="true"
  if [[ "$(count "${SELECTORS[@]}")" -gt 0 ]]; then
    included=""
    for selector in "${SELECTORS[@]}"; do
      if device_matches "$selector"; then
        included="true"
        break
      fi
    done
  fi
  [[ -n "$included" ]] || return 1
  for selector in "${EXCLUDES[@]}"; do
    if device_matches "$selector"; then
      return 1
    fi
  done
  return 0
}

# single_device: the udid or the name of the arguments when they select one device exactly, nothing otherwise
single_device() {
  if [[ "$(count "${SELECTORS[@]}")" -eq 1 && "$(count "${EXCLUDES[@]}")" -eq 0 ]] && is_exact "${SELECTORS[0]}"; then
    echo "${SELECTORS[0]}"
  fi
}

# device_words: the names and the udids of the devices list, one per line
device_words() {
  [[ -r "$MCLOUD_DEVICES" ]] || return 0
  awk -F '|' '!/^#/ {
      for (i = 1; i <= NF; i++) if ($i ~ /^(id|name)=./) print substr($i, index($i, "=") + 1)
    }' "$MCLOUD_DEVICES"
}

# closest <word>: the words of stdin at an edit distance of 2 at most from the word, or that start with it (2
# characters at least) or that it starts with, one per line
closest() {
  awk -v word="$1" '
    BEGIN { word = tolower(word) }
    $0 != "" && !seen[$0]++ {
      candidate = tolower($0)
      # the edit distance (Levenshtein) of the word and the candidate
      for (i = 0; i <= length(word); i++) d[i, 0] = i
      for (j = 0; j <= length(candidate); j++) d[0, j] = j
      for (i = 1; i <= length(word); i++) {
        for (j = 1; j <= length(candidate); j++) {
          best = d[i - 1, j] + 1
          if (d[i, j - 1] + 1 < best) best = d[i, j - 1] + 1
          if (d[i - 1, j - 1] + (substr(word, i, 1) != substr(candidate, j, 1)) < best)
            best = d[i - 1, j - 1] + (substr(word, i, 1) != substr(candidate, j, 1))
          d[i, j] = best
        }
      }
      if (d[length(word), length(candidate)] <= 2 || (length(word) >= 2 && index(candidate, word) == 1) ||
        (length(candidate) >= 2 && index(word, candidate) == 1)) print
    }'
}

# did_you_mean <word> <candidates on stdin>: ' (did you mean: a, b?)' of the closest candidates, nothing without them
did_you_mean() {
  local candidates
  candidates="$(closest "$1" | head -n 5 | tr '\n' ',' | sed 's/,$//; s/,/, /g')"
  [[ -z "$candidates" ]] || printf ' (did you mean: %s?)' "$candidates"
}

# device_not_found <selector>: the selector of no device with the closest names, udids and groups
device_not_found() {
  local suggestions
  suggestions="$(device_candidates | did_you_mean "$1")"
  farm_status fail "device not found: ${1}${suggestions}" "zebrunner-farm status lists the devices of this host"
}

# device_candidates: the names and the udids of the devices list and the groups, one per line
device_candidates() {
  device_words
  printf '%s\n' "${GROUPS_LIST[@]}"
}

# select_devices: SELECTED of SELECTORS and EXCLUDES; an udid or a name of no device fails, so does an empty selection
select_devices() {
  local selector
  local line
  SELECTED=()
  for selector in "${SELECTORS[@]}" "${EXCLUDES[@]}"; do
    if is_exact "$selector" && [[ -z "$(device_line "$selector")" ]]; then
      device_not_found "$selector"
      return 1
    fi
  done
  while IFS= read -r line; do
    [[ "|${line}|" =~ \|id=([^|]*)\| ]] || continue
    get_device_fields "${BASH_REMATCH[1]}" > /dev/null || continue
    if in_selection; then
      SELECTED+=("$dev_udid")
    fi
  done < "$MCLOUD_DEVICES"
  if [[ "$(count "${SELECTED[@]}")" -eq 0 ]]; then
    farm_status warn "No device matches: ${SELECTORS[*]:-all devices}${EXCLUDES[*]:+ without ${EXCLUDES[*]}}" \
      "zebrunner-farm status lists the devices of this host"
    return 1
  fi
}

# refine_selection <keep|drop> <list>: SELECTED with only the devices of the list or without them; the list has the
# numbers of print_selection and the selectors, separated by commas or spaces
refine_selection() {
  local mode="$1"
  local -a items
  local -a kept=()
  local item
  local udid
  local hit
  local number=0
  [[ -n "${2//[ ,]/}" ]] || return 0
  IFS=', ' read -r -a items <<< "$2"
  for udid in "${SELECTED[@]}"; do
    number=$((number + 1))
    get_device_fields "$udid" > /dev/null || continue
    hit=""
    for item in "${items[@]}"; do
      if [[ -n "$item" ]] && { [[ "$item" == "$number" ]] || device_matches "$item"; }; then
        hit="true"
        break
      fi
    done
    if [[ "$mode" == "keep" && -n "$hit" ]] || [[ "$mode" == "drop" && -z "$hit" ]]; then
      kept+=("$udid")
    fi
  done
  SELECTED=("${kept[@]}")
  REFINED="true"
}

# can_pick: 0 when a person can pick the devices with fzf: fzf is installed, stdin and stdout are a terminal
can_pick() {
  command -v fzf > /dev/null 2>&1 && [[ -t 0 && -t 1 ]]
}

# pick_devices [one] [<header>]: SELECTED with the devices a person picks with fzf from SELECTED (TAB marks several, one
# picks a single device); fails and keeps SELECTED when it is cancelled (Esc) or nothing is picked
pick_devices() {
  local mode="${1:-}"
  local header="${2:-TAB marks the devices, Enter picks them, Esc goes back}"
  local picked
  local udid
  local line
  local -a kept=()
  local -a multi=(--multi)
  if [[ "$mode" == "one" ]]; then
    multi=()
  fi
  # the udid is the hidden first field: the names, platforms and connections are shown
  picked="$(for udid in "${SELECTED[@]}"; do
    get_device_fields "$udid" > /dev/null || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$dev_udid" "$dev_device_name" "$dev_platform_name" "$dev_connection" "$dev_udid"
  done | fzf ${multi[@]+"${multi[@]}"} --delimiter $'\t' --with-nth 2.. --prompt "devices> " --header "$header")" ||
    return 1
  for udid in "${SELECTED[@]}"; do
    while IFS=$'\t' read -r line _; do
      if [[ "$line" == "$udid" ]]; then
        kept+=("$udid")
        break
      fi
    done <<< "$picked"
  done
  [[ "$(count ${kept[@]+"${kept[@]}"})" -gt 0 ]] || return 1
  SELECTED=("${kept[@]}")
  REFINED="true"
}

# containers_summary: the state of the containers of the device of get_device_fields in CONTAINER_STATES
containers_summary() {
  awk -v prefix="${dev_container}-" '
    index($1, prefix) == 1 && substr($1, length(prefix) + 1) ~ /^(connector|stf|appium|uploader)$/ {
      total++
      if ($2 == "running") running++
    }
    END {
      if (!total) print "none"
      else if (running == total) print "running"
      else if (!running) print "stopped"
      else print running " of " total " running"
    }' <<< "$CONTAINER_STATES"
}

# farm_table <rows...>: the rows, their cells separated by '|', in aligned columns; the first one is the header
farm_table() {
  local line
  local head="true"
  while IFS= read -r line; do
    if [[ -n "$head" ]]; then
      ui_table_head "$line"
      head=""
    else
      printf '%s\n' "$line"
    fi
  done <<< "$(printf '%s\n' "$@" | awk -F '|' '
    {
      for (i = 1; i <= NF; i++) {
        cell[NR, i] = $i
        if (length($i) > width[i]) width[i] = length($i)
      }
      if (NF > columns) columns = NF
    }
    END {
      for (row = 1; row <= NR; row++) {
        line = "   "
        for (i = 1; i < columns; i++) line = line sprintf("%-" (width[i] + 2) "s", cell[row, i])
        print line cell[row, columns]
      }
    }')"
}

# print_selection: the numbered list of SELECTED with the state of their containers
print_selection() {
  local udid
  local number=0
  local rows=("#|NAME|UDID|PLATFORM|CONNECTION|LOCATION|CONTAINERS")
  read_container_states
  for udid in "${SELECTED[@]}"; do
    number=$((number + 1))
    get_device_fields "$udid" > /dev/null || continue
    rows+=("${number}|${dev_device_name}|${dev_udid}|${dev_platform_name}|${dev_connection}|${dev_location:--}|$(containers_summary)")
  done
  farm_table "${rows[@]}"
}

# confirm_selection <command>: shows SELECTED to a person at the terminal, who runs the command for them, filters or
# excludes devices first (or picks them with fzf), or cancels; no question with QUIET, --dry-run, for a single device
# named exactly or without a terminal (udev, launchd, scripts; MCLOUD_FARM_INTERACTIVE=true asks anyway)
confirm_selection() {
  local command="$1"
  local answer
  local value
  if [[ -n "$QUIET" || -n "$(single_device)" || -n "$DRY_RUN" ]] ||
    [[ ! -t 0 && "$MCLOUD_FARM_INTERACTIVE" != "true" ]]; then
    return 0
  fi
  # p: fzf at a terminal
  local pick=""
  if can_pick; then
    pick="true"
  fi
  local hint
  local keys
  while true; do
    printf '\n'
    ui_muted "The devices to ${command} ($(count "${SELECTED[@]}")):"
    print_selection
    printf '\n'
    hint="Y/n/f/x"
    keys="y runs it ${UI_SEP} n cancels ${UI_SEP} f <devices> keeps only them ${UI_SEP} x <devices> excludes them"
    if [[ "$command" == "restart" ]]; then
      farm_muted "Strategy: $(strategy_description)"
      hint+="/s"
      keys+=" ${UI_SEP} s switches the strategy"
    fi
    if [[ -n "$pick" ]]; then
      hint+="/p"
      keys+=" ${UI_SEP} p picks them with fzf"
    fi
    farm_muted "${keys}; <devices>: numbers, udids, names, groups or patterns"
    read -r -p "$(ui_prompt "Run '${command}' for $(count "${SELECTED[@]}") devices?" "[${hint}]")" answer || return 1
    case "$answer" in
    [sS])
      if [[ "$RESTART_STRATEGY" == "batch" ]]; then
        RESTART_STRATEGY="rolling"
      else
        RESTART_STRATEGY="batch"
      fi
      ;;
    "" | [yY] | [yY][eE][sS])
      return 0
      ;;
    [nN] | [nN][oO])
      return 1
      ;;
    [fF] | [fF]" "*)
      value="${answer#?}"
      [[ -n "${value// /}" ]] ||
        read -r -p "$(ui_prompt "Keep the devices" "(numbers, udids, names, patterns, groups)")" value
      refine_selection keep "$value"
      ;;
    [xX] | [xX]" "*)
      value="${answer#?}"
      [[ -n "${value// /}" ]] ||
        read -r -p "$(ui_prompt "Exclude the devices" "(numbers, udids, names, patterns, groups)")" value
      refine_selection drop "$value"
      ;;
    [pP])
      if [[ -n "$pick" ]]; then
        # Esc or nothing picked: the list stays
        pick_devices || true
      else
        ui_warn "p picks the devices with fzf at a terminal: install fzf"
      fi
      ;;
    *)
      ui_warn "Answer y (run), n (cancel), f (keep only some devices) or x (exclude devices)${pick:+, p (pick them)}."
      ;;
    esac
    if [[ "$(count "${SELECTED[@]}")" -eq 0 ]]; then
      ui_warn "No device is left."
      return 1
    fi
  done
}

# strategy_description: RESTART_STRATEGY for a person
strategy_description() {
  if [[ "$RESTART_STRATEGY" == "rolling" ]]; then
    echo "rolling - device by device: its containers are removed and created again at once"
  else
    echo "batch - the containers of all the devices are removed, then all of them are created"
  fi
}

#### Commands of the devices

# the devices of the last run_selected that failed and that were skipped (their names)
FAILED_DEVICES=()
SKIPPED_DEVICES=()

# add_device <failed|skipped> <name>: the name in FAILED_DEVICES or SKIPPED_DEVICES once
add_device() {
  local name
  if [[ "$1" == "failed" ]]; then
    for name in "${FAILED_DEVICES[@]}"; do
      [[ "$name" != "$2" ]] || return 0
    done
    FAILED_DEVICES+=("$2")
  else
    for name in "${SKIPPED_DEVICES[@]}" "${FAILED_DEVICES[@]}"; do
      [[ "$name" != "$2" ]] || return 0
    done
    SKIPPED_DEVICES+=("$2")
  fi
}

# restart_selected: restart of SELECTED by RESTART_STRATEGY
restart_selected() {
  if [[ "$RESTART_STRATEGY" == "rolling" || "$(count "${SELECTED[@]}")" -eq 1 ]]; then
    run_selected restart
    return
  fi
  [[ "$UI_BLANK" -eq 1 ]] || printf '\n'
  ui_muted "Removing the containers of $(count "${SELECTED[@]}") devices (batch restart)"
  run_selected down
  printf '\n'
  ui_muted "Creating the containers of $(count "${SELECTED[@]}") devices again"
  run_selected start
}

# run_selected <command>: the command (start, stop, restart, down) for every device of SELECTED, one at a time with the
# other commands of the device (with_device_lock): its title, then its lines; the failed devices in FAILED_DEVICES,
# the skipped ones in SKIPPED_DEVICES
run_selected() {
  local command="$1"
  local udid
  local status
  local number=0
  local total
  total="$(count "${SELECTED[@]}")"
  for udid in "${SELECTED[@]}"; do
    number=$((number + 1))
    if ! get_device_fields "$udid" > /dev/null; then
      add_device failed "$udid"
      continue
    fi
    if [[ "$total" -gt 1 ]]; then
      device_header "${number}/${total}"
    else
      device_header
    fi
    if [[ "$command" =~ ^(start|restart)$ && "$dev_platform_name" == "ios" ]] && ! start_skipped; then
      device_fact WDA "${dev_device_wda_ipa_path} (${dev_device_wda_bundle_id})"
    fi
    printf '\n'
    status=0
    with_device_lock "$dev_udid" "${command}_device" || status=$?
    # Ctrl-C in the subshell of the lock (Linux): the trap of docker_spin exits it with 130, bash goes on after a child
    # that handled SIGINT itself: the whole run stops, as without the spinner
    if [[ "$status" -eq 130 ]]; then
      exit 130
    fi
    if [[ "$status" -eq "$SKIPPED" ]]; then
      add_device skipped "$dev_device_name"
    elif [[ "$status" -ne 0 ]]; then
      add_device failed "$dev_device_name"
    fi
  done
}

# stop_device: the containers of the device stopped; fails when one of them failed
stop_device() {
  DEVICE_FAILED=""
  stop_containers
  [[ -z "$DEVICE_FAILED" ]]
}

# down_device: the containers of the device removed; fails when one of them failed
down_device() {
  DEVICE_FAILED=""
  remove_containers
  [[ -z "$DEVICE_FAILED" ]]
}

# restart_device: the containers of the device removed and created again; fails when one of them failed, SKIPPED as
# start_device
restart_device() {
  DEVICE_FAILED=""
  remove_containers
  local removed="$DEVICE_FAILED"
  start_device
  local status=$?
  [[ -z "$removed" ]] || return 1
  return "$status"
}

# start_skipped: 0 when start skips the device of get_device_fields: on Linux a USB device that is not plugged in (no
# symlink of udev) unless the device is named exactly
start_skipped() {
  [[ "$FARM_OS" != "macos" && -z "$(single_device)" && "$dev_connection" == "usb" && ! -L "/dev/${dev_container}" ]]
}

# start_device: the containers of the device of get_device_fields created and running; fails when one of them failed;
# SKIPPED for a device of start_skipped
start_device() {
  if start_skipped; then
    farm_status info "not plugged in: skipped, udev starts it when it is connected"
    return "$SKIPPED"
  fi
  DEVICE_FAILED=""
  create_containers || return 1
  [[ -z "$DEVICE_FAILED" ]]
}

# listener_applies: 0 when the command is for the iOS devices of macOS as a group (all the devices or ios): the
# devices listener handles the USB iOS devices, stop and down unload it, start loads it
listener_applies() {
  [[ "$FARM_OS" == "macos" ]] || return 1
  # some devices of the group picked by a person: the listener keeps the other iOS devices
  [[ -z "$REFINED" ]] || return 1
  local selector
  [[ "$(count "${SELECTORS[@]}")" -eq 0 ]] && return 0
  for selector in "${SELECTORS[@]}"; do
    [[ "$selector" == "ios" ]] && return 0
  done
  return 1
}

# devices_listener <load|unload>: the devices listener of macOS loaded or unloaded (--dry-run: what it would do)
devices_listener() {
  if [[ -n "$DRY_RUN" ]]; then
    farm_status info "would $1 the devices listener"
    return 0
  fi
  launchctl "$1" "${HOME}/Library/LaunchAgents/ZebrunnerDevicesListener.plist" > /dev/null 2>&1
}

# run_command <command>: the command for SELECTED, the docker network first for the new containers; a group has a
# title and a summary; fails when a device failed (not with --dry-run)
run_command() {
  local command="$1"
  local start="$SECONDS"
  local total
  total="$(count "${SELECTED[@]}")"
  FAILED_DEVICES=()
  SKIPPED_DEVICES=()
  if [[ "$total" -gt 1 ]]; then
    local detail="${total} devices"
    [[ "$command" != "restart" ]] || detail+=" ${UI_SEP} ${RESTART_STRATEGY}"
    [[ -z "$DRY_RUN" ]] || detail+=" ${UI_SEP} dry run"
    ui_section "$command" "$detail"
  fi
  if [[ "$command" != "start" ]] && listener_applies; then
    devices_listener unload
  fi
  if [[ "$command" == "start" || "$command" == "restart" ]]; then
    ensure_network
  fi
  if [[ "$command" == "restart" ]]; then
    restart_selected
  else
    run_selected "$command"
  fi
  # the listener is loaded after the last container, otherwise it starts the devices in parallel
  if [[ "$command" == "start" || "$command" == "restart" ]] && listener_applies; then
    devices_listener load
  fi
  local failed
  failed="$(count "${FAILED_DEVICES[@]}")"
  if [[ "$total" -gt 1 ]]; then
    local skipped
    skipped="$(count "${SKIPPED_DEVICES[@]}")"
    ui_summary $((total - failed - skipped)) "$skipped" "$failed"
    if [[ "$failed" -gt 0 ]]; then
      ui_muted "failed: ${FAILED_DEVICES[*]} ${UI_SEP} done in $(human_duration $((SECONDS - start)))"
      ui_muted "retry: zebrunner-farm ${command} ${FAILED_DEVICES[*]}"
    else
      ui_muted "${total} devices ${UI_SEP} done in $(human_duration $((SECONDS - start)))"
    fi
  fi
  if [[ -n "$DRY_RUN" ]]; then
    printf '\n'
    ui_muted "--dry-run: nothing was changed"
    return 0
  fi
  [[ "$failed" -eq 0 ]]
}

#### Status

# epoch <docker time>: the seconds of a time of docker inspect (UTC), 0 for the zero time of a container never finished
epoch() {
  if [[ "$FARM_OS" != "macos" ]]; then
    date -d "$1" "+%s"
  elif [[ "$1" == 0001-01-01T00:00:00* ]]; then
    echo 0
  else
    TZ=UTC date -j -f "%Y-%m-%dT%H:%M:%S" "${1%%.*}" "+%s"
  fi
}

# json_string <value>: the value as a JSON string
json_string() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\t'/\\t}"
  value="${value//$'\n'/\\n}"
  printf '"%s"' "$value"
}

# container_json <container>: the state of the container as a JSON object: {"exists": false} without it
container_json() {
  local info
  if ! info="$(docker inspect --format '{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}|{{.State.StartedAt}}|{{.RestartCount}}' "$1" 2> /dev/null)" ||
    [[ -z "$info" ]]; then
    printf '{"exists": false}'
    return 0
  fi
  local status health started restarts
  IFS='|' read -r status health started restarts <<< "$info"
  local uptime="null"
  local started_epoch
  if [[ "$status" == "running" ]]; then
    started_epoch="$(epoch "$started" 2> /dev/null)"
    [[ "$started_epoch" =~ ^[0-9]+$ ]] && uptime="$(($(date "+%s") - started_epoch))"
  fi
  [[ "$restarts" =~ ^[0-9]+$ ]] || restarts="null"
  if [[ -n "$health" ]]; then
    health="$(json_string "$health")"
  else
    health="null"
  fi
  printf '{"exists": true, "status": %s, "health": %s, "started_at": %s, "uptime_seconds": %s, "restarts": %s}' \
    "$(json_string "$status")" "$health" "$(json_string "$started")" "$uptime" "$restarts"
}

# status_json: the devices of SELECTED and their containers as a JSON array, one device per line (README.md#devices-management)
status_json() {
  local udid
  local separator=""
  local plugged_in
  echo "["
  for udid in "${SELECTED[@]}"; do
    get_device_fields "$udid" > /dev/null 2>&1 || continue
    plugged_in="null"
    if [[ "$dev_connection" == "usb" ]]; then
      plugged_in="false"
      usb_present > /dev/null 2>&1 && plugged_in="true"
    fi
    printf '%s{"id": %s, "name": %s, "os": %s, "connection": %s, "location": %s, "plugged_in": %s, "containers": {' \
      "$separator" "$(json_string "$dev_udid")" "$(json_string "$dev_device_name")" "$(json_string "$dev_platform_name")" \
      "$(json_string "$dev_connection")" "$(json_string "$dev_location")" "$plugged_in"
    printf '"connector": %s, "stf": %s, "appium": %s, "uploader": %s}}' "$(container_json "${dev_container}-connector")" \
      "$(container_json "${dev_container}-stf")" "$(container_json "${dev_container}-appium")" \
      "$(container_json "${dev_container}-uploader")"
    separator=$',\n'
  done
  printf '\n]\n'
}

# the details of the containers of SELECTED of one docker inspect: `/<name>|<status>|<health>|<started>|<restarts>|<exit
# code>` lines
CONTAINER_DETAILS=""

# read_container_details: CONTAINER_STATES and CONTAINER_DETAILS of the existing containers of SELECTED
read_container_details() {
  local udid
  local role
  local names=()
  read_container_states
  for udid in "${SELECTED[@]}"; do
    get_device_fields "$udid" > /dev/null 2>&1 || continue
    for role in "${ROLES[@]}"; do
      [[ -z "$(container_state "${dev_container}-${role}")" ]] || names+=("${dev_container}-${role}")
    done
  done
  CONTAINER_DETAILS=""
  if [[ "$(count "${names[@]}")" -gt 0 ]]; then
    CONTAINER_DETAILS="$(docker inspect --format \
      '{{.Name}}|{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{end}}|{{.State.StartedAt}}|{{.RestartCount}}|{{.State.ExitCode}}' \
      "${names[@]}" 2> /dev/null)"
  fi
}

# container_detail <name>: cd_status (nothing without the container), cd_health, cd_up (the seconds since its start of a
# running one, nothing otherwise), cd_restarts and cd_exit of the container in CONTAINER_DETAILS
container_detail() {
  local line
  local started
  local started_epoch
  line="$(awk -F '|' -v name="/$1" '$1 == name { print; exit }' <<< "$CONTAINER_DETAILS")"
  IFS='|' read -r _ cd_status cd_health started cd_restarts cd_exit <<< "$line"
  [[ -n "$line" ]] || cd_status="$(container_state "$1")"
  [[ "$cd_restarts" =~ ^[0-9]+$ ]] || cd_restarts=0
  cd_up=""
  if [[ "$cd_status" == "running" ]]; then
    started_epoch="$(epoch "$started" 2> /dev/null)"
    if [[ "$started_epoch" =~ ^[0-9]+$ && "$started_epoch" -gt 0 ]]; then
      cd_up=$(($(date "+%s") - started_epoch))
      [[ "$cd_up" -ge 0 ]] || cd_up=0
    fi
  fi
}

# state_kind <status> <health>: the kind of the state of a container: ok (running, healthy or without a health check),
# warn (starting, unhealthy, restarting, paused), fail (exited, dead, created and not started), none (no container)
state_kind() {
  case "$1" in
  "") echo none ;;
  running)
    case "$2" in
    starting | unhealthy) echo warn ;;
    *) echo ok ;;
    esac
    ;;
  exited | dead | created) echo fail ;;
  *) echo warn ;;
  esac
}

# state_mark <kind>: the mark of a container of the table of status: a colored dot, without colors a letter: R running,
# S starting or unhealthy, X exited, - no container
state_mark() {
  if [[ "$UI_COLOR_ON" -eq 1 ]]; then
    case "$1" in
    ok) printf '%s%s%s' "$UI_OK" "$UI_DOT" "$UI_RESET" ;;
    warn) printf '%s%s%s' "$UI_WARN" "$UI_DOT" "$UI_RESET" ;;
    fail) printf '%s%s%s' "$UI_FAIL" "$UI_DOT" "$UI_RESET" ;;
    *) printf '%s%s%s' "$UI_MUTED" "$UI_DOT" "$UI_RESET" ;;
    esac
    return
  fi
  case "$1" in
  ok) printf 'R' ;;
  warn) printf 'S' ;;
  fail) printf 'X' ;;
  *) printf '%s' '-' ;;
  esac
}

# disconnected: 0 when the device of get_device_fields is a USB device that is not plugged in
disconnected() {
  [[ "$dev_connection" == "usb" ]] && ! usb_present > /dev/null 2>&1
}

# status_device: the containers of the device of get_device_fields, one line per container: its state, health, uptime
# and full name; the fix of a container that restarted, is unhealthy or exited
status_device() {
  if disconnected; then
    farm_status warn "disconnected: the USB device is not plugged in"
    return 0
  fi
  local role
  local name
  local kind
  local fix
  local text
  for role in "${ROLES[@]}"; do
    name="${dev_container}-${role}"
    container_detail "$name"
    kind="$(state_kind "$cd_status" "$cd_health")"
    if [[ "$kind" == "none" ]]; then
      container_line info "no container" "$name"
      continue
    fi
    text="$(ui_pad "$cd_status" 9)$(ui_pad "${cd_health:--}" 11)"
    if [[ -n "$cd_up" ]]; then
      text+="$(ui_pad "up $(human_duration "$cd_up")" 11)"
    elif [[ -n "$cd_exit" && "$cd_status" != "running" ]]; then
      text+="$(ui_pad "code ${cd_exit}" 11)"
    else
      text+="$(ui_pad "-" 11)"
    fi
    text+="$name"
    fix=""
    if [[ "$kind" == "fail" ]]; then
      fix="docker logs --tail 50 ${name}, then: zebrunner-farm restart ${dev_device_name}"
    elif [[ "$cd_restarts" -gt 0 || "$cd_health" == "unhealthy" || "$cd_status" != "running" ]]; then
      kind="warn"
      fix="docker logs --tail 50 ${name}"
      [[ "$cd_restarts" -eq 0 ]] || fix="${cd_restarts} restarts: ${fix}"
    elif [[ "$cd_health" == "starting" ]]; then
      kind="info"
    fi
    farm_status "$kind" "$text" "$fix"
  done
}

# status_row <name width> <platform width> <connection width>: the row of the device of get_device_fields in the table
# of status: a mark per container (connector, stf, appium, uploader), the uptime of appium (or of the oldest running
# container), the restarts and the container that has them, or the first container that exited
status_row() {
  local head
  head="   $(ui_pad "$dev_device_name" "$1")$(ui_pad "$dev_platform_name" "$2")$(ui_pad "$dev_connection" "$3")"
  if disconnected; then
    printf '%s%sdisconnected%s\n' "$head" "$UI_MUTED" "$UI_RESET"
    return
  fi
  local role
  local kind
  local marks=""
  local up=""
  local oldest=""
  local restarts=0
  local restarted=""
  local note=""
  for role in "${ROLES[@]}"; do
    container_detail "${dev_container}-${role}"
    kind="$(state_kind "$cd_status" "$cd_health")"
    marks+="$(state_mark "$kind") "
    if [[ -n "$cd_up" ]]; then
      [[ "$role" != "appium" ]] || up="$cd_up"
      [[ -n "$oldest" && "$oldest" -ge "$cd_up" ]] || oldest="$cd_up"
    fi
    if [[ "$cd_restarts" -gt 0 ]]; then
      restarts=$((restarts + cd_restarts))
      restarted+="${restarted:+,}${role}"
    fi
    if [[ "$kind" == "fail" && -z "$note" ]]; then
      note="${role} ${cd_status}${cd_exit:+ (${cd_exit})}"
    fi
  done
  up="${up:-$oldest}"
  if [[ -n "$up" ]]; then
    up="$(human_duration "$up")"
  fi
  local last="0"
  if [[ -n "$note" ]]; then
    last="${UI_FAIL}${note}${UI_RESET}"
  elif [[ "$restarts" -gt 0 ]]; then
    last="${UI_WARN}${restarts} ${restarted}${UI_RESET}"
  fi
  printf '%s%s %s%s\n' "$head" "$marks" "$(ui_pad "${up:--}" 10)" "$last"
}

# status_table: SELECTED as a table of status, a row per device, and the legend of its marks
status_table() {
  local udid
  local name_width=6
  local platform_width=8
  local connection_width=10
  for udid in "${SELECTED[@]}"; do
    get_device_fields "$udid" > /dev/null 2>&1 || continue
    [[ "${#dev_device_name}" -le "$name_width" ]] || name_width="${#dev_device_name}"
    [[ "${#dev_platform_name}" -le "$platform_width" ]] || platform_width="${#dev_platform_name}"
    [[ "${#dev_connection}" -le "$connection_width" ]] || connection_width="${#dev_connection}"
  done
  name_width=$((name_width + 2))
  platform_width=$((platform_width + 2))
  connection_width=$((connection_width + 2))
  ui_table_head "   $(ui_pad DEVICE "$name_width")$(ui_pad PLATFORM "$platform_width")$(ui_pad CONNECTION \
    "$connection_width")$(ui_pad "C S A U" 9)$(ui_pad UPTIME 10)RESTARTS"
  for udid in "${SELECTED[@]}"; do
    get_device_fields "$udid" > /dev/null 2>&1 || continue
    status_row "$name_width" "$platform_width" "$connection_width"
  done
  printf '\n'
  if [[ "$UI_COLOR_ON" -eq 1 ]]; then
    printf '  %s running  %s starting, unhealthy  %s exited  %s no container\n' "$(state_mark ok)" \
      "$(state_mark warn)" "$(state_mark fail)" "$(state_mark none)"
  else
    farm_muted "R running; S starting, unhealthy, restarting; X exited, dead; - no container"
  fi
  farm_muted "C connector ${UI_SEP} S stf ${UI_SEP} A appium ${UI_SEP} U uploader ${UI_SEP} zebrunner-farm status <device>: its containers"
}

# status_selected: the status of SELECTED: the table of a group, the containers of one device (of every one with -v)
status_selected() {
  local total
  local udid
  local number=0
  total="$(count "${SELECTED[@]}")"
  read_container_details
  if [[ "$total" -gt 1 ]]; then
    ui_section "status" "${total} devices"
    if [[ -z "$VERBOSE" ]]; then
      status_table
      return 0
    fi
  fi
  for udid in "${SELECTED[@]}"; do
    number=$((number + 1))
    get_device_fields "$udid" > /dev/null 2>&1 || continue
    if [[ "$total" -gt 1 ]]; then
      device_header "${number}/${total}"
    else
      device_header
    fi
    printf '\n'
    status_device
  done
  return 0
}

# status_watch: status_selected again every WATCH seconds at a terminal until Ctrl-C
status_watch() {
  local screen
  trap 'printf "\n"; exit 0' INT
  while true; do
    screen="$(status_selected)"
    printf '\033[H\033[2J'
    ui_muted "zebrunner-farm status ${UI_SEP} every ${WATCH}s ${UI_SEP} $(date '+%H:%M:%S') ${UI_SEP} Ctrl-C quits"
    printf '%s\n' "$screen"
    sleep "$WATCH"
  done
}

