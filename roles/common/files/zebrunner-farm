# valid_role <role>: 0 for a role of the containers of a device
valid_role() {
  local role
  for role in "${ROLES[@]}"; do
    [[ "$role" != "$1" ]] || return 0
  done
  return 1
}

# one_device <selector>: the device of get_device_fields of a selector of one device; a selector of no device or of
# several fails with the devices
one_device() {
  SELECTORS=("$1")
  EXCLUDES=()
  select_devices || return 1
  if [[ "$(count "${SELECTED[@]}")" -gt 1 ]]; then
    local udid
    local names=()
    for udid in "${SELECTED[@]}"; do
      get_device_fields "$udid" > /dev/null 2>&1 && names+=("$dev_device_name")
    done
    farm_status fail "$1 is $(count "${SELECTED[@]}") devices: ${names[*]}" \
      "one of them: zebrunner-farm ${FARM_COMMAND} ${names[0]}"
    return 1
  fi
  get_device_fields "${SELECTED[0]}" > /dev/null
}

# usage_error <command> <message>: a wrong use of the command, its usage after it; the status 2
usage_error() {
  {
    ui_callout error "$2"
    ui_usage "$(command_usage "$1")"
    ui_muted "zebrunner-farm help $1: its options and examples"
  } >&2
  return 2
}

# debug_command <logs|shell|exec> <arguments...>: docker logs, a shell or a command in a container of one device; the
# device is picked with fzf with --pick (in its place) or for logs and shell without one when a person can pick it
debug_command() {
  local command="$1"
  shift
  local device=""
  local role=""
  local pick=""
  local follow=""
  local tail=200
  local cmd=()
  while [[ $# -gt 0 ]]; do
    if [[ "$command" == "exec" && -n "$role" ]]; then
      cmd=("$@")
      break
    fi
    case "$1" in
    --pick)
      pick="true"
      ;;
    -f | --follow)
      [[ "$command" == "logs" ]] || {
        usage_error "$command" "unknown option: $1"
        return
      }
      follow="true"
      ;;
    --tail | --tail=*)
      [[ "$command" == "logs" ]] || {
        usage_error "$command" "unknown option: $1"
        return
      }
      if [[ "$1" == "--tail" ]]; then
        tail="${2:-}"
        shift
      else
        tail="${1#--tail=}"
      fi
      [[ "$tail" =~ ^([0-9]+|all)$ ]] || {
        usage_error "$command" "--tail takes the number of the lines (or all)"
        return
      }
      ;;
    -*)
      usage_error "$command" "unknown option: $1"
      return
      ;;
    *)
      if [[ -z "$device" && -z "$pick" ]]; then
        device="$1"
      elif [[ -z "$role" ]]; then
        role="$1"
      else
        usage_error "$command" "too many arguments: $1"
        return
      fi
      ;;
    esac
    shift
  done
  # can_pick here: in a command substitution its stdout is no terminal
  local pickable=""
  if can_pick; then
    pickable="true"
  fi
  # --pick after the role of logs or shell (logs stf --pick): the word is the role
  if [[ -n "$pick" && -n "$device" ]]; then
    if [[ -z "$role" && "$command" != "exec" ]]; then
      role="$device"
      device=""
    else
      usage_error "$command" "--pick takes the place of the device: $(command_usage "$command" | sed 's/<device|--pick>/--pick/')"
      return
    fi
  fi
  # a person picks the device of logs and shell without one; exec asks for --pick (its words are a role and a command)
  if [[ -z "$device" && -z "$pick" && ("$command" == "exec" || -z "$pickable") ]]; then
    usage_error "$command" "${command} needs a device: its name or udid${pickable:+, or --pick to pick it with fzf}"
    return
  fi
  if [[ "$command" == "exec" ]]; then
    [[ -n "$role" && "$(count ${cmd[@]+"${cmd[@]}"})" -gt 0 ]] || {
      usage_error "$command" "exec needs a device (or --pick), a role (${ROLES[*]}) and a command"
      return
    }
  fi
  role="${role:-appium}"
  valid_role "$role" || {
    usage_error "$command" "unknown role: ${role}$(printf '%s\n' "${ROLES[@]}" | did_you_mean "$role"); the roles: ${ROLES[*]}"
    return
  }
  check_devices_list || return 1
  if [[ -z "$device" ]]; then
    if [[ -z "$pickable" ]]; then
      farm_status fail "--pick needs fzf at a terminal" "install fzf, or name the device: $(command_usage "$command")"
      return 1
    fi
    SELECTORS=()
    EXCLUDES=()
    select_devices || return 1
    if ! pick_devices one "Enter picks the device for ${command} ${role}, Esc cancels"; then
      ui_info "Cancelled."
      return 0
    fi
    device="${SELECTED[0]}"
  fi
  one_device "$device" || return 1
  local name="${dev_container}-${role}"
  read_container_states
  if [[ -z "$(container_state "$name")" ]]; then
    farm_status fail "no container ${name}" "zebrunner-farm start ${dev_device_name}"
    return 1
  fi
  case "$command" in
  logs)
    if [[ -n "$follow" ]]; then
      exec docker logs --follow --tail "$tail" "$name"
    fi
    exec docker logs --tail "$tail" "$name"
    ;;
  shell)
    local flags="-i"
    [[ ! -t 0 ]] || flags="-it"
    # bash when the image has it
    # shellcheck disable=SC2016
    exec docker exec "$flags" "$name" sh -c 'if command -v bash > /dev/null 2>&1; then exec bash; fi; exec sh'
    ;;
  *)
    # a pseudo-terminal only for a terminal on both sides: with it the output of a redirect or a pipe gets CRLF and
    # stderr (a screenshot of adb exec-out is broken); -i passes a piped stdin to the command
    if [[ -t 0 && -t 1 ]]; then
      exec docker exec -it "$name" "${cmd[@]}"
    fi
    exec docker exec -i "$name" "${cmd[@]}"
    ;;
  esac
}

