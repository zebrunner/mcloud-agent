    ui_usage "zebrunner-farm <command> [devices...] [options]"
    ui_muted "zebrunner-farm help: the commands"
  } >&2
  return 2
}

# farm_complete <index> <words...>: the candidates of the word of the index of the words of the command line, one per
# line (CONVENTIONS.md#completion); nothing else runs: no docker, no file written
farm_complete() {
  local index="$1"
  shift
  [[ "$index" =~ ^[0-9]+$ && "$index" -ge 1 ]] || return 0
  local words=("$@")
  local current="${words[$((index - 1))]:-}"
  local previous=""
  [[ "$index" -lt 2 ]] || previous="${words[$((index - 2))]:-}"
  local command="${words[0]:-}"
  if [[ "$index" -eq 1 ]]; then
    printf '%s\n' "${FARM_COMMANDS[@]}"
    return 0
  fi
  case "$command" in
  help)
    [[ "$index" -ne 2 ]] || printf '%s\n' "${FARM_COMMANDS[@]}"
    ;;
  completion)
    [[ "$index" -ne 2 ]] || printf '%s\n' bash zsh
    ;;
  ansible)
    [[ "$index" -ne 2 ]] || device_candidates
    ;;
  logs | shell | exec)
    [[ "$previous" != "--tail" ]] || return 0
    if [[ "$current" == -* ]]; then
      if [[ "$command" == "logs" ]]; then
        printf '%s\n' --pick -f --follow --tail --help
      else
        printf '%s\n' --pick --help
      fi
      return 0
    fi
    # the place of the word among the arguments that are not options; --pick is the device
    local position=0
    local i=1
    while [[ "$i" -lt $((index - 1)) ]]; do
      case "${words[$i]}" in
      --tail) i=$((i + 1)) ;;
      --pick) position=$((position + 1)) ;;
      -*) ;;
      *) position=$((position + 1)) ;;
      esac
      i=$((i + 1))
    done
    case "$position" in
    0) device_words ;;
    1) printf '%s\n' "${ROLES[@]}" ;;
    esac
    ;;
  status | start | stop | restart | down)
    case "$previous" in
    -x | -e | --exclude)
      device_candidates
      return 0
      ;;
    --strategy)
      printf '%s\n' batch rolling
      return 0
      ;;
    esac
    if [[ "$current" == -* ]]; then
      case "$command" in
      status) printf '%s\n' --json --watch -v --verbose --pick -x -e --exclude --help ;;
      restart) printf '%s\n' -q --quiet --batch --rolling --strategy --dry-run --pick -x -e --exclude --help ;;
      *) printf '%s\n' -q --quiet --dry-run --pick -x -e --exclude --help ;;
      esac
      return 0
    fi
    device_candidates
    ;;
  esac
  return 0
}

# check_devices_list: mcloud-devices.txt of an earlier version (positional fields) needs the deploy of this version
check_devices_list() {
  if grep -v '^#' "$MCLOUD_DEVICES" 2> /dev/null | grep -q . && ! grep -Eq '(^|[|])id=' "$MCLOUD_DEVICES"; then
    farm_status fail "The devices list ${MCLOUD_DEVICES} is of an earlier version: deploy it with ./zebrunner.sh ansible"
    return 1
  fi
}

# farm_command <command> <arguments...>: the command for the devices of the arguments
farm_command() {
  local command="$1"
  shift
  FARM_COMMAND="$command"
  # status --json: the JSON only on stdout, the messages on stderr
  local messages=1
  [[ " $* " == *" --json "* ]] && messages=2
  {
    check_devices_list || return 1
    parse_selection "$@" || return 1
    if [[ -n "$OUTPUT_JSON" && "$command" != "status" ]]; then
      farm_status fail "--json is an option of status only"
      return 1
    fi
    if [[ -n "$OUTPUT_JSON" && -n "$WATCH" ]]; then
      farm_status fail "--watch is for a person at a terminal, --json for the monitoring: one of them"
      return 1
    fi
    if [[ -n "$WATCH" && ! ("$UI_TTY" -eq 1 && -t 1) ]]; then
      farm_status fail "--watch needs a terminal" "zebrunner-farm status without --watch"
      return 1
    fi
    # --pick asks a person: never the devices of the selection without one (udev, launchd, a script, no fzf)
    if [[ -n "$PICK" && (-n "$QUIET" || -n "$OUTPUT_JSON") ]]; then
      farm_status fail "--pick asks a person, $([[ -n "$QUIET" ]] && echo "--quiet asks nobody" || echo "--json is for the monitoring"): one of them"
      return 1
    fi
    if [[ -n "$PICK" ]] && ! can_pick; then
      farm_status fail "--pick needs fzf at a terminal" "install fzf, or name the devices: zebrunner-farm ${command} <devices>"
      return 1
    fi
    select_devices || return 1
  } >&"$messages"
  if [[ -n "$PICK" ]] && ! pick_devices "" "TAB marks the devices, Enter picks them for ${command}, Esc cancels"; then
    ui_info "Cancelled."
    return 0
  fi
  if [[ "$command" == "status" ]]; then
    if [[ -n "$OUTPUT_JSON" ]]; then
      status_json
    elif [[ -n "$WATCH" ]]; then
      status_watch
    else
      status_selected
    fi
    return
  fi
  if ! confirm_selection "$command"; then
    ui_info "Cancelled."
    return 0
  fi
  run_command "$command"
}

main() {
  # the completion first: nothing above it may fail or print
  if [[ "${1:-}" == "__complete" ]]; then
    farm_complete "${@:2}"
    return 0
  fi
  local command="${1:-}"
  local arg
  case "$command" in
  "" | help | -h | --help)
    if [[ "$command" == "help" && -n "${2:-}" ]]; then
      farm_is_command "$2" || {
        farm_unknown_command "$2"
        return
      }
      farm_command_help "$2"
      return 0
    fi
    farm_help
    return 0
    ;;
  ansible | exec | version | completion)
    if [[ "${2:-}" == "-h" || "${2:-}" == "--help" ]]; then
      farm_command_help "$command"
      return 0
    fi
    ;;
  status | start | stop | restart | down | logs | shell)
    for arg in "${@:2}"; do
      if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
        farm_command_help "$command"
        return 0
      fi
    done
    ;;
  esac
  case "$command" in
  status | start | stop | restart | down)
    farm_command "$@"
    ;;
  logs | shell | exec)
    FARM_COMMAND="$command"
    debug_command "$@"
    ;;
  ansible)
    "${ZEBRUNNER_MCLOUD_AGENT_DIR}"/zebrunner.sh ansible "${@:2}"
    ;;
  version)
    "${ZEBRUNNER_MCLOUD_AGENT_DIR}"/zebrunner.sh version
    ;;
  completion)
    case "${2:-}" in
    bash | zsh)
      cat "${ZEBRUNNER_MCLOUD_AGENT_DIR}/patch/completion.sh"
      ;;
    *)
      usage_error completion "completion needs the shell: bash or zsh"
      ;;
    esac
    ;;
  *)
    farm_unknown_command "$command"
    ;;
  esac
}

# ./zebrunner.sh mdm sources this script for its functions (the settings, the selection and the containers of the
# devices): main runs only when the script is run
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
