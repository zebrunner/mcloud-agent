# The settings of zebrunner-farm (README.md#settings): ./zebrunner.sh ansible renders them from config/settings.yml,
# versions.yml and the values by default of the roles; do not change them here. They have the secrets of the host:
# readable by root and the user of the deploy only.
FARM_OS={{ common_farm_os | quote }}
ZEBRUNNER_MCLOUD_AGENT_DIR={{ agent_dir | quote }}
# the scripts zebrunner-farm sources: the copies of the deploy owned by root
ZEBRUNNER_FARM_LIB={{ common_farm_lib_dir | default('/usr/local/lib/zebrunner-farm', true) | quote }}
MCLOUD_DEVICES=/usr/local/bin/mcloud-devices.txt
STF_DOCKER_NETWORK={{ STF_DOCKER_NETWORK | quote }}
DEVICE_NETWORK_ISOLATION={{ DEVICE_NETWORK_ISOLATION | bool | lower }}
DEVICE_NETWORK_SUBNETS={{ DEVICE_NETWORK_SUBNETS | quote }}
CONNECTOR_PEER_FILTER={{ CONNECTOR_PEER_FILTER | default(true) | bool | lower }}
RESTARTS_LIMIT={{ RESTARTS_LIMIT | quote }}
DEVICE_UNAVAILABLE_TIMEOUT={{ ('' if DEVICE_UNAVAILABLE_TIMEOUT is none else DEVICE_UNAVAILABLE_TIMEOUT) | string | quote }}

DEVICE_IMAGE={{ DEVICE_IMAGE | quote }}
DEVICE_VERSION={{ DEVICE_VERSION | quote }}
APPIUM_IMAGE={{ APPIUM_IMAGE | quote }}
APPIUM_VERSION={{ APPIUM_VERSION | quote }}
UPLOADER_IMAGE={{ UPLOADER_IMAGE | quote }}
UPLOADER_VERSION={{ UPLOADER_VERSION | quote }}
IOS_CONNECTOR_IMAGE={{ IOS_CONNECTOR_IMAGE | quote }}
IOS_CONNECTOR_VERSION={{ IOS_CONNECTOR_VERSION | quote }}
ANDROID_CONNECTOR_IMAGE={{ ANDROID_CONNECTOR_IMAGE | quote }}
ANDROID_CONNECTOR_VERSION={{ ANDROID_CONNECTOR_VERSION | quote }}

MCLOUD_NODE_TOKEN={{ MCLOUD_NODE_TOKEN | quote }}
# the MDM of the devices (zebrunner-farm mdm, README.md#mdm): MCloud and the pin of its TLS key of the join, the
# supervision identity of the farm (iOS)
MCLOUD_URL={{ MCLOUD_URL | default('', true) | quote }}
MCLOUD_TLS_PIN={{ MCLOUD_TLS_PIN | default('', true) | quote }}
MDM_SUPERVISION_P12={{ MDM_SUPERVISION_P12 | default('', true) | quote }}
MDM_SUPERVISION_P12_PASSWORD={{ MDM_SUPERVISION_P12_PASSWORD | default('', true) | quote }}
MDM_SUPERVISION_ORG={{ MDM_SUPERVISION_ORG | default('Zebrunner MCloud', true) | quote }}
MDM_WIFI_SSID={{ MDM_WIFI_SSID | default('', true) | quote }}
MDM_WIFI_PASSWORD={{ MDM_WIFI_PASSWORD | default('', true) | quote }}
MDM_WIFI_ENCRYPTION={{ MDM_WIFI_ENCRYPTION | default('Any', true) | quote }}
STF_PROVIDER_HOST={{ STF_PROVIDER_HOST | quote }}
REMOTE_CONNECT_HOST={{ REMOTE_CONNECT_HOST | default('', true) | quote }}
STF_PROVIDER_NAME={{ STF_PROVIDER_NAME | quote }}
PUBLIC_IP={{ PUBLIC_IP | quote }}
PUBLIC_IP_PORT={{ PUBLIC_IP_PORT | quote }}
PUBLIC_IP_PROTOCOL={{ PUBLIC_IP_PROTOCOL | quote }}
STF_PROVIDER_CONNECT_SUB={{ STF_PROVIDER_CONNECT_SUB | quote }}
STF_PROVIDER_CONNECT_PUSH={{ STF_PROVIDER_CONNECT_PUSH | quote }}
STF_PROVIDER_CONNECT_APP_DEALER={{ STF_PROVIDER_CONNECT_APP_DEALER | quote }}
STF_PROVIDER_CONNECT_DEV_DEALER={{ STF_PROVIDER_CONNECT_DEV_DEALER | quote }}
SELENIUM_HUB_HOST={{ SELENIUM_HUB_HOST | quote }}
SELENIUM_HUB_PORT={{ SELENIUM_HUB_PORT | quote }}
# the WireGuard tunnel to MCloud (README.md#wireguard-tunnel): the ports of the devices are published on WG_ADDRESS only
WG_ENABLED={{ WG_ENABLED | default(false) | bool | lower }}
WG_ADDRESS={{ WG_ADDRESS | default('', true) | quote }}
STF_ZMQ_CURVE_SERVER_PUBLIC_KEY={{ STF_ZMQ_CURVE_SERVER_PUBLIC_KEY | quote }}
STF_ZMQ_CURVE_SECRET_KEY={{ STF_ZMQ_CURVE_SECRET_KEY | quote }}
STF_API_URL={{ STF_API_URL | quote }}
# the certificate of MCloud the containers of STF trust (patch/tlstrust.py), empty for a public CA; STF_TLS_INSECURE:
# no verification of the chain and the name; STF_TLS_PINNED (decided by the deploy, STF_TLS_PIN): the containers send
# the node token to the pinned key of MCLOUD_TLS_PIN only, false for a certificate of a public CA
MCLOUD_CA_PEM={{ common_farm_tls.stdout | default('', true) | quote }}
STF_TLS_INSECURE={{ STF_TLS_INSECURE | bool | lower }}
STF_TLS_PIN={{ STF_TLS_PIN | default(true) | bool | lower }}
STF_TLS_PINNED={{ common_farm_tls_pinned | default(false) | bool | lower }}
# a certificate of a public CA valid for PUBLIC_IP (decided by the deploy): doctor and mdm verify MCloud with the CAs of
# the system and the name PUBLIC_IP, not with the pin of MCLOUD_TLS_PIN
MCLOUD_TLS_PUBLIC={{ common_farm_tls_public | default(false) | bool | lower }}

APPIUM_APP_SIZE_DISABLE={{ APPIUM_APP_SIZE_DISABLE | string | lower | quote }}
APPIUM_RELAXED_SECURITY={{ APPIUM_RELAXED_SECURITY | string | lower | quote }}
APPIUM_ADB_SHELL={{ APPIUM_ADB_SHELL | string | lower | quote }}
APPIUM_CHROMEDRIVER_AUTODOWNLOAD={{ APPIUM_CHROMEDRIVER_AUTODOWNLOAD | string | lower | quote }}
STF_PROVIDER_CLEANUP={{ ('' if STF_PROVIDER_CLEANUP is none else STF_PROVIDER_CLEANUP) | string | lower | quote }}
CLEANUP_KEEP_PACKAGES={{ ('' if CLEANUP_KEEP_PACKAGES is none else CLEANUP_KEEP_PACKAGES) | string | quote }}
STF_FORWARD_ALLOW={{ ('' if STF_FORWARD_ALLOW is none else STF_FORWARD_ALLOW) | string | quote }}
APPIUM_APP_FETCH_RETRIES={{ APPIUM_APP_FETCH_RETRIES | quote }}
APPIUM_MAX_LOCK_FILE_LIFETIME={{ APPIUM_MAX_LOCK_FILE_LIFETIME | quote }}
APPIUM_APP_WAITING_TIMEOUT={{ APPIUM_APP_WAITING_TIMEOUT | quote }}

S3_BUCKET={{ S3_BUCKET | quote }}
S3_TENANT={{ S3_TENANT | quote }}
S3_ENDPOINT={{ S3_ENDPOINT | quote }}
S3_ACCESS_KEY_ID={{ S3_ACCESS_KEY_ID | quote }}
S3_SECRET={{ S3_SECRET | quote }}
S3_REGION={{ S3_REGION | quote }}

DDI_ENABLED={{ DDI_ENABLED | string | lower | quote }}
DDI_DIR={{ DDI_DIR | default('', true) | quote }}

WDA_FILE={{ WDA_FILE | quote }}
WDA_BUNDLEID={{ WDA_BUNDLEID | quote }}
WDA_BIND_ADDRESS={{ WDA_BIND_ADDRESS | default('', true) | string | quote }}
WDA_SIMULATOR_FILE={{ WDA_SIMULATOR_FILE | default('') | quote }}
USBMUXD_SOCKET_ADDRESS={{ USBMUXD_SOCKET_ADDRESS | default('') | quote }}
ADB_SERVER_SOCKET_ADDRESS={{ ADB_SERVER_SOCKET_ADDRESS | default('') | quote }}
# the user of the iOS simulators (SIMULATOR_USER of macOS, README.md#ios-simulators): the connector and appium of a
# simulator run xcrun simctl of the host as this user over ssh
HOST_SSH_USER={{ SIMULATOR_USER | default(lookup('env', 'USER'), true) | string | trim | quote }}
