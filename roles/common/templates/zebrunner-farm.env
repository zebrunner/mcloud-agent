# The settings of zebrunner-farm (README.md#settings): ./zebrunner.sh ansible renders them from config/settings.yml,
# versions.yml and the values by default of the roles; do not change them here. They have the secrets of the host:
# readable by root and the user of the deploy only.
FARM_OS={{ common_farm_os | quote }}
ZEBRUNNER_MCLOUD_AGENT_DIR={{ agent_dir | quote }}
MCLOUD_DEVICES=/usr/local/bin/mcloud-devices.txt
STF_DOCKER_NETWORK={{ STF_DOCKER_NETWORK | quote }}
RESTARTS_LIMIT={{ RESTARTS_LIMIT | quote }}

DEVICE_IMAGE={{ DEVICE_IMAGE | quote }}
DEVICE_VERSION={{ DEVICE_VERSION | quote }}
APPIUM_IMAGE={{ APPIUM_IMAGE | quote }}
APPIUM_VERSION={{ APPIUM_VERSION | quote }}
UPLOADER_IMAGE={{ UPLOADER_IMAGE | quote }}
UPLOADER_VERSION={{ UPLOADER_VERSION | quote }}
IOS_CONNECTOR_IMAGE={{ IOS_CONNECTOR_IMAGE | quote }}
IOS_CONNECTOR_VERSION={{ IOS_CONNECTOR_VERSION | quote }}
ANDROID_CONNECTOR_IMAGE={{ ANDROID_CONNECTOR_IMAGE | quote }}
ANDROID_CONNECTOR_VERSION={{ ANDROID_CONNECTOR_VERSION | quote }}

MCLOUD_NODE_TOKEN={{ MCLOUD_NODE_TOKEN | quote }}
STF_PROVIDER_HOST={{ STF_PROVIDER_HOST | quote }}
REMOTE_CONNECT_HOST={{ REMOTE_CONNECT_HOST | default('', true) | quote }}
STF_PROVIDER_NAME={{ STF_PROVIDER_NAME | quote }}
PUBLIC_IP={{ PUBLIC_IP | quote }}
PUBLIC_IP_PORT={{ PUBLIC_IP_PORT | quote }}
PUBLIC_IP_PROTOCOL={{ PUBLIC_IP_PROTOCOL | quote }}
STF_PROVIDER_CONNECT_SUB={{ STF_PROVIDER_CONNECT_SUB | quote }}
STF_PROVIDER_CONNECT_PUSH={{ STF_PROVIDER_CONNECT_PUSH | quote }}
STF_PROVIDER_CONNECT_APP_DEALER={{ STF_PROVIDER_CONNECT_APP_DEALER | quote }}
STF_PROVIDER_CONNECT_DEV_DEALER={{ STF_PROVIDER_CONNECT_DEV_DEALER | quote }}
SELENIUM_HUB_HOST={{ SELENIUM_HUB_HOST | quote }}
SELENIUM_HUB_PORT={{ SELENIUM_HUB_PORT | quote }}
STF_ZMQ_CURVE_SERVER_PUBLIC_KEY={{ STF_ZMQ_CURVE_SERVER_PUBLIC_KEY | quote }}
STF_ZMQ_CURVE_SECRET_KEY={{ STF_ZMQ_CURVE_SECRET_KEY | quote }}
STF_API_URL={{ STF_API_URL | quote }}
STF_AUTH_TOKEN={{ STF_AUTH_TOKEN | quote }}

APPIUM_APP_SIZE_DISABLE={{ APPIUM_APP_SIZE_DISABLE | string | lower | quote }}
APPIUM_RELAXED_SECURITY={{ APPIUM_RELAXED_SECURITY | string | lower | quote }}
APPIUM_APP_FETCH_RETRIES={{ APPIUM_APP_FETCH_RETRIES | quote }}
APPIUM_MAX_LOCK_FILE_LIFETIME={{ APPIUM_MAX_LOCK_FILE_LIFETIME | quote }}
APPIUM_APP_WAITING_TIMEOUT={{ APPIUM_APP_WAITING_TIMEOUT | quote }}

S3_BUCKET={{ S3_BUCKET | quote }}
S3_TENANT={{ S3_TENANT | quote }}
S3_ENDPOINT={{ S3_ENDPOINT | quote }}
S3_ACCESS_KEY_ID={{ S3_ACCESS_KEY_ID | quote }}
S3_SECRET={{ S3_SECRET | quote }}
S3_REGION={{ S3_REGION | quote }}

WDA_FILE={{ WDA_FILE | quote }}
WDA_BUNDLEID={{ WDA_BUNDLEID | quote }}
WDA_SIMULATOR_FILE={{ WDA_SIMULATOR_FILE | default('') | quote }}
USBMUXD_SOCKET_ADDRESS={{ USBMUXD_SOCKET_ADDRESS | default('') | quote }}
ADB_SERVER_SOCKET_ADDRESS={{ ADB_SERVER_SOCKET_ADDRESS | default('') | quote }}
# the user of the deploy: the connector of an iOS simulator runs xcrun simctl of the host as this user over ssh
HOST_SSH_USER={{ lookup('env', 'USER') | quote }}
