---

STF_DOCKER_NETWORK: infra

# [OBLIGATORY] Set host address, port and protocol of the server where STF services are deployed
PUBLIC_IP: demo.zebrunner.farm
PUBLIC_IP_PORT: 80
PUBLIC_IP_PROTOCOL: http

# [OPTIONAL] Set tcp urls of stf-triproxy-dev and stf-triproxy-app.
# IMPORTANT! make sure to use valid hostname and port if STF services are located on different host.
STF_PROVIDER_CONNECT_SUB: tcp://stf-triproxy-dev:7250
STF_PROVIDER_CONNECT_PUSH: tcp://stf-triproxy-dev:7270

STF_PROVIDER_CONNECT_APP_DEALER: tcp://stf-triproxy-app:7160
STF_PROVIDER_CONNECT_DEV_DEALER: tcp://stf-triproxy-dev:7260

# [OPTIONAL] Set host address and port of mcloud-grid container:
# https://github.com/zebrunner/mcloud/blob/8442bceec096f886c02bf84a39816f10c694ad9e/docker-compose.yml#L17
# IMPORTANT! make sure to use valid hostname and port if it is located on different host.
SELENIUM_HUB_HOST: mcloud-grid
SELENIUM_HUB_PORT: 4444
# [OBLIGATORY] The secret the Appium nodes of this host register in mcloud-grid with, README.md#grid-registration:
# NODE_REGISTRATION_TOKEN of the mcloud variables.env (in quotes).
NODE_REGISTRATION_TOKEN:

# [OBLIGATORY] The address of this host the MCloud server connects to (the hub, the screens): in the network of the
# MCloud server its address there, not a public address of the router (README.md#device-hosts-in-a-private-network).
# Add it to AGENT_HOSTS of .env of mcloud. `./zebrunner.sh doctor` checks it.
STF_PROVIDER_HOST: linux-agent.zebrunner.farm
# [OPTIONAL] The host STF shows to the users in `adb connect <host>:<port>` (the remote debug), STF_PROVIDER_HOST
# by default. For a host in a private network: the public name of MCloud with the adb relay of mcloud (ADB_RELAY_HOSTS)
# forwarding the remote debug port (min_port + 1) of every Android device of this host; `./zebrunner.sh doctor` prints them
# (README.md#device-hosts-in-a-private-network).
REMOTE_CONNECT_HOST:

# [OPTIONAL] provider/location name for devices. Use short city name like NYC
STF_PROVIDER_NAME: mcloud-linux

# [OPTIONAL] STF integration settings to move devices into Unhealthy state
STF_API_URL:
STF_AUTH_TOKEN:
# [OBLIGATORY] Shared token the provider sends (x-stf-internal-token) so device screenshot uploads and app-install blob
# fetches pass the authenticated STF storage routes.
# MUST match STF_STORAGE_TOKEN in the STF server's variables.env (in quotes).
STF_STORAGE_TOKEN:
# [OBLIGATORY] The ZeroMQ security (CURVE) of STF, README.md#zeromq-security: STF_ZMQ_CURVE_SERVER_PUBLIC_KEY of the STF
# server's variables.env (in quotes) and the key of this host, which `./zebrunner.sh curve-key` makes and whose public key
# goes to the server as the line STF_ZMQ_CURVE_CLIENT_KEY_<HOST>=<public key> of its variables.env (the command prints it).
STF_ZMQ_CURVE_SERVER_PUBLIC_KEY:
STF_ZMQ_CURVE_SECRET_KEY:

# [OPTIONAL] S3 compatible storage for video recordings.
S3_BUCKET:
S3_TENANT:
S3_ENDPOINT:
S3_ACCESS_KEY_ID:
S3_SECRET:
S3_REGION:

# For local s3 compatible minio storage recommended settings are:
# S3_BUCKET: zebrunner
# S3_TENANT:
# S3_ENDPOINT: http://minio:9000
# S3_ACCESS_KEY_ID: zebrunner
# S3_SECRET: J33dNyeTDj
# S3_REGION: us-east-1

# Path to prebuild WebDriverAgent.ipa
WDA_FILE:
# Override to use custom WDA bundle id: https://github.com/zebrunner/mcloud-agent#build-webdriveragentipa
WDA_BUNDLEID:

# [OBLIGATORY] Declare valid devices metadata
# - id: device udid which is shown by `adb devices`
#   name: device name as it will be registered in STF (avoid special symbols and spaces!)
#   location: clarified device location for ease of device management (an underscore will be added automatically before the value)
#   appium_port: unique port value for sharing appium services from the container to outside selenium hub
#   connect_port: [optional] Android: the remote debug port of STF (adb connect), the second port of min_port-max_port
#     by default; out of the range it is published too. Unique on the host, and among the hosts for the adb relay of
#     mcloud (README.md#device-hosts-in-a-private-network)
#   min_port and max_port: unique range of 7 ports per device for system STF purposes.
#     The MCloud server reaches them on STF_PROVIDER_HOST (the screens through stf-proxy); adb connect of the remote
#     debug reaches them directly or through the adb relay of mcloud (REMOTE_CONNECT_HOST, ADB_RELAY_HOSTS).
#   connection: [optional] how the connector container reaches the device, usb by default:
#     usb      - plugged into the server (udev starts and removes its containers)
#     wireless - over the network: Android over adb connect to address (the id by default, port 5555 unless given),
#                iOS / Apple TV over lockdown of Wi-Fi (netmuxd of the connector) at address, its IP; pair the iOS device
#                over USB first and allow it: docker exec <connector> mcloud-ios wifi-connections <udid> on
#     android-sim - Android: an emulator started outside the farm (AVD, Genymotion, a container Android), address is its adb
#                address reachable from the docker network (host:port, 5555 by default)
#     proxy    - iOS: WebDriverAgent started by another tool and published on address (wda_port, mjpeg_port: 8100, 8101)
#     The iOS simulators (ios-sim) run on a macOS host only. The non-usb devices are started by `zebrunner-farm start`,
#     they have no udev rules.
#   address, wda_port and mjpeg_port: [optional] see connection
#   wda_file and wda_bundleid: [optional] iOS device specific overrides of WDA_FILE and WDA_BUNDLEID

devices:
  - id: R28M1384YQY
    os: android
    name: Samsung_Galaxy_S10
    location: location_1
    appium_port: 7421
    min_port: 7425
    max_port: 7430
  - id: d6afc6b3a65584ca0813eb8957c6479b9b6ebb11
    os: ios
    name: iPhone_8_Plus
    location: location_2
    appium_port: 7431
    min_port: 7435
    max_port: 7440
