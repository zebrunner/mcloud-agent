# The containers of a connected USB device (%i: its id), started by the udev rule of 90_mcloud.rules: udev only
# queues the job, its RUN program must be short. The log: journalctl -u 'mcloud-device-*@<id>'
[Unit]
Description=MCloud: the containers of the device %i
Wants=docker.service
{% if WG_ENABLED | default(false) | bool %}
# the ports of the device are published on the address of the tunnel to MCloud (README.md#wireguard-tunnel)
After=docker.service wg-quick@mcloud-node.service
{% else %}
After=docker.service
{% endif %}
# a disconnection cancels an unfinished restart, a connection an unfinished down
Conflicts=mcloud-device-down@%i.service

[Service]
Type=oneshot
# a connection: the containers zebrunner-farm start created for it meanwhile (the autostart at a boot) are kept
Environment=MCLOUD_DEVICE_EVENT=connect
ExecStart=/usr/local/bin/zebrunner-farm restart %i
# the images may be pulled
TimeoutStartSec=30min
