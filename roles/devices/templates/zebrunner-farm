#!/bin/bash

# Load utility functions
source "${ZEBRUNNER_MCLOUD_AGENT_DIR}/patch/utility.sh"

MCLOUD_DEVICES="/usr/local/bin/mcloud-devices.txt"

function get_device_fields() {
  local filter="$1"

  local -a fields
  dev_udid=""
  dev_platform_name=""
  dev_device_name=""
  dev_location=""
  dev_appium_port=""
  dev_adb_port=""
  dev_proxy_port=""
  dev_server_proxy_port=""
  dev_stf_min_port=""
  dev_stf_max_port=""
  dev_wireless=""
  dev_device_wda_ipa_path=""
  dev_device_wda_bundle_id=""

  local line
  line="$(grep "$filter" "$MCLOUD_DEVICES")" || {
    failed "device not found: ${filter}"
    return 1
  }

  local IFS='|'
  read -r -a fields <<< "$line"
  unset IFS

  dev_udid="${fields[0]}"
  dev_platform_name="${fields[1]}"
  dev_device_name="${fields[2]}"
  dev_location="${fields[3]}"
  dev_appium_port="${fields[4]}"
  dev_adb_port="${fields[5]}"
  dev_proxy_port="${fields[6]}"
  dev_server_proxy_port="${fields[7]}"
  dev_stf_min_port="${fields[8]}"
  dev_stf_max_port="${fields[9]}"

  # Field 11 - 'wireless'.
  # Marks a device with NO usb path, reached over a network tunnel maintained
  # outside this script (for example an Apple TV 4K, which has no diagnostic port at
  # all, reached over Apple's RemoteXPC tunnel). The field has existed in
  # mcloud-devices.txt since it was introduced but was never read; 'false' keeps
  # every existing row behaving exactly as before.
  dev_wireless="${fields[10]}"

  # Fields 12 / 13 - 'device_wda_ipa_path' and 'device_wda_bundle_id'.
  # Device specific WebDriverAgent path and bundle ID.
  dev_device_wda_ipa_path="${fields[11]}"
  dev_device_wda_bundle_id="${fields[12]}"
}

function create_containers() {
  local container="device-${dev_device_name}-${dev_udid}"

  #verify if device containers already exist and do nothing then
  local ps_out
  ps_out="$(docker ps -a)"
  if grep stf       <<< "$ps_out" | grep -q "$container" && \
   grep appium      <<< "$ps_out" | grep -q "$container" && \
   grep connector   <<< "$ps_out" | grep -q "$container" && \
   grep uploader    <<< "$ps_out" | grep -q "$container"; then
     warn "Do nothing as containers already exists!"
     return 0
  fi

  #TODO: check if we can move network creation away from this block
  local net={{ STF_DOCKER_NETWORK }}
  echo -e "\nInspecting network ${net}:"
  if docker network inspect "$net" > /dev/null 2>&1; then
    echo "Network '${net}' already exists"
  else
    echo "Network '${net}' does not exist. Creating..."
    docker network create "$net"
  fi

  local usb_bus
  usb_bus="$(readlink -f "/dev/device-${dev_device_name}-${dev_udid}")"

  # for the physically connected devices via usb
  local ANDROID_DEVICE=""
  local STF_DEVICE_UDID="$dev_udid"
  local DEVICE_ARG="--device=/dev/device-${dev_device_name}-${dev_udid}:${usb_bus}"

  if [ "$dev_wireless" = "true" ]; then
    # provide ANDROID_DEVICE with 5555 port to trigger remote adb connect on appium startup
    ANDROID_DEVICE="${dev_udid}:5555"
    # append 5555 port to be able to rename device in STF
    STF_DEVICE_UDID="${dev_udid}:5555"
    # reset device arg as no symlink generated for the wireless device
    DEVICE_ARG=""
  else
    local clean_udid
    clean_udid="${dev_udid//-/}"
    local connected_devices
    connected_devices="$(lsusb -v 2>/dev/null)"
    if grep -q "$clean_udid" <<< "$connected_devices"; then
      succeed "\nDevice with udid: '${clean_udid}' was SUCCESSFULLY detected as connected."
    else
      failed "\nDevice with udid: '${clean_udid}' was NOT detected as connected. The containers will not be created."
      return 1
    fi
  fi

  echo -e "\n\tCreating '${dev_udid}' containers:\n"

  local S3_KEY_PATTERN=""
  local TENANT={{ S3_TENANT }}
  local BUCKET={{ S3_BUCKET }}
  if [ -n "$BUCKET" ]; then
    S3_KEY_PATTERN="s3://${BUCKET}${TENANT:+/${TENANT}}/artifacts/test-sessions"
  fi

  if [ "$dev_platform_name" == "android" ]; then

    echo -n "device-${dev_device_name}-${dev_udid}-connector:  "
    docker run -itd --name "device-${dev_device_name}-${dev_udid}-connector" \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      "$DEVICE_ARG" \
      -e DEVICE_BUS="$usb_bus" \
      -v mcloud-key-volume:/root/.android \
      -v "device-${dev_device_name}-${dev_udid}":/tmp/log \
      -e PLATFORM_NAME="$dev_platform_name" \
      -e ANDROID_DEVICE="$ANDROID_DEVICE" \
      -e DEVICE_UDID="$STF_DEVICE_UDID" \
      {{ ANDROID_CONNECTOR_IMAGE }}:{{ ANDROID_CONNECTOR_VERSION }} || failed "already created"

    echo -n "device-${dev_device_name}-${dev_udid}-stf:        "
    docker run -d --name "device-${dev_device_name}-${dev_udid}-stf" \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --link "device-${dev_device_name}-${dev_udid}-connector":connector \
      -e STF_PROVIDER_ADB_HOST=connector \
      -e STF_PROVIDER_ADB_PORT=5037 \
      --health-start-period 60s \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      -e PLATFORM_NAME="$dev_platform_name" \
      -e STF_PROVIDER_DEVICE_NAME="$dev_device_name" \
      -e DEVICE_UDID="$STF_DEVICE_UDID" \
      -e STF_PROVIDER_HOST={{ STF_PROVIDER_HOST }} \
      -e STF_PROVIDER_NAME="{{ STF_PROVIDER_NAME }}${dev_location:+_$dev_location}" \
      -e STF_PROVIDER_MIN_PORT="$dev_stf_min_port" \
      -e STF_PROVIDER_MAX_PORT="$dev_stf_max_port" \
      -p "${dev_stf_min_port}-${dev_stf_max_port}":"${dev_stf_min_port}-${dev_stf_max_port}" \
      -e STF_PROVIDER_PUBLIC_IP={{ PUBLIC_IP }} \
      -e PUBLIC_IP_PORT={{ PUBLIC_IP_PORT }} \
      -e PUBLIC_IP_PROTOCOL={{ PUBLIC_IP_PROTOCOL }} \
      -e STF_PROVIDER_CONNECT_SUB={{ STF_PROVIDER_CONNECT_SUB }} \
      -e STF_PROVIDER_CONNECT_PUSH={{ STF_PROVIDER_CONNECT_PUSH }} \
      -e RETHINKDB_PORT_28015_TCP={{ STF_RETHINKDB }} \
      -e STF_STORAGE_TOKEN={{ STF_STORAGE_TOKEN }} \
      {{ DEVICE_IMAGE }}:{{DEVICE_VERSION }} || failed "already created"

    #        Adb config env vars
    #        -e ADB_SERVER_SOCKET=tcp:connector:5037 \
    #        or
    #        -e ANDROID_ADB_SERVER_ADDRESS=connector \
    #        -e ANDROID_ADB_SERVER_PORT=5037 \

    #TODO: parametrized relaxed security, make false by default!
    echo -n "device-${dev_device_name}-${dev_udid}-appium:     "
    docker run -itd --name "device-${dev_device_name}-${dev_udid}-appium" \
      -m 1g \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      --link "device-${dev_device_name}-${dev_udid}-stf":device \
      --link "device-${dev_device_name}-${dev_udid}-connector":connector \
      -v appium-storage-volume:/opt/appium-storage \
      -v "device-${dev_device_name}-${dev_udid}":/tmp/log \
      -e TASK_LOG=/tmp/log/appium.log \
      -e PLATFORM_NAME="$dev_platform_name" \
      -e ANDROID_DEVICE="$ANDROID_DEVICE" \
      -e RETAIN_TASK=true \
      -e CONNECT_TO_GRID=true \
      -e RECORD_ARTIFACTS=true \
      -e CUSTOM_NODE_CONFIG=true \
      -e STF_PROVIDER_HOST={{ STF_PROVIDER_HOST }} \
      -e APPIUM_APP_SIZE_DISABLE={{ APPIUM_APP_SIZE_DISABLE }} \
      -e APPIUM_APP_FETCH_RETRIES={{ APPIUM_APP_FETCH_RETRIES }} \
      -e APPIUM_MAX_LOCK_FILE_LIFETIME={{ APPIUM_MAX_LOCK_FILE_LIFETIME }} \
      -e APPIUM_APP_WAITING_TIMEOUT={{ APPIUM_APP_WAITING_TIMEOUT }} \
      -e SELENIUM_HOST={{ SELENIUM_HUB_HOST }} \
      -e SELENIUM_PORT={{ SELENIUM_HUB_PORT }} \
      -e DEFAULT_CAPABILITIES=true \
      -e DEVICE_NAME="$dev_device_name" \
      -e DEVICE_UDID="$STF_DEVICE_UDID" \
      -e ADB_PORT="$dev_adb_port" \
      -e PROXY_PORT="$dev_proxy_port" \
      -e SERVER_PROXY_PORT="$dev_server_proxy_port" \
      -e APPIUM_PORT="$dev_appium_port" \
      -p "$dev_appium_port":"$dev_appium_port" \
      -e RELAXED_SECURITY=true \
      -e ADB_SERVER_SOCKET=tcp:connector:5037 \
      -e REMOTE_ADB_HOST=connector \
      -e STF_API_URL={{ STF_API_URL }} \
      -e STF_AUTH_TOKEN={{ STF_AUTH_TOKEN }} \
      {{ APPIUM_IMAGE }}:{{ APPIUM_VERSION }} || failed "already created"

    echo -n "device-${dev_device_name}-${dev_udid}-uploader:   "
    docker run -d --name "device-${dev_device_name}-${dev_udid}-uploader" \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      -v "device-${dev_device_name}-${dev_udid}":/tmp/log \
      -e ENDPOINT_URL={{ S3_ENDPOINT }} \
      -e S3_KEY_PATTERN="$S3_KEY_PATTERN" \
      -e AWS_ACCESS_KEY_ID={{ S3_ACCESS_KEY_ID }} \
      -e AWS_SECRET_ACCESS_KEY={{ S3_SECRET }} \
      -e AWS_DEFAULT_REGION={{ S3_REGION }} \
      {{ UPLOADER_IMAGE }}:{{ UPLOADER_VERSION }} || failed "already created"

  elif [ "$dev_platform_name" == "ios" ]; then

    local wda_ipa_path={{ WDA_FILE }}
    if [[ -n "$dev_device_wda_ipa_path" ]]; then
      wda_ipa_path="$dev_device_wda_ipa_path"
    fi
    # If still empty - set '/dev/null' because unable to use empty value for docker volume share!
    : "${wda_ipa_path:='/dev/null'}"
    echo "wda_ipa_path: ${wda_ipa_path}"

    local wda_bundle_id={{ WDA_BUNDLEID }}
    if [ -n "$dev_device_wda_bundle_id" ]; then
      wda_bundle_id="$dev_device_wda_bundle_id"
    fi
    : "${wda_bundle_id:='com.facebook.WebDriverAgentRunner.xctrunner'}"
    echo -e "wda_bundle_id: ${wda_bundle_id}\n"

    echo -n "device-${dev_device_name}-${dev_udid}-connector:  "
    docker run -itd --name "device-${dev_device_name}-${dev_udid}-connector" \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --sysctl net.ipv6.conf.all.disable_ipv6=0 \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      "$DEVICE_ARG" \
      --cap-add=NET_ADMIN \
      --device=/dev/net/tun \
      -e HOST_OS=LINUX \
      -e DEVICE_BUS="$usb_bus" \
      -e WDA_BUNDLEID="$wda_bundle_id" \
      -e WDA_FILE=/tmp/zebrunner/WebDriverAgent.ipa \
      -v devimages_cache:/opt/zebrunner/devimages \
      -v "$wda_ipa_path":/tmp/zebrunner/WebDriverAgent.ipa \
      -v "device-${dev_device_name}-${dev_udid}-lockdown":/var/lib/lockdown \
      -v "device-${dev_device_name}-${dev_udid}":/tmp/log \
      -e DEVICE_UDID="$STF_DEVICE_UDID" \
      {{ IOS_CONNECTOR_IMAGE }}:{{ IOS_CONNECTOR_VERSION }} || failed "already created"

    # Linking with appium required to share usbmuxd via socat
    echo -n "device-${dev_device_name}-${dev_udid}-stf:        "
    docker run -d --name "device-${dev_device_name}-${dev_udid}-stf" \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      --link "device-${dev_device_name}-${dev_udid}-connector":connector \
      -e WDA_HOST=connector \
      -e WDA_WAIT_TIMEOUT=60 \
      -e PLATFORM_NAME="$dev_platform_name" \
      -e STF_PROVIDER_DEVICE_NAME="$dev_device_name" \
      -e DEVICE_UDID="$dev_udid" \
      -e STF_PROVIDER_HOST={{ STF_PROVIDER_HOST }} \
      -e STF_PROVIDER_NAME="{{ STF_PROVIDER_NAME }}${dev_location:+_$dev_location}" \
      -e STF_PROVIDER_MIN_PORT="$dev_stf_min_port" \
      -e STF_PROVIDER_MAX_PORT="$dev_stf_max_port" \
      -p "${dev_stf_min_port}-${dev_stf_max_port}":"${dev_stf_min_port}-${dev_stf_max_port}" \
      -e STF_PROVIDER_PUBLIC_IP={{ PUBLIC_IP }} \
      -e PUBLIC_IP_PORT={{ PUBLIC_IP_PORT }} \
      -e PUBLIC_IP_PROTOCOL={{ PUBLIC_IP_PROTOCOL }} \
      -e STF_PROVIDER_CONNECT_SUB={{ STF_PROVIDER_CONNECT_SUB }} \
      -e STF_PROVIDER_CONNECT_PUSH={{ STF_PROVIDER_CONNECT_PUSH }} \
      -e STF_PROVIDER_CONNECT_APP_DEALER={{ STF_PROVIDER_CONNECT_APP_DEALER }} \
      -e STF_PROVIDER_CONNECT_DEV_DEALER={{ STF_PROVIDER_CONNECT_DEV_DEALER }} \
      -e RETHINKDB_PORT_28015_TCP={{ STF_RETHINKDB }} \
      -e STF_STORAGE_TOKEN={{ STF_STORAGE_TOKEN }} \
      {{ DEVICE_IMAGE }}:{{DEVICE_VERSION }} || failed "already created"

    # candidates for removal: ADB_PORT, STF_PROVIDER_MAX_PORT
    echo -n "device-${dev_device_name}-${dev_udid}-appium:     "
    docker run -itd --name "device-${dev_device_name}-${dev_udid}-appium" \
      -m 1g \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      "$DEVICE_ARG" \
      --link "device-${dev_device_name}-${dev_udid}-stf":device \
      --link "device-${dev_device_name}-${dev_udid}-connector":connector \
      -e WDA_HOST=connector \
      -v appium-storage-volume:/opt/appium-storage \
      -v "device-${dev_device_name}-${dev_udid}":/tmp/log \
      -e TASK_LOG=/tmp/log/appium.log \
      -e APPIUM_CLI="--session-override" \
      -e PLATFORM_NAME="$dev_platform_name" \
      -e RETAIN_TASK=true \
      -e CONNECT_TO_GRID=true \
      -e RECORD_ARTIFACTS=true \
      -e CUSTOM_NODE_CONFIG=true \
      -e STF_PROVIDER_HOST={{ STF_PROVIDER_HOST }} \
      -e APPIUM_APP_SIZE_DISABLE={{ APPIUM_APP_SIZE_DISABLE }} \
      -e APPIUM_APP_FETCH_RETRIES={{ APPIUM_APP_FETCH_RETRIES }} \
      -e APPIUM_MAX_LOCK_FILE_LIFETIME={{ APPIUM_MAX_LOCK_FILE_LIFETIME }} \
      -e APPIUM_APP_WAITING_TIMEOUT={{ APPIUM_APP_WAITING_TIMEOUT }} \
      -e SELENIUM_HOST={{ SELENIUM_HUB_HOST }} \
      -e SELENIUM_PORT={{ SELENIUM_HUB_PORT }} \
      -e DEFAULT_CAPABILITIES=true \
      -e DEVICE_NAME="$dev_device_name" \
      -e DEVICE_UDID="$dev_udid" \
      -e ADB_PORT="$dev_adb_port" \
      -e PROXY_PORT="$dev_proxy_port" \
      -e SERVER_PROXY_PORT="$dev_server_proxy_port" \
      -e APPIUM_PORT="$dev_appium_port" \
      -p "$dev_appium_port":"$dev_appium_port" \
      -e RELAXED_SECURITY=true \
      {{ APPIUM_IMAGE }}:{{ APPIUM_VERSION }}

    echo -n "device-${dev_device_name}-${dev_udid}-uploader:   "
    docker run -d --name "device-${dev_device_name}-${dev_udid}-uploader" \
      --log-driver=local \
      --log-opt max-size=256m \
      --log-opt max-file=2 \
      --net="$net" \
      --restart on-failure:{{ RESTARTS_LIMIT }} \
      -v "device-${dev_device_name}-${dev_udid}":/tmp/log \
      -e ENDPOINT_URL={{ S3_ENDPOINT }} \
      -e S3_KEY_PATTERN="$S3_KEY_PATTERN" \
      -e AWS_ACCESS_KEY_ID={{ S3_ACCESS_KEY_ID }} \
      -e AWS_SECRET_ACCESS_KEY={{ S3_SECRET }} \
      -e AWS_DEFAULT_REGION={{ S3_REGION }} \
      {{ UPLOADER_IMAGE }}:{{ UPLOADER_VERSION }} || failed "already created"

  else
    echo "ERROR! Unsupported platform: ${dev_platform_name}"
    return 1
  fi
}

function start() {
  local filter_device="$1"

  # if $device is empty do start for all connected devices otherwise start only filtered
  if [[ -n "$filter_device" && "$filter_device" != "ios" && "$filter_device" != "android" ]]; then
    get_device_fields "$filter_device"
    create_containers && start_containers
    echo -e "\n-----------------------------------------------------------------"
  else
    while read -r line; do
      get_device_fields "$line"
      if [ -L "/dev/device-${dev_device_name}-${dev_udid}" ] || [ "$dev_wireless" == "true" ]; then
        create_containers && start_containers
        echo -e "\n-----------------------------------------------------------------"
      fi
    done < "$MCLOUD_DEVICES"
  fi
}

function start_containers() {
  local container="device-${dev_device_name}-${dev_udid}"

  echo -e "\n\tStarting '${dev_udid}' containers:\n"

  docker start "${container}-connector"
  docker start "${container}-stf"
  docker start "${container}-appium"
  docker start "${container}-uploader"
}


function stop() {
  local filter_device="$1"

  # if $device is empty do stop for all connected devices otherwise stop only filtered
  if [[ -n "$filter_device" && "$filter_device" != "ios" && "$filter_device" != "android" ]]; then
    get_device_fields "$filter_device"
    stop_containers
    echo -e "\n-----------------------------------------------------------------"
  else
    while read -r line; do
      get_device_fields "$line"
      stop_containers
      echo -e "\n-----------------------------------------------------------------"
    done < "$MCLOUD_DEVICES"
  fi
}

function stop_containers() {
  local container="device-${dev_device_name}-${dev_udid}"
  echo -e "\n\tStopping '${dev_udid}' containers:\n"
  docker stop "${container}-connector"
  docker stop "${container}-appium"
  docker stop "${container}-stf"
  docker stop "${container}-uploader"
}

function down() {
  local filter_device="$1"

  # if "$filter_device" is empty do rm for all connected devices otherwise rm only filtered
  if [[ -n "$filter_device" && "$filter_device" != "ios" && "$filter_device" != "android" ]]; then
    get_device_fields "$filter_device"
    remove_containers
    echo -e "\n-----------------------------------------------------------------"
  else
    while read -r line; do
      get_device_fields "$line"
      remove_containers
      echo -e "\n-----------------------------------------------------------------"
    done < "$MCLOUD_DEVICES"
  fi
}

function remove_containers() {
  local container="device-${dev_device_name}-${dev_udid}"

  echo -e "\n\tRemoving '${dev_udid}' containers:\n"
  echo -n "Connector:  "
  docker rm -f "${container}-connector" || failed "container not found"

  echo -n "Appium:     "
  docker rm -f "${container}-appium" || failed "container not found"

  echo -n "STF:        "
  docker rm -f "${container}-stf" || failed "container not found"

  echo -n "Uploader:   "
  docker rm -f "${container}-uploader" || failed "container not found"

  echo -ne "--\nVolume:     "
  docker volume rm "$container" || failed "volume not found"
}

function detect_uptime() {
  local started_at
  started_at="$(docker inspect --format='{{ '{{' }}.State.StartedAt{{ '}}' }}' "$1")"
  local finished_at
  finished_at="$(docker inspect --format='{{ '{{' }}.State.FinishedAt{{ '}}' }}' "$1")"
  local started_at_epoch
  started_at_epoch="$(date -d "$started_at" "+%s")"
  local finished_at_epoch
  finished_at_epoch="$(date -d "$finished_at" "+%s")"
  local uptime="UNKNOWN"

  if [ "$started_at_epoch" -gt "$finished_at_epoch" ]; then
    local current_time="UNKNOWN"
    current_time="$(date "+%s")"
    uptime="$(TZ=UTC date -d @"$((current_time - started_at_epoch))" "+%H:%M:%S")"
  fi
  echo "$uptime"
}

function detect_state() {
  local device_state="UNKNOWN"
  device_state="$(docker inspect --format='{{ '{{' }}.State.Health.Status{{ '}}' }}' "$1" 2> /dev/null)"
  echo "${device_state:-UNKNOWN}"
}

function detect_status() {
  local device_status="UNKNOWN"
  device_status="$(docker inspect --format='{{ '{{' }}.State.Status{{ '}}' }}' "$1" 2> /dev/null)"
  echo "${device_status:-UNKNOWN}"
}

function detect_restarts() {
  local device_restarts="UNKNOWN"
  device_restarts="$(docker inspect --format='{{ '{{' }}.RestartCount{{ '}}' }}' "$1" 2> /dev/null)"
  echo "${device_restarts:-UNKNOWN}"
}

function verify_containers() {
  local container="device-${dev_device_name}-${dev_udid}"

  local ps_out
  ps_out="$(docker ps -a)"

  echo -e "\n\tVerify ${dev_udid} containers:"

  if [ ! -L "/dev/${container}" ] && [ "$dev_wireless" != "true" ]; then
    echo -e "${container}\n\nDISCONNECTED\n"
  else
    echo -e "${container}\n"

    local stf_state="UNKNOWN"
    local stf_status="UNKNOWN"
    local stf_uptime="UNKNOWN"
    local stf_restarts="UNKNOWN"

    if grep -q "${container}-stf" <<< "$ps_out"; then
      stf_state="$(detect_state "${container}-stf")"
      stf_status="$(detect_status "${container}-stf")"
      stf_uptime="$(detect_uptime "${container}-stf")"
      stf_restarts="$(detect_restarts "${container}-stf")"
    fi

    local appium_state="UNKNOWN"
    local appium_status="UNKNOWN"
    local appium_uptime="UNKNOWN"
    local appium_restarts="UNKNOWN"
    if grep -q "${container}-appium" <<< "$ps_out"; then
      appium_state="$(detect_state "${container}-appium")"
      appium_status="$(detect_status "${container}-appium")"
      appium_uptime="$(detect_uptime "${container}-appium")"
      appium_restarts="$(detect_restarts "${container}-appium")"
    fi

    local connector_state="UNKNOWN"
    local connector_status="UNKNOWN"
    local connector_uptime="UNKNOWN"
    local connector_restarts="UNKNOWN"
    if grep -q "${container}-connector" <<< "$ps_out"; then
      connector_state="$(detect_state "${container}-connector")"
      connector_status="$(detect_status "${container}-connector")"
      connector_uptime="$(detect_uptime "${container}-connector")"
      connector_restarts="$(detect_restarts "${container}-connector")"
    fi

    local uploader_state="UNKNOWN"
    local uploader_status="UNKNOWN"
    local uploader_uptime="UNKNOWN"
    local uploader_restarts="UNKNOWN"
    if grep -q "${container}-uploader" <<< "$ps_out"; then
      uploader_state="$(detect_state "${container}-uploader")"
      uploader_status="$(detect_status "${container}-uploader")"
      uploader_uptime="$(detect_uptime "${container}-uploader")"
      uploader_restarts="$(detect_restarts "${container}-uploader")"
    fi

    echo -e ",| Container,| State,| Status,| Uptime,| Restarts,|
,| ---------,| ---------,| ---------,| ---------,| ---------,|
,| Connector,| ${connector_state},| ${connector_status},| ${connector_uptime},| ${connector_restarts},|
,| Appium,| ${appium_state},| ${appium_status},| ${appium_uptime},| ${appium_restarts},|
,| STF,| ${stf_state},| ${stf_status},| ${stf_uptime},| ${stf_restarts},|
,| Uploader,| ${uploader_state},| ${uploader_status},| ${uploader_uptime},| ${uploader_restarts},|" | column -t -s ','

  fi
  echo -e "==============================================================\n"
}

function status() {
  local filter_device="$1"

  if [[ -n "$filter_device" && "$filter_device" != "ios" && "$filter_device" != "android" ]]; then
    get_device_fields "$filter_device"
    verify_containers
  else
    while read -r line; do
      get_device_fields "$line"
      verify_containers
    done < "$MCLOUD_DEVICES"
  fi
}

function echo_help() {
  echo "
      Usage: zebrunner-farm [option]
      Arguments:
          status               Status of MCloud Agent and each whitelisted device
          start [udid]         Start devices containers or exact device by udid
          stop [udid]          Stop and keep devices containers or exact device by udid
          restart [udid]       Restart all devices containers or exact device by udid
          down [udid]          Stop and remove devices containers
          ansible ['devices']  Run ansible-playbook script with custom or predefined args
          version              Show version of MCloud Agent components"
  echo_telegram
  exit 0
}

function main() {
  case "$1" in
  status)
    status "$2"
    ;;
  start)
    start "$2"
    ;;
  stop)
    stop "$2"
    ;;
  restart)
    down "$2"
    start "$2"
    ;;
  down)
    down "$2"
    ;;
  ansible)
    "${ZEBRUNNER_MCLOUD_AGENT_DIR}"/zebrunner.sh ansible "${@:2}"
    ;;
  version)
    "${ZEBRUNNER_MCLOUD_AGENT_DIR}"/zebrunner.sh version
    ;;
  *)
    echo_help
    ;;
  esac
}

main "$@"
