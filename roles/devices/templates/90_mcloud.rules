{% for device in devices %}
{# only the usb devices are plugged: the wireless devices and the emulators are started by zebrunner-farm start #}
{% if (device.connection | default('wireless' if (device.wireless | default(false) | string | lower) == 'true' else 'usb')) | string | lower == 'usb' %}
SUBSYSTEM=="usb", ENV{ID_SERIAL_SHORT}=="{{ device.id | trim | replace('-','') }}", MODE="0666", SYMLINK+="device-{{ device.name | trim | regex_replace('\\s+', '_') }}-{{ device.id | trim }}"
ACTION=="remove", ENV{ID_SERIAL_SHORT}=="{{ device.id | trim | replace('-','') }}", RUN+="/usr/local/bin/zebrunner-farm down {{ device.id | trim }}"
ACTION=="add", ENV{ID_SERIAL_SHORT}=="{{ device.id | trim | replace('-','') }}", RUN+="/usr/local/bin/zebrunner-farm restart {{ device.id | trim }}"
{% endif %}
{% endfor %}
