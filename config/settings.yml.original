---
# The settings of this host, the same for Linux and macOS (README.md#settings); the devices are in config/devices.yml.
# A line here overrides the images of versions.yml and the values by default of roles/*/defaults/main.yml: the options of
# Appium, STF_PROVIDER_NAME, the sockets of the macOS host.

# [OPTIONAL] every device has a docker network of its own, a /28 of DEVICE_NETWORK_SUBNETS (README.md#docker-network);
# DEVICE_NETWORK_ISOLATION: false puts the containers of all the devices into STF_DOCKER_NETWORK (infra by default)
# DEVICE_NETWORK_ISOLATION: true
# DEVICE_NETWORK_SUBNETS: 10.233.0.0/16
# STF_DOCKER_NETWORK: infra

# The connection to MCloud: `./zebrunner.sh join` writes these settings (README.md#node-enrollment), do not change them
# by hand; a new join string of `./zebrunner.sh node-invite` of mcloud replaces them. Keep this file private (mode 600).
# MCLOUD_URL and MCLOUD_TLS_PIN: the API of MCloud and the pin of its TLS key (doctor talks to MCloud with them)
MCLOUD_URL:
MCLOUD_TLS_PIN:
# the token of this host: the grid, the storage and the proof of its devices
MCLOUD_NODE_TOKEN:
# the address of this host the MCloud server connects to (the hub, the screens): the address of the invite
STF_PROVIDER_HOST:
# the public URL of MCloud: the devices upload the screenshots and download the apps there
PUBLIC_IP:
PUBLIC_IP_PORT:
PUBLIC_IP_PROTOCOL:
# the triproxies of STF and mcloud-grid on the address this host reaches MCloud with
STF_PROVIDER_CONNECT_SUB:
STF_PROVIDER_CONNECT_PUSH:
STF_PROVIDER_CONNECT_APP_DEALER:
STF_PROVIDER_CONNECT_DEV_DEALER:
SELENIUM_HUB_HOST:
SELENIUM_HUB_PORT:
# the ZeroMQ security (CURVE): the public key of the server and the key of this host (join makes it when it is empty)
STF_ZMQ_CURVE_SERVER_PUBLIC_KEY:
STF_ZMQ_CURVE_SECRET_KEY:
# the WireGuard tunnel to MCloud, off by default (README.md#wireguard-tunnel): join writes WG_ENABLED: true, the key of
# this host (WG_PRIVATE_KEY, a secret), its address in the tunnel (WG_ADDRESS, the address of the invite), MCloud in the
# tunnel (WG_SERVER_ADDRESS, WG_SERVER_PUBLIC_KEY, WG_ENDPOINT) and WG_NETWORK when MCloud has the tunnel on
# WG_ENABLED: false

# [OPTIONAL] The host STF shows to the users in `adb connect <host>:<port>` (the remote debug), STF_PROVIDER_HOST by
# default. For a host in a private network: the public name of MCloud with the adb relay of mcloud (ADB_RELAY=true), it
# forwards the remote debug port (connect_port) of every Android device of this host (README.md#device-hosts-in-a-private-network).
REMOTE_CONNECT_HOST:

# [OPTIONAL] The MDM of the devices (./zebrunner.sh mdm, README.md#mdm): the supervision identity of the farm, the
# PKCS#12 file the iOS devices are supervised with and its password; the Wi-Fi network an erased iOS device joins
# (./zebrunner.sh mdm supervise: the MDM reaches it over it); the organization the supervised devices show. The
# Android devices need nothing
# MDM_SUPERVISION_P12: /opt/zebrunner/supervision.p12
# MDM_SUPERVISION_P12_PASSWORD:
# MDM_SUPERVISION_ORG: Zebrunner MCloud
# MDM_WIFI_SSID:
# MDM_WIFI_PASSWORD:
# MDM_WIFI_ENCRYPTION: Any

# [OPTIONAL] provider/location name for devices. Use short city name like NYC; mcloud-linux or mcloud-macos by default
# STF_PROVIDER_NAME: NYC

# [OPTIONAL] macOS: the usbmuxd of the host shared into the containers by socat, host.docker.internal:2222 by default
# USBMUXD_SOCKET_ADDRESS: host.docker.internal:2222
# [OPTIONAL] macOS: the adb server of the host for the USB Android devices (ZebrunnerAdb launch agent),
# host.docker.internal:5037 by default
# ADB_SERVER_SOCKET_ADDRESS: host.docker.internal:5037

# [OPTIONAL] the STF API: appium of the Android and iOS devices moves a device to Unhealthy in STF (no space left,
# unfinished setup, ...) or notes its error with the node token of this host (MCLOUD_NODE_TOKEN). STF_API_URL is
# <STF>/api/v1, e.g. https://mcloud.example.com/api/v1 (the PUBLIC_IP of MCloud)
STF_API_URL:

# [OPTIONAL] true: the containers of STF do not verify the certificate of MCloud. Only for a self-signed certificate
# that is not valid for PUBLIC_IP: the deploy trusts a certificate of a public CA and the pinned self-signed one of the
# join string (MCLOUD_TLS_PIN) by itself (README.md#tls-of-mcloud). ./zebrunner.sh doctor fails with it unless
# STF_TLS_INSECURE_ACKNOWLEDGED is true too
# STF_TLS_INSECURE: false
# STF_TLS_INSECURE_ACKNOWLEDGED: false
# [OPTIONAL] the containers of STF send the node token only to the pinned TLS key of the join string (MCLOUD_TLS_PIN)
# when MCloud has a self-signed or private-CA certificate (or with STF_TLS_INSECURE); a certificate of a public CA valid
# for PUBLIC_IP is not pinned, its renewal with a new key keeps working. false: no pin at all (README.md#tls-of-mcloud)
# STF_TLS_PIN: true

# [OPTIONAL] S3 compatible storage for the videos and the logs of the sessions: without S3_BUCKET appium records no
# video and the devices have no uploader (README.md#recordings); S3_ACCESS_KEY_ID and S3_SECRET: write-only credentials
# of this host, not of the farm (README.md#s3-credentials-of-a-host)
S3_BUCKET:
S3_TENANT:
S3_ENDPOINT:
S3_ACCESS_KEY_ID:
S3_SECRET:
S3_REGION:

# For local s3 compatible minio storage recommended settings are (the uploader of a device is on the docker network of
# its device, README.md#docker-network: the address of the host of MinIO and its published port, not a container name):
# S3_BUCKET: zebrunner
# S3_TENANT:
# S3_ENDPOINT: http://192.168.1.10:9000
# S3_ACCESS_KEY_ID: zebrunner
# S3_SECRET: J33dNyeTDj
# S3_REGION: us-east-1

# [OPTIONAL] iOS: the Developer Disk Images the connectors mount (README.md#developer-disk-images): the deploy of a host
# with iOS devices clones DDI_REPO at DDI_VERSION (a branch or a tag) into DDI_DIR, DeveloperDiskImages of the agent
# folder by default; DDI_ENABLED: false leaves the images to the download of the connector
# DDI_ENABLED: true
# DDI_REPO: https://github.com/zebrunner/DeveloperDiskImage.git
# DDI_VERSION: main
# DDI_DIR: /opt/DeveloperDiskImages

# [OPTIONAL] iOS: the address WebDriverAgent listens on (README.md#webdriveragent-address): empty is the default of the
# connector, the loopback of the device for usb and of the host for a simulator; all: every interface (the behaviour
# before, e.g. for a tool that reaches WebDriverAgent at the Wi-Fi address of the device)
# WDA_BIND_ADDRESS: all

# [OPTIONAL] iOS: the seconds a device may stay unavailable before its connector stops, a wireless device is awaited
# that long (README.md#wireless-devices): empty is the default of the connector (600), 0: forever; unavailable_timeout
# of a device overrides it
# DEVICE_UNAVAILABLE_TIMEOUT: 1800

# [OPTIONAL] the wireless watchdog (README.md#wireless-watchdog): the containers of the wireless devices that stopped by
# themselves are started every this many seconds (300 by default), 0: off
# WIRELESS_WATCHDOG_INTERVAL: 300

# Path to prebuild WebDriverAgent.ipa
WDA_FILE:
# macOS: path to the simulator build of WebDriverAgent for the simulators: a .app folder or its .zip, e.g.
# WebDriverAgentRunner-Build-Sim-arm64.zip of https://github.com/appium/WebDriverAgent/releases
WDA_SIMULATOR_FILE:
# Override to use custom WDA bundle id: https://github.com/zebrunner/mcloud-agent#build-webdriveragentipa
WDA_BUNDLEID:
