# >>> mcloud-conventions: the shared part, changed in https://github.com/zebrunner/mcloud-conventions
# IDE
.idea/
*.iml
# the lint tools of `make lint`
.venv/
# macOS
.DS_Store
# <<< mcloud-conventions
# the project: the local settings and data of a farm
*.bak
backup/*
variables.env
.env
logs/*.log
config/*
!config/*.original
